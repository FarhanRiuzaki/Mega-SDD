#!/usr/bin/env bash
# PostToolUse hook for mega-sdd plugin — Iter 67.5 v3.48.0+.
#
# AUDIT RESPONSE (audit 2026-05-27 §A2): Iter 66a shipped this hook with
# matcher `Read|Skill`, producing ONE ref_loaded event across a full real
# chain run that read dozens of files. Most reference loading happens via
# Bash (cat / head / tail / grep) inside skill bodies, invisible to a
# Read-only matcher.
#
# Iter 67.5 changes:
# 1. Matcher broadened to Read|Skill|Bash in hooks.json
# 2. Bash branch added below — detects `cat|head|tail|grep|less|more|rg <mega-sdd-path>`
#    and emits one ref_loaded per detected path
# 3. HONEST limitation: ref_loaded UNDER-COUNTS true loads — but NOT because
#    subagent calls are invisible. PostToolUse DOES fire on subagent (fg+bg)
#    tool calls (settled empirically by a 3-sentinel telemetry probe; see the
#    archived audit record docs/superpowers/audits/2026-06-05-audit-md-rounds-1-3-ARCHIVED.md
#    Round-2 L1). The under-count is because emission is intentionally
#    LOSSY: this hook is async (hooks.json) and every append is best-effort
#    (`>> ... 2>/dev/null || true`, exit-0-always), so events can drop under
#    load; the Bash branch also can't parse complex pipelines (redirection,
#    awk/sed-via-stdin, find-exec, xargs). Detail:
#    plugins/mega-sdd/references/telemetry-schema.md §Emission mechanism.
#
# Emission:
# - Honors --no-telemetry suppression via <cwd>/.mega-sdd/config.yaml
# - Appends to <cwd>/.mega-sdd/memory/telemetry.jsonl
# - Exit 0 always (hook must never block tool execution)

set -uo pipefail

# stdin read with a BUILTIN (spec §4b): read -d '' consumes to EOF (JSON has no
# NUL); rc non-zero at EOF by design, hence `|| true`.
STDIN_JSON=""
IFS= read -r -d '' STDIN_JSON || true
[ -n "$STDIN_JSON" ] || STDIN_JSON='{}'

# ─── Fast negative short-circuit (pure shell, BEFORE the python3 parse) ───────
# The matcher is the widest in hooks.json (Read|Skill|Bash|Write|Edit|Agent), and
# `Read` is the most frequent tool in any session — so this hook runs after almost
# EVERY tool call in EVERY project, including ones with no .mega-sdd at all. Until
# now it paid its full prologue before it could discover it had nothing to do:
# python3 cold start + dirname + the resolver walk + date. Measured 15 external
# process spawns on a Read in a non-mega-sdd project; at ~220 ms/spawn on a
# Windows + EDR machine that is ~3 s of pure tax per tool call, for nothing.
#
# `pre-tool-use` has carried this same guard since v4; this is the sibling it was
# always missing. MOAT-NEUTRAL by construction: it fires ONLY when no .mega-sdd
# ancestor exists, which is mutually exclusive with every branch below (all of
# them are already gated on .mega-sdd). Zero forks — the cwd extraction is
# parameter expansion, not sed, and the resolver walk is fork-free since v5.4.0.
# When the cwd cannot be extracted OR the resolver helper is absent it does NOT
# short-circuit; it falls through to the authoritative path.
SC_CWD=""
case "$STDIN_JSON" in
  *'"cwd"'*)
    _sc="${STDIN_JSON#*\"cwd\"}"   # drop everything up to the key
    _sc="${_sc#*\"}"                # drop up to the value's opening quote
    SC_CWD="${_sc%%\"*}"            # keep up to the closing quote
    ;;
esac
if [ -n "$SC_CWD" ]; then
  case "$0" in */*) SC_DIR="${0%/*}" ;; *) SC_DIR="." ;; esac
  SC_RPR="${SC_DIR}/../scripts/_lib/resolve-project-root.sh"
  if [ -f "$SC_RPR" ]; then
    # shellcheck disable=SC1090
    . "$SC_RPR"
    # Windows hands hooks a native backslash cwd, JSON-escaped as \\ — normalize
    # so the -d test can actually find .mega-sdd (the resolver normalizes too, but
    # this value is also used for the test below).
    case "${OSTYPE:-}" in msys*|cygwin*|win32*) SC_CWD="${SC_CWD//\\\\//}"; SC_CWD="${SC_CWD//\\//}" ;; esac
    # Only trust the extraction if it names a real directory. This scan takes the
    # FIRST `"cwd"` in the raw JSON, which is the top-level key for every payload
    # Claude Code emits — but key order is not a guarantee, and a tool_input value
    # containing the literal `"cwd"` earlier in the document would yield a garbage
    # SC_CWD whose resolved root has no .mega-sdd, i.e. a silent `exit 0` on a real
    # mega-sdd project. Fail SAFE instead: an unverifiable cwd falls through to the
    # authoritative python parse rather than short-circuiting. Costs no fork.
    if [ -d "$SC_CWD" ]; then
      SC_ROOT=$(resolve_project_root "$SC_CWD")
      if [ ! -d "${SC_ROOT}/.mega-sdd" ]; then exit 0; fi

      # ── v7 tier-S fast path (spec 2026-08-21-v7-weighted-routing-design.md §3.3) ──
      # Size cap (review R-6): oversized stdin takes the classic python path.
      if [ "${#STDIN_JSON}" -le 262144 ]; then
      # A mega-sdd project WITHOUT an active chain this session: the validator
      # fan-out below is CHAIN-SCOPED (the PreToolUse gate aggregator re-derives
      # every gate state at gate time, so the fan-out is early-warning, not the
      # moat — audit 2026-08-21 §3.3). Here we settle the common case in pure
      # shell: not armed → journal a Write|Edit (≤2 forks: date + wc) and exit;
      # every other tool exits clean. FAIL-CLOSED: subagent sentinels, Plan
      # mode, extraction doubt, or armed/unknown state fall through to the
      # authoritative python path (which re-checks armed before any validator).
      SC_V7_DONE=0
      case "$STDIN_JSON" in *'"agent_id"'*|*'"parent_tool_use_id"'*|*agent_transcript_path*) SC_V7_DONE=1 ;; esac
      [ -f "${SC_ROOT}/.mega-sdd/.plan-pending" ] && SC_V7_DONE=1
      if [ "$SC_V7_DONE" -eq 0 ]; then
        SC_SID=""
        SC_R="$STDIN_JSON"
        while [[ "$SC_R" =~ \"session_id\"[[:space:]]*:[[:space:]]*\"([^\"]*)\"(.*) ]]; do
          SC_SID="${BASH_REMATCH[1]}"; SC_R="${BASH_REMATCH[2]}"
        done
        SC_ARMED=unknown
        if [ -n "$SC_SID" ]; then
          SC_GG="${SC_ROOT}/.mega-sdd/.gateguard-state.json"
          if [ ! -f "$SC_GG" ]; then
            SC_ARMED=no
          else
            SC_GG_C=""
            { SC_GG_C="$(<"$SC_GG")"; } 2>/dev/null || SC_GG_C=""
            if [ -n "$SC_GG_C" ]; then
              case "$SC_GG_C" in
                *"\"$SC_SID\": true"*|*"\"$SC_SID\":true"*) SC_ARMED=yes ;;  # engaged_sessions map
                *"\"session_id\": \"$SC_SID\""*|*"\"session_id\":\"$SC_SID\""*)
                  case "$SC_GG_C" in
                    *'"chain_engaged": true'*|*'"chain_engaged":true'*) SC_ARMED=yes ;;
                    *) SC_ARMED=no ;;
                  esac ;;
                *) SC_ARMED=no ;;
              esac
            fi
          fi
        fi
        if [ "$SC_ARMED" = "no" ]; then
          # tool_name via FIRST-match (top-level key precedes tool_input in the
          # harness payload; a spoofed occurrence inside content comes later).
          SC_TOOL=""
          case "$STDIN_JSON" in
            *'"tool_name"'*)
              _sct="${STDIN_JSON#*\"tool_name\"}"
              _sct="${_sct#*\"}"
              SC_TOOL="${_sct%%\"*}"
              ;;
          esac
          case "$SC_TOOL" in
            Write|Edit)
              # Dirty-journal append in pure shell (same row shape + gates as
              # the python leg). Any doubt → fall through instead of guessing.
              SC_FP=""
              case "$STDIN_JSON" in
                *'"file_path"'*)
                  _scf="${STDIN_JSON#*\"file_path\"}"
                  _scf="${_scf#*\"}"
                  SC_FP="${_scf%%\"*}"
                  ;;
              esac
              case "$SC_FP" in
                *\\*) : ;;                       # escaped (Windows) → python leg
                "${SC_ROOT}"/*)
                  case "$SC_FP" in *"/.mega-sdd/"*) SC_V7_DONE=2 ;; *)
                  # No [ -f ] existence check: the python leg never had one, and
                  # PostToolUse fires after a SUCCESSFUL Write anyway — an
                  # existence probe here silently dropped rows in harness/test
                  # contexts. The SC_ROOT-prefix match above is the garbage guard.
                  if [ -d "${SC_ROOT}/.mega-sdd/codebase" ]; then
                    SC_CFG_C=""
                    [ -f "${SC_ROOT}/.mega-sdd/config.yaml" ] && { SC_CFG_C="$(<"${SC_ROOT}/.mega-sdd/config.yaml")" 2>/dev/null || SC_CFG_C=""; }
                    # anchored to line start (review R-5): a commented/prefixed key must not match
                    SC_NL=$'\n'
                    if [[ ! "$SC_CFG_C" =~ (^|$SC_NL)[[:space:]]*dirty_journal:[[:space:]]*false ]]; then
                      SC_DJ="${SC_ROOT}/.mega-sdd/codebase/.dirty-paths.jsonl"
                      SC_SZ=0
                      [ -f "$SC_DJ" ] && SC_SZ=$(wc -c < "$SC_DJ" 2>/dev/null || echo 0)
                      if [ "${SC_SZ:-0}" -lt 1048576 ]; then
                        printf '{"ts":"%s","path":"%s","tool":"%s","session":"%s"}\n' \
                          "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${SC_FP#"${SC_ROOT}"/}" "$SC_TOOL" "${SC_SID:-unknown}" \
                          >> "$SC_DJ" 2>/dev/null || true
                      fi
                    fi
                    SC_V7_DONE=2
                  fi
                  # no journal gate dir → nothing to record (python leg matches)
                  [ "$SC_V7_DONE" -eq 0 ] && SC_V7_DONE=2
                  ;; esac
                  ;;
                "") : ;;                          # unextractable → python leg
                *) SC_V7_DONE=2 ;;                # out-of-tree write → never journaled anyway
              esac
              [ "$SC_V7_DONE" -eq 2 ] && exit 0
              ;;
            "") : ;;                              # unextractable → python leg
            *) exit 0 ;;                          # Read/Bash/Skill/Agent, not armed → nothing to do
          esac
        fi
      fi
      fi  # size cap
    fi
  fi
fi

# ─── v7 chain-armed probe (spec §3.1 — same contract as pre-tool-use) ────────
# armed ⇔ .gateguard-state.json carries chain_engaged for THIS session. Called
# by the Write|Edit and Bash branches below AFTER the dirty-journal append: not
# armed → skip the validator fan-out (the PreToolUse gate-time re-derivation is
# the moat; this fan-out is early-warning). Fail-CLOSED like its sibling.
v7_chain_armed() {
  local sid="${SESSION_ID:-}" gg="${PROJECT_ROOT}/.mega-sdd/.gateguard-state.json" c=""
  case "$STDIN_JSON" in *'"agent_id"'*|*'"parent_tool_use_id"'*|*agent_transcript_path*) return 0 ;; esac
  [ -f "${PROJECT_ROOT}/.mega-sdd/.plan-pending" ] && return 0
  # absent-session normalization: this hook's parse defaults to "unknown-session",
  # the pre-tool-use writer normalizes to "no-session" — map both to the writer's form.
  case "$sid" in ""|unknown-session|unknown) sid="no-session" ;; esac
  [ -f "$gg" ] || return 1
  { c="$(<"$gg")"; } 2>/dev/null || return 0
  [ -n "$c" ] || return 0
  # v7 review R-2 (shared worktree): armed if MY sid is in the engaged_sessions
  # map — a concurrent session re-stamping the top-level record never un-arms me.
  case "$c" in
    *"\"$sid\": true"*|*"\"$sid\":true"*) return 0 ;;
  esac
  case "$c" in
    *"\"session_id\": \"$sid\""*|*"\"session_id\":\"$sid\""*) : ;;
    *) return 1 ;;
  esac
  case "$c" in
    *'"chain_engaged": true'*|*'"chain_engaged":true'*) return 0 ;;
    *) return 1 ;;
  esac
}

# Parse stdin via python3. EVERY value is shell-quoted with shlex.quote() because
# the consumer below is `eval` — a bare `KEY=value` line is re-parsed by the shell,
# which mangles or EXECUTES the value. Measured on bash 5 (2026-07-29):
#   KEY=/Users/me/My Docs/x.md   -> KEY unset (prefix-assignment + a failed command)
#   KEY=/tmp/$(touch ./PWNED)n.md-> KEY=/tmp/n.md  and ./PWNED IS CREATED
#   KEY=C:\proj\.mega-sdd\x.md   -> KEY=C:proj.mega-sddx.md (every \ eaten)
# So: any path containing a space was silently dropped on EVERY platform, every
# Windows path was destroyed (making PROJECT_ROOT garbage and this whole hook
# inert there), and a path carrying $(…) was executed. shlex.quote closes all
# three at the source; `emit()` keeps it impossible to add a new unquoted field.
PARSE_OUTPUT=$(printf '%s' "$STDIN_JSON" | python3 -c '
import json
import shlex
import sys

def emit(key, value):
    print(key + "=" + shlex.quote(str(value)))

try:
    data = json.loads(sys.stdin.read())
except Exception:
    sys.exit(0)

session_id = data.get("session_id", "unknown-session")
cwd = data.get("cwd", "")
tool_name = data.get("tool_name", "")
tool_input = data.get("tool_input", {})

emit("SESSION_ID", session_id)
emit("CWD", cwd)
emit("TOOL_NAME", tool_name)

if tool_name == "Read":
    emit("FILE_PATH", tool_input.get("file_path", ""))
    # D1 (spec 2026-08-17-token-lard-cuts-p1): the ACTUAL read range, so
    # ref_loaded can tell a §-scoped read from a full load. Empty when absent.
    # Sanity bound 10^9 (round catch: a 21-digit int passes isinstance and the
    # bash digit-guard, landing verbatim in the JSON row) — out-of-range = absent.
    def _rng(v):
        return v if isinstance(v, int) and not isinstance(v, bool) and 0 <= v < 10**9 else ""
    emit("READ_OFFSET", _rng(tool_input.get("offset", "")))
    emit("READ_LIMIT", _rng(tool_input.get("limit", "")))
elif tool_name == "Skill":
    emit("SKILL_NAME", tool_input.get("skill", ""))
elif tool_name == "Bash":
    # Pass command via base64 to avoid shell-quoting nightmares with multi-line commands.
    import base64
    cmd = tool_input.get("command", "")
    emit("BASH_CMD_B64", base64.b64encode(cmd.encode()).decode())
elif tool_name in ("Write", "Edit"):
    # Iter 67.6: [HOOK-VALIDATE] trigger for binding→units handoff validator.
    emit("FILE_PATH", tool_input.get("file_path", ""))
elif tool_name == "Agent":
    # Edge-case track: detect subagent failures (deep_scan_subagent_failed reframe).
    # Pass subagent_type + description for context. `description` is arbitrary model
    # prose — the value most likely to carry spaces, quotes, newlines and $(…).
    subagent_type = tool_input.get("subagent_type", "")
    description = tool_input.get("description", "")
    emit("AGENT_SUBAGENT_TYPE", subagent_type)
    emit("AGENT_DESCRIPTION", description[:200])
' 2>/dev/null)

if [ -z "$PARSE_OUTPUT" ]; then exit 0; fi

eval "$PARSE_OUTPUT" 2>/dev/null || true

# ─── D2: ONE separator normalization for the whole hook ──────────────────────
# Claude Code hands hooks NATIVE paths on Windows (C:\Users\me\proj\src\App.php).
# Everything downstream is written with "/": 12 `case "$FILE_PATH"` globs, the
# own-output anti-feedback guard (*"/.mega-sdd/"*), and the DIRTY_REL prefix strip
# against a PROJECT_ROOT that resolve_project_root has already normalized. A native
# path matched NONE of them, so on Windows the 6 background unit-write validators,
# the KB validators, codebase-map, binding, ui-quality, cross-cutting and
# factory-ledger dispatch never fired; the own-output guard leaked, making mega-sdd
# journal its own writes; and DIRTY_REL recorded an absolute path where consumers
# expect a repo-relative one.
#
# Normalizing HERE, once, is deliberate — a per-site fix would leave the next glob
# added to this file broken again. Validators receive the normalized value too,
# which is strictly better: they glob with "/" as well, and python opens a
# forward-slash Windows path fine. $OSTYPE-gated (a bash builtin — no fork), so a
# POSIX filename legitimately containing a backslash is never rewritten.
# The `:-` defaults are load-bearing, not defensive noise: this file runs under
# `set -u`, and FILE_PATH is emitted ONLY for Read/Write/Edit — it is unset for
# every Bash, Skill and Agent call. bash 3.2 tolerates pattern substitution on an
# unset name, but bash >= 4.4 treats it as an unbound-variable error, which under
# `set -u` KILLS the hook outright. The team runs bash 5.3.15, so the bare form
# would have taken the hook down on the majority of tool calls on the exact
# platform this fix is for.
case "${OSTYPE:-}" in
  msys*|cygwin*|win32*)
    CWD="${CWD:-}";             CWD="${CWD//\\//}"
    FILE_PATH="${FILE_PATH:-}"; FILE_PATH="${FILE_PATH//\\//}"
    ;;
esac

if [ -z "${CWD:-}" ]; then exit 0; fi

# ─── Resolve project root (Iter 71 — class-bug fix) ──────────────────────────
# CWD from stdin may be a sub-folder (model cd'd into .mega-sdd/knowledge-base/
# during a chain step). Walk UP to outermost .mega-sdd/ parent so state files
# land in the canonical location instead of a nested .mega-sdd/<sub>/.mega-sdd/.
# Script-dir via parameter expansion (spec §4b — no dirname exec); $0 is
# absolute in the shipped dispatch; the subshell fallback covers relative $0.
SCRIPT_DIR_RPR="${0%/*}"
case "$SCRIPT_DIR_RPR" in
  /*) ;;
  *) SCRIPT_DIR_RPR="$(cd "$(dirname "$0")" && pwd 2>/dev/null)" ;;
esac
RPR_HELPER="${SCRIPT_DIR_RPR}/../scripts/_lib/resolve-project-root.sh"
if [ -f "$RPR_HELPER" ]; then
  # shellcheck disable=SC1090
  . "$RPR_HELPER"
  PROJECT_ROOT=$(resolve_project_root "$CWD")
else
  PROJECT_ROOT="$CWD"
fi

# Opt-out: <project-root>/.mega-sdd/config.yaml `telemetry: false`
CONFIG_FILE="${PROJECT_ROOT}/.mega-sdd/config.yaml"
# Precedence (A7, spec 2026-08-17-a7-userconfig): project config.yaml `telemetry:`
# ALWAYS wins; the install-time userConfig (CLAUDE_PLUGIN_OPTION_TELEMETRY) is the
# user-global DEFAULT consulted only when the project file carries no telemetry line.
if [ -f "$CONFIG_FILE" ] && grep -qE "^\s*telemetry:" "$CONFIG_FILE" 2>/dev/null; then
  if grep -qE "^\s*telemetry:\s*false" "$CONFIG_FILE" 2>/dev/null; then
    exit 0
  fi
elif [ "${CLAUDE_PLUGIN_OPTION_TELEMETRY:-}" = "false" ]; then
  exit 0
fi

TS=$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo "unknown-ts")
TELEMETRY_FILE="${PROJECT_ROOT}/.mega-sdd/memory/telemetry.jsonl"

# Helper: emit one ref_loaded event for a path (computes lines/bytes/est_tokens).
# D1 (spec 2026-08-17-token-lard-cuts-p1): optional $3=offset $4=limit record the
# ACTUAL Read range; est_read_tokens is the line-proportional estimate so a
# §-scoped read is distinguishable from a full load. lines/bytes/estimated_tokens
# keep their full-file meaning (additive schema — existing consumers unbroken).
emit_ref_loaded() {
  local file_path="$1"
  local source_tool="$2"  # "Read" or "Bash"
  local read_offset="${3:-}"
  local read_limit="${4:-}"
  local lines bytes est_tokens file_path_json off_json lim_json est_read
  if [ -f "$file_path" ]; then
    lines=$(wc -l < "$file_path" 2>/dev/null | tr -d ' ' || echo 0)
    bytes=$(wc -c < "$file_path" 2>/dev/null | tr -d ' ' || echo 0)
    est_tokens=$((bytes / 4))
  else
    lines=0; bytes=0; est_tokens=0
  fi
  off_json="null"; lim_json="null"; est_read=$est_tokens
  case "$read_offset" in (*[!0-9]*|"") ;; (*) off_json=$read_offset ;; esac
  case "$read_limit" in
    (*[!0-9]*|"") ;;
    (*)
      lim_json=$read_limit
      if [ "$lines" -gt 0 ] && [ "$read_limit" -lt "$lines" ]; then
        est_read=$((est_tokens * read_limit / lines))
      fi
      ;;
  esac
  file_path_json=$(printf '%s' "$file_path" | sed 's|\\|\\\\|g; s|"|\\"|g')
  mkdir -p "$(dirname "$TELEMETRY_FILE")" 2>/dev/null || return 0
  echo "{\"ts\":\"$TS\",\"skill\":\"orchestrate-flow\",\"event_type\":\"ref_loaded\",\"session_id\":\"${SESSION_ID:-unknown}\",\"hook_source\":\"PostToolUse\",\"payload\":{\"file_path\":\"$file_path_json\",\"lines\":$lines,\"bytes\":$bytes,\"estimated_tokens\":$est_tokens,\"read_offset\":$off_json,\"read_limit\":$lim_json,\"est_read_tokens\":$est_read,\"source_tool\":\"$source_tool\"}}" \
    >> "$TELEMETRY_FILE" 2>/dev/null || true
}

# Helper: is the path mega-sdd-relevant?
is_megasdd_path() {
  case "$1" in
    *plugins/mega-sdd/skills/*/SKILL.md|*plugins/mega-sdd/skills/*/references/*|*plugins/mega-sdd/references/*|*plugins/mega-sdd/CLAUDE.md|*.mega-sdd/vaults/*|*.mega-sdd/codebase/*|*.mega-sdd/knowledge-base/*)
      return 0 ;;
    *) return 1 ;;
  esac
}

case "${TOOL_NAME:-}" in
  Read)
    FILE_PATH="${FILE_PATH:-}"
    [ -z "$FILE_PATH" ] && exit 0
    if is_megasdd_path "$FILE_PATH"; then
      emit_ref_loaded "$FILE_PATH" "Read" "${READ_OFFSET:-}" "${READ_LIMIT:-}"
    fi
    ;;

  Skill)
    SKILL_NAME="${SKILL_NAME:-}"
    [ -z "$SKILL_NAME" ] && exit 0
    case "$SKILL_NAME" in
      mega-sdd:*|using-mega-sdd)
        skill_name_json=$(printf '%s' "$SKILL_NAME" | sed 's|\\|\\\\|g; s|"|\\"|g')
        mkdir -p "$(dirname "$TELEMETRY_FILE")" 2>/dev/null || exit 0
        echo "{\"ts\":\"$TS\",\"skill\":\"orchestrate-flow\",\"event_type\":\"skill_invoked\",\"session_id\":\"${SESSION_ID:-unknown}\",\"hook_source\":\"PostToolUse\",\"payload\":{\"skill_full_name\":\"$skill_name_json\"}}" \
          >> "$TELEMETRY_FILE" 2>/dev/null || true
        ;;
    esac

    # ── Edge-case: starterkit_metrics_inconsistent cross-check ──────────────
    # Only fire for mega-sdd:generate-units completion. Read transcript for handoff,
    # cross-check against starterkit-context.yaml.
    case "$SKILL_NAME" in
      mega-sdd:generate-units)
        # Extract transcript_path from STDIN_JSON
        TRANSCRIPT_PATH=$(printf '%s' "$STDIN_JSON" | python3 -c '
import json, sys
try:
    d = json.loads(sys.stdin.read())
    print(d.get("transcript_path", ""))
except Exception:
    print("")
' 2>/dev/null)
        SCRIPT_DIR_HV2="$(cd "$(dirname "$0")" && pwd)"
        VALIDATOR_SKM="${SCRIPT_DIR_HV2}/../scripts/validate-starterkit-metrics.sh"
        if [ -x "$VALIDATOR_SKM" ] && [ -n "$TRANSCRIPT_PATH" ]; then
          bash "$VALIDATOR_SKM" --cwd="$PROJECT_ROOT" --transcript-path="$TRANSCRIPT_PATH" --quiet >/dev/null 2>&1 || true
          STATE_SKM="${PROJECT_ROOT}/.mega-sdd/.starterkit-metrics-state.json"
          if [ -f "$STATE_SKM" ]; then
            SKM_STATUS=$(python3 -c "
import json
try: print(json.load(open('$STATE_SKM')).get('status', '?'))
except: print('?')
" 2>/dev/null)
            if [ "$SKM_STATUS" = "FAIL" ]; then
              EVENT=$(STATE_SKM="$STATE_SKM" TS_ENV="$TS" SESSION_ID_ENV="${SESSION_ID:-unknown}" python3 -c '
import json, os
try:
    d = json.load(open(os.environ["STATE_SKM"]))
    payload = {
        "halt_type": "starterkit_metrics_inconsistent",
        "fix_applied": "detection only; suggest scan-codebase --force-deep + regenerate units",
        "original_emit_site": "PostToolUse-Skill-validate-starterkit-metrics",
        "logged_at_chat": False,
        "quality_gate_subtype": "starterkit_metrics_inconsistent",
        "units_with_starterkit_rules": d.get("units_with_starterkit_rules"),
        "starterkit_partial": d.get("starterkit_partial"),
    }
    print(json.dumps({
        "ts": os.environ["TS_ENV"],
        "skill": "orchestrate-flow",
        "event_type": "halt_self_resolved",
        "session_id": os.environ["SESSION_ID_ENV"],
        "hook_source": "PostToolUse",
        "payload": payload,
    }, separators=(",", ":")))
except Exception:
    pass
' 2>/dev/null)
              [ -n "$EVENT" ] && echo "$EVENT" >> "$TELEMETRY_FILE" 2>/dev/null || true
            fi
          fi
        fi
        ;;
    esac
    ;;

  Agent)
    # ── Edge-case: deep_scan_subagent_failed telemetry ──────────────────────
    # PostToolUse fires after Agent completes. We can't auto-retry from here
    # (hooks can't invoke tools), but we CAN emit warning telemetry if subagent
    # returned a failure response. The tool_response shape may vary; check for
    # common failure indicators.
    AGENT_SUBAGENT_TYPE="${AGENT_SUBAGENT_TYPE:-}"
    [ -z "$AGENT_SUBAGENT_TYPE" ] && exit 0
    # Only act on mega-sdd-relevant subagent dispatches (scan-codebase deep-scan agents)
    case "$AGENT_SUBAGENT_TYPE" in
      *scan*|*starterkit*|*deep*)
        # Extract tool_response status — best effort, response shape varies
        AGENT_FAIL=$(printf '%s' "$STDIN_JSON" | python3 -c '
import json, sys
status = "OK"
try:
    d = json.loads(sys.stdin.read())
    tr = d.get("tool_response", {})
    if isinstance(tr, dict):
        if tr.get("is_error") or tr.get("error") or tr.get("status") == "failed":
            status = "FAIL"
    if status == "OK":
        text = str(tr) if not isinstance(tr, str) else tr
        if any(kw in text.lower() for kw in ["error:", "failed", "exception", "timeout", "cannot"]):
            count = sum(1 for kw in ["error", "failed", "exception", "timeout", "cannot"] if kw in text.lower())
            if count >= 2:
                status = "FAIL"
except Exception:
    pass
print(status)
' 2>/dev/null)
        if [ "$AGENT_FAIL" = "FAIL" ]; then
          subagent_json=$(printf '%s' "$AGENT_SUBAGENT_TYPE" | sed 's|\\|\\\\|g; s|"|\\"|g')
          desc_json=$(printf '%s' "${AGENT_DESCRIPTION:-}" | sed 's|\\|\\\\|g; s|"|\\"|g')
          mkdir -p "$(dirname "$TELEMETRY_FILE")" 2>/dev/null
          echo "{\"ts\":\"$TS\",\"skill\":\"orchestrate-flow\",\"event_type\":\"halt_self_resolved\",\"session_id\":\"${SESSION_ID:-unknown}\",\"hook_source\":\"PostToolUse\",\"payload\":{\"halt_type\":\"deep_scan_subagent_failed\",\"fix_applied\":\"detected via Agent tool failure response; warning emitted (auto-retry remains skill-body responsibility)\",\"original_emit_site\":\"PostToolUse-Agent-failure-detect\",\"logged_at_chat\":false,\"subagent_type\":\"$subagent_json\",\"description\":\"$desc_json\"}}" \
            >> "$TELEMETRY_FILE" 2>/dev/null || true
        fi
        ;;
    esac
    ;;

  Bash)
    # Iter 67.5: scan Bash command for obvious file-read patterns targeting mega-sdd paths.
    # HONEST LIMITATIONS:
    # - Only catches cat/head/tail/grep/less/more/rg as command verb
    # - Misses: shell redirection (`< file`), command substitution, awk/sed reading via stdin,
    #   complex pipelines, find-exec, xargs, anything in shell functions/aliases
    # - (Subagent-internal Bash calls ARE visible — PostToolUse fires inside subagents; see the
    #   archived audit record docs/superpowers/audits/2026-06-05-audit-md-rounds-1-3-ARCHIVED.md
    #   Round-2 L1. The under-count is async/lossy emission + the unparseable patterns above.)
    # - This is a best-effort approximation; ref_loaded UNDER-COUNTS true reads.
    BASH_CMD_B64="${BASH_CMD_B64:-}"
    [ -z "$BASH_CMD_B64" ] && exit 0

    # v7: the whole Bash leg (ref_loaded telemetry mining + the dispatch-prompt
    # validator + pandoc-failure detection) is chain-scoped — advisory surfaces
    # that only mean something while a chain is producing artifacts (spec §3.3).
    v7_chain_armed || exit 0

    # Extract mega-sdd-relevant file paths from the command. Scan all tokens.
    PATHS_FOUND=$(BASH_CMD_B64="$BASH_CMD_B64" python3 -c '
import os, re, base64, shlex
cmd = base64.b64decode(os.environ["BASH_CMD_B64"]).decode("utf-8", errors="replace")
# Quick verb filter — skip entirely if no read-like verb present
read_verbs = ("cat", "head", "tail", "grep", "less", "more", "rg", "bat", "view", "awk", "sed")
lowered = cmd.lower()
if not any(re.search(rf"\b{v}\b", lowered) for v in read_verbs):
    raise SystemExit(0)
# Path patterns we care about
patterns = (
    r"plugins/mega-sdd/skills/[^\s]+/SKILL\.md",
    r"plugins/mega-sdd/skills/[^\s]+/references/[^\s]+",
    r"plugins/mega-sdd/references/[^\s]+",
    r"plugins/mega-sdd/CLAUDE\.md",
    r"\.mega-sdd/vaults/[^\s]+",
    r"\.mega-sdd/codebase/[^\s]+",
    r"\.mega-sdd/knowledge-base/[^\s]+",
)
hits = set()
for pat in patterns:
    for m in re.finditer(pat, cmd):
        hits.add(m.group(0).rstrip(",;|>)"))
for h in sorted(hits):
    print(h)
' 2>/dev/null)

    if [ -n "$PATHS_FOUND" ]; then
      while IFS= read -r p; do
        [ -z "$p" ] && continue
        # Resolve to absolute path if relative — relative to CWD
        if [ "${p#/}" = "$p" ]; then abs_path="${CWD}/${p}"; else abs_path="$p"; fi
        emit_ref_loaded "$abs_path" "Bash"
      done <<< "$PATHS_FOUND"
    fi

    # ── Code-delivery slice F (Bash leg): builder-written dispatch prompt ───
    # PARITY RESTORE, not a new gate. The Write|Edit leg below dispatches
    # validate-dispatch-prompt.sh on any write of
    # `*.mega-sdd/vaults/*/bolts/*/dispatch-prompt.md`. Before the builder
    # existed, execute-bolts materialized that file with Write, so the validator
    # fired automatically, per bolt, with zero model cooperation. The builder
    # now writes it from inside Python — no Write tool event, so that leg went
    # dead and the only replacement was a prose line in SKILL.md telling the
    # model to run the validator itself. `gates > rules > hooks` is one-way:
    # an existing deterministic hook is never downgraded into prose. This leg
    # restores the automatic firing on the Bash call that runs the builder.
    #
    # Matches on the BASENAME so it catches both the ${CLAUDE_PLUGIN_ROOT} house
    # form and an absolute path. Deliberately does NOT read the builder's stdout
    # (a hook cannot see it) and does NOT reconstruct the prompt path from the
    # command string: validate-dispatch-prompt.sh's scan is project-wide /
    # current-truth, so --cwd alone is both correct and sufficient — the same
    # shape as the cross-cutting + ui-quality dispatches below.
    #
    # Fires once per builder invocation = once per bolt. That is PARITY with the
    # pre-builder Write cadence, not fan-out: the per-item spawn prohibition is
    # about spawns multiplied INSIDE one logical operation, and per-bolt firing
    # is the only cadence that survives a 40-unit run halting at unit 12.
    # Advisory (S6 EB-HONEST-3): nothing in PreToolUse reads
    # .dispatch-prompt-state.json — it is surfaced via analyze.
    if echo "$BASH_CMD_B64" | base64 -d 2>/dev/null | grep -q "build-dispatch-prompt\.sh"; then
      SCRIPT_DIR_BDP="$(cd "$(dirname "$0")" && pwd)"
      VALIDATOR_DP_B="${SCRIPT_DIR_BDP}/../scripts/validate-dispatch-prompt.sh"
      if [ -x "$VALIDATOR_DP_B" ]; then
        bash "$VALIDATOR_DP_B" --cwd="$PROJECT_ROOT" --quiet >/dev/null 2>&1 || true
      fi
    fi

    # ── pandoc render-failure rung REMOVED (v7 Fase 2 delete batch) ────────
    # The pandoc render validator is deleted; md2pdf's own GitHub-styled HTML
    # fallback already covers the failure mode without a hook observer. The
    # PostToolUseFailure hooks.json wiring existed only for this rung and is
    # removed with it.
    ;;

  Write|Edit)
    # Iter 67.6 [HOOK-VALIDATE] + Phase B B.2: on Write|Edit of mega-sdd-relevant
    # paths, run validators. Multiple validators may fire per path.
    # State files are OVERWRITE-NOT-APPEND (current truth); WIP spam self-clears.
    FILE_PATH="${FILE_PATH:-}"
    [ -z "$FILE_PATH" ] && exit 0

    SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

    # ── Living-vault dirty-paths journal (advisory; spec 2026-06-10-living-vault) ──
    # Source-file writes in a GROUNDED repo are journaled so /mega-sdd:sync +
    # the changed-set producers (scan --changed-only, derive-changed-paths.sh)
    # know what moved without git archaeology — covers in-session AI edits even
    # before they are committed. P2 rekey: the gate is `.mega-sdd/codebase/`
    # presence (map OR symbol-index) — the old map-only gate silenced the
    # journal forever on express-born projects that never grow a map.
    # Append-only JSONL, fail-silent, a HINT not ground truth (consumers union
    # it with the git channel). Never journals mega-sdd's own outputs.
    case "$FILE_PATH" in
      *"/.mega-sdd/"*) : ;;  # own outputs — never journal (anti-feedback-loop)
      "$PROJECT_ROOT"/*)
        # 6.0.1 F1: only IN-REPO writes are journaled — an out-of-tree path
        # (scratchpad, ~/.claude memory) used to survive the prefix-strip as an
        # ABSOLUTE path and fabricate a maintenance_sync change signal
        if [ -d "${PROJECT_ROOT}/.mega-sdd/codebase" ] && \
           ! grep -qE "^\s*dirty_journal:\s*false" "${PROJECT_ROOT}/.mega-sdd/config.yaml" 2>/dev/null; then
          DIRTY_JOURNAL="${PROJECT_ROOT}/.mega-sdd/codebase/.dirty-paths.jsonl"
          # Runaway guard: stop appending past 1 MB — the git channel still covers
          # everything, and a journal that large trips the >40% full-scan rule anyway.
          DIRTY_SIZE=0
          [ -f "$DIRTY_JOURNAL" ] && DIRTY_SIZE=$(wc -c < "$DIRTY_JOURNAL" 2>/dev/null || echo 0)
          if [ "${DIRTY_SIZE:-0}" -lt 1048576 ]; then
            DIRTY_REL="${FILE_PATH#"$PROJECT_ROOT"/}"
            DIRTY_TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
            printf '{"ts":"%s","path":"%s","tool":"%s","session":"%s"}\n' \
              "$DIRTY_TS" "$DIRTY_REL" "${TOOL_NAME:-write}" "${SESSION_ID:-unknown}" \
              >> "$DIRTY_JOURNAL" 2>/dev/null || true
          fi
        fi
        ;;
    esac

    # ── v7: everything below this line is VALIDATOR FAN-OUT — chain-scoped ──
    # (spec §3.3; gate-0 decision). The journal above stays always-on; the
    # validators run only in an armed session. Moat unaffected: the PreToolUse
    # aggregator re-derives every one of these states at the execute-bolts gate.
    v7_chain_armed || exit 0

    # ── Validator 1 (Iter 67.6 slice 1): binding→units handoff (OQ-ID propagation) ──
    # Fires when a unit file is saved. Re-validates entire handoff (current-truth state).
    case "$FILE_PATH" in
      *-bound/units/U-*.md|*-bound/units/_index.md|*.mega-sdd/vaults/*-bound/units/*.md|*.mega-sdd/vaults/*/units/U-*.md|*.mega-sdd/vaults/*/units/_index.md)
        VALIDATOR_BU="${SCRIPT_DIR}/../scripts/validate-handoff-binding-units.sh"
        if [ -x "$VALIDATOR_BU" ]; then
          ( bash "$VALIDATOR_BU" --cwd="$PROJECT_ROOT" --quiet >/dev/null 2>&1 || true ) &
        fi
        # Constitution clause propagation (same boundary, same trigger)
        VALIDATOR_CP="${SCRIPT_DIR}/../scripts/validate-constitution-propagation.sh"
        if [ -x "$VALIDATOR_CP" ]; then
          ( bash "$VALIDATOR_CP" --cwd="$PROJECT_ROOT" --quiet >/dev/null 2>&1 || true ) &
        fi
        # Starterkit conformance — units must match starterkit-context.yaml §patterns
        VALIDATOR_SKC="${SCRIPT_DIR}/../scripts/validate-starterkit-conformance.sh"
        if [ -x "$VALIDATOR_SKC" ]; then
          ( bash "$VALIDATOR_SKC" --cwd="$PROJECT_ROOT" --quiet >/dev/null 2>&1 || true ) &
        fi
        # Flow-coverage (code-delivery slice A): flow-step -> artifact derivation +
        # scaffold-filter. SKIPs gracefully if the active pack declares no
        # `## Flow-artifact derivation` section. Writes .flow-coverage-state.json;
        # PreToolUse Branch 5 reads its status to gate execute-bolts.
        VALIDATOR_FC="${SCRIPT_DIR}/../scripts/validate-flow-coverage.sh"
        if [ -x "$VALIDATOR_FC" ]; then
          ( bash "$VALIDATOR_FC" --cwd="$PROJECT_ROOT" --quiet >/dev/null 2>&1 || true ) &
        fi
        # Sibling-consistency (code-delivery slice B): cross-cutting concern coherence
        # + FK relation derivation across sibling units. SKIPs when the active pack
        # declares no `## Cross-cutting concerns`/`## Relation derivation`. Writes
        # .sibling-consistency-state.json; PreToolUse Branch 7 reads it to gate execute-bolts.
        VALIDATOR_SIB="${SCRIPT_DIR}/../scripts/validate-sibling-consistency.sh"
        if [ -x "$VALIDATOR_SIB" ]; then
          ( bash "$VALIDATOR_SIB" --cwd="$PROJECT_ROOT" --quiet >/dev/null 2>&1 || true ) &
        fi
        # Fan-out parity (Iter-79 A2): presence-parity of deliverable obligations
        # (UI contract, render test) across VIEW-BEARING siblings — catches "LC is
        # always the survivor". SKIPs when the pack declares no view_glob. Writes
        # .fanout-parity-state.json. ADVISORY ONLY — surfaced via analyze;
        # the PreToolUse aggregator does NOT read this state file (no blocking gate).
        # (Per CLAUDE.md: fan-out-parity is advisory, not a hard block.)
        VALIDATOR_FOP="${SCRIPT_DIR}/../scripts/validate-fanout-parity.sh"
        if [ -x "$VALIDATOR_FOP" ]; then
          ( bash "$VALIDATOR_FOP" --cwd="$PROJECT_ROOT" --quiet >/dev/null 2>&1 || true ) &
        fi
        # The 6 validators above are INDEPENDENT (each writes its own state file;
        # PreToolUse is the consumer) — run in parallel, then wait so all state
        # files are written before this async hook exits. Was: 6 sequential spawns.
        wait
        ;;
    esac

    # ─── Factory Line: validate the checkpoint ledger on write ────────────────
    case "$FILE_PATH" in
      */.mega-sdd/factory-ledger.json)
        VALIDATOR_FL="${SCRIPT_DIR}/../scripts/validate-factory-ledger.sh"
        if [ -x "$VALIDATOR_FL" ]; then
          bash "$VALIDATOR_FL" --cwd="$PROJECT_ROOT" --quiet >/dev/null 2>&1 || true
        fi
        ;;
    esac

    # ── Code-delivery slice E: UI scaffold-tells quality gate ───────────────
    # Style-A dispatch on Write|Edit of a VIEW file (generated UI source — NOT a
    # mega-sdd artifact). The trigger glob is deliberately GENEROUS (common view
    # locations across stacks: resources/views, templates, components, .blade/.vue/
    # .jsx/.tsx/.html); validate-ui-quality.sh re-resolves the active pack and re-scans
    # by the pack-declared view_glob, self-SKIPping when the pack omits the
    # `## UI quality signatures` section. Writes .ui-quality-blockers.json; PreToolUse
    # Branch 8 reads its status to gate execute-bolts. Scan is project-wide / current-truth.
    case "$FILE_PATH" in
      *resources/views/*|*/templates/*|*/components/*|*.blade.php|*.vue|*.jsx|*.tsx)
        VALIDATOR_UIQ="${SCRIPT_DIR}/../scripts/validate-ui-quality.sh"
        if [ -x "$VALIDATOR_UIQ" ]; then
          bash "$VALIDATOR_UIQ" --cwd="$PROJECT_ROOT" --file-path="$FILE_PATH" --quiet >/dev/null 2>&1 || true
        fi
        ;;
    esac

    # ── Code-delivery slice C: cross-cutting registration scan ──────────────
    # Style-A dispatch on Write|Edit of a backend model/source file. The trigger glob is
    # GENEROUS (common model dirs across stacks: app/Models, Models, models, app/Entities,
    # domain, src/models); validate-cross-cutting-registration.sh re-resolves the active pack
    # and re-scans the pack-declared registration_target_glob (current-truth, project-wide),
    # self-SKIPping when no concern declares a registration_signature + target glob. Writes
    # .cross-cutting-state.json; PreToolUse Branch 11 reads its status to gate execute-bolts.
    case "$FILE_PATH" in
      */app/Models/*|*/Models/*|*/models/*|*/app/Entities/*|*/domain/*|*/src/models/*)
        VALIDATOR_CC="${SCRIPT_DIR}/../scripts/validate-cross-cutting-registration.sh"
        if [ -x "$VALIDATOR_CC" ]; then
          bash "$VALIDATOR_CC" --cwd="$PROJECT_ROOT" --quiet >/dev/null 2>&1 || true
        fi
        ;;
    esac

    # ── Code-delivery slice F: UI dispatch-prompt enrichment check ──────────
    # Style-A dispatch on Write|Edit of an emitted bolt dispatch prompt
    # (<vault>/bolts/U-XXX/dispatch-prompt.md — written by execute-bolts). The
    # validator asserts a ui_ux unit's prompt actually carries injected design tokens
    # + a view/component exemplar; it self-SKIPs when the pack omits `## UI quality
    # signatures` (no view_glob) or no ui_ux prompt exists. Writes
    # .dispatch-prompt-state.json. ADVISORY (S6 EB-HONEST-3): nothing in PreToolUse
    # reads this state — it is surfaced via analyze, per the demotion list.
    # NOTE: the shipped writer is now scripts/build-dispatch-prompt.sh, which writes
    # from Python and fires no Write event — see the Bash-leg twin of this dispatch
    # in the Bash) branch above. This leg stays for hand/agent edits of an emitted
    # prompt and for any future Write-based writer; both legs run the same validator
    # with the same project-wide scan, so a double fire is idempotent (the state file
    # is OVERWRITE-not-append, current truth).
    case "$FILE_PATH" in
      *.mega-sdd/vaults/*/bolts/*/dispatch-prompt.md)
        VALIDATOR_DP="${SCRIPT_DIR}/../scripts/validate-dispatch-prompt.sh"
        if [ -x "$VALIDATOR_DP" ]; then
          bash "$VALIDATOR_DP" --cwd="$PROJECT_ROOT" --file-path="$FILE_PATH" --quiet >/dev/null 2>&1 || true
        fi
        ;;
    esac

    # ── Iter 68 path-scoped dispatch: codebase-map.md write ─────────────────
    # Triggers validate-codebase-map (frontmatter + 7-section schema integrity).
    # S3 V7: also fires for the legacy <project-root>/codebase-map.md location —
    # bind-codebase probes and binds against it, so it must be validated too.
    case "$FILE_PATH" in
      *.mega-sdd/codebase/codebase-map.md)
        VALIDATOR_CM="${SCRIPT_DIR}/../scripts/validate-codebase-map.sh"
        if [ -x "$VALIDATOR_CM" ]; then
          bash "$VALIDATOR_CM" --cwd="$PROJECT_ROOT" --quiet >/dev/null 2>&1 || true
        fi
        ;;
      */codebase-map.md|codebase-map.md)
        if [ "$FILE_PATH" = "${PROJECT_ROOT}/codebase-map.md" ] || [ "$FILE_PATH" = "codebase-map.md" ]; then
          VALIDATOR_CM="${SCRIPT_DIR}/../scripts/validate-codebase-map.sh"
          if [ -x "$VALIDATOR_CM" ]; then
            bash "$VALIDATOR_CM" --cwd="$PROJECT_ROOT" --quiet >/dev/null 2>&1 || true
          fi
        fi
        ;;
    esac

    # ── Iter 68 path-scoped dispatch: starterkit-context.yaml write ─────────
    # Triggers validate-starterkit-conformance against current units (if any).
    # Note: validate-starterkit-metrics (cross-check vs generate-units handoff)
    # remains on Skill matcher — it needs --transcript-path.
    case "$FILE_PATH" in
      *.mega-sdd/codebase/starterkit-context.yaml)
        VALIDATOR_SKC2="${SCRIPT_DIR}/../scripts/validate-starterkit-conformance.sh"
        if [ -x "$VALIDATOR_SKC2" ]; then
          bash "$VALIDATOR_SKC2" --cwd="$PROJECT_ROOT" --quiet >/dev/null 2>&1 || true
        fi
        ;;
    esac

    # ── Iter 68 path-scoped dispatch: binding*.md write ─────────────────────
    # Constitution clause propagation re-runs when binding clauses change
    # (mirror of the unit-write trigger above, but at producer side).
    case "$FILE_PATH" in
      *-bound/binding*.md|*.mega-sdd/vaults/*-bound/binding*.md|*.mega-sdd/vaults/*/binding-*.md|*/binding.md)
        VALIDATOR_CP2="${SCRIPT_DIR}/../scripts/validate-constitution-propagation.sh"
        if [ -x "$VALIDATOR_CP2" ]; then
          bash "$VALIDATOR_CP2" --cwd="$PROJECT_ROOT" --quiet >/dev/null 2>&1 || true
        fi
        # Also re-run vault→binding coverage (current-truth)
        VALIDATOR_VBC="${SCRIPT_DIR}/../scripts/validate-vault-binding-coverage.sh"
        if [ -x "$VALIDATOR_VBC" ]; then
          bash "$VALIDATOR_VBC" --cwd="$PROJECT_ROOT" --quiet >/dev/null 2>&1 || true
        fi
        # Iter-79 X-1: conflict-classification enrichment (advisory WARN; was
        # previously wired to NO hook + greped a structure the producer never
        # emits → vacuous. Now dispatched on binding write, detects the real
        # `### CONFLICT-N` markdown form).
        VALIDATOR_CCL="${SCRIPT_DIR}/../scripts/validate-conflict-classification.sh"
        if [ -x "$VALIDATOR_CCL" ]; then
          bash "$VALIDATOR_CCL" --cwd="$PROJECT_ROOT" --quiet >/dev/null 2>&1 || true
        fi
        # S4 BC-GATE-1: refresh the MOAT state on the PRODUCER side too. The
        # moat-state writer (validate-handoff-binding-units.sh) was keyed to
        # unit writes only, so a re-bind/sync writing binding.md with fresh
        # active CONFLICTs left .validation-blockers.json at a stale PASS and
        # execute-bolts sailed through an unresolved CONFLICT (invariant #2).
        # Binding writes now re-derive the moat state; the PreToolUse gate also
        # self-heals lazily (mtime), so BOTH write paths converge on current truth.
        VALIDATOR_BU2="${SCRIPT_DIR}/../scripts/validate-handoff-binding-units.sh"
        if [ -x "$VALIDATOR_BU2" ]; then
          bash "$VALIDATOR_BU2" --cwd="$PROJECT_ROOT" --quiet >/dev/null 2>&1 || true
        fi
        ;;
    esac

    # Helper: run a validator script + emit telemetry breadcrumb on FAIL.
    run_validator_and_emit() {
      local validator="$1"        # absolute path to script
      local state_file="$2"        # absolute path to state file the script writes
      local script_label="$3"      # human label for original_emit_site
      [ -x "$validator" ] || return 0
      bash "$validator" --cwd="$PROJECT_ROOT" --file-path="$FILE_PATH" --quiet >/dev/null 2>&1 || true
      [ -f "$state_file" ] || return 0
      local v_status
      v_status=$(python3 -c "
import json
try:
    d = json.load(open('$state_file'))
    print(d.get('status', 'UNKNOWN'))
except: print('?')
" 2>/dev/null)
      [ "$v_status" = "FAIL" ] || return 0
      local events
      events=$(STATE_FILE_V="$state_file" TS_ENV="$TS" SESSION_ID_ENV="${SESSION_ID:-unknown}" LABEL_ENV="$script_label" python3 -c '
import json, os
try:
    d = json.load(open(os.environ["STATE_FILE_V"]))
    for issue in d.get("issues", []):
        payload = {
            "halt_type": issue["halt_type"],
            "fix_applied": "detection-only at hook layer; manual review or skill-body fix required",
            "original_emit_site": os.environ["LABEL_ENV"],
            "logged_at_chat": False,
            "detail": issue.get("detail", ""),
            "checked_file": d.get("checked_file"),
        }
        for k in ("unit_id", "task_type", "missing_fields", "missing_sections",
                  "missing_decisions", "expected_marker", "expected_key",
                  "bolt_report_path", "unit_path", "unparseable_lines",
                  "missing_citations_excerpts"):
            if k in issue:
                payload[k] = issue[k]
        print(json.dumps({
            "ts": os.environ["TS_ENV"],
            "skill": "orchestrate-flow",
            "event_type": "halt_self_resolved",
            "session_id": os.environ["SESSION_ID_ENV"],
            "hook_source": "PostToolUse",
            "payload": payload,
        }, separators=(",", ":")))
except Exception:
    pass
' 2>/dev/null)
      [ -n "$events" ] && echo "$events" >> "$TELEMETRY_FILE" 2>/dev/null || true
    }

    # ── Input-keyed debounce for the 4 unconditional PROJECT-WIDE scanners ──
    # (spec §4e, tranche 4-second): bolt-artifacts, ui-deferral,
    # vault-binding-coverage, vault-flow-staging re-scan the project on EVERY
    # Write|Edit — including a 50-file source-code bolt run where none of their
    # inputs moved. Same architecture as the Stop hook's §4c turn-gate: skip
    # ONLY when (stamp exists) AND (HEAD == stamped sha) AND (the written file
    # is not itself under a mega-sdd tree) AND (nothing under
    # .mega-sdd / docs/mega-sdd / legacy *-bound is newer than the stamp,
    # rc-checked — a failed probe is DOUBT and must scan). Why a skip can never
    # lie to a gate: NONE of the four states is read by PreToolUse (ui-deferral
    # + vault-flow-staging are demoted-advisory; the other two appear at zero
    # of the gate aggregator's L() sites) and every gate-read state is
    # re-derived at the gate itself (S4/S5/S6); analyze re-runs the
    # validators fresh. Probe prunes = derived OUTPUTS only (state files, both
    # scan stamps, memory/, .cache/, analyze reports, and .dirty-paths.jsonl —
    # the journal THIS hook appends on every source write in a mapped repo;
    # without that prune the debounce would be vacuous exactly there). The
    # three file-scoped unconditional validators (unit-spec, vault-oqs,
    # fsd-slots) are NOT debounced — they key on the written file.
    # Known blind spot, shared with the Stop probe's -mindepth 1 (deliberate):
    # a DEPTH-1 deletion directly under a probe root (rm -rf .mega-sdd/vaults)
    # only bumps the root's mtime, which -mindepth 1 excludes — the skip
    # persists until HEAD moves or any mega-sdd-tree Write fires. Stale side is
    # advisory-only (none of the 4 states is gate-read; analyze re-runs fresh).
    PTU_SCAN_STAMP="${PROJECT_ROOT}/.mega-sdd/.ptu-scan-stamp"
    NEED_PTU_SCAN=1
    CUR_HEAD_PTU=$(git -C "$PROJECT_ROOT" rev-parse HEAD 2>/dev/null || printf '')
    if [ -f "$PTU_SCAN_STAMP" ] && [ -n "$CUR_HEAD_PTU" ]; then
      case "$FILE_PATH" in
        *.mega-sdd/*|*docs/mega-sdd/*|*-bound/*)
          : ;;  # written INTO a mega-sdd tree — its scanners must see it: scan
        *)
          LAST_HEAD_PTU=""
          IFS= read -r LAST_HEAD_PTU < "$PTU_SCAN_STAMP" 2>/dev/null || LAST_HEAD_PTU=""
          if [ "$CUR_HEAD_PTU" = "$LAST_HEAD_PTU" ]; then
            # Legacy trees probed when present: docs/mega-sdd plus root-level
            # *-bound vault dirs (the vault_layouts.py discovery globs).
            PTU_PROBE_DIRS=("${PROJECT_ROOT}/.mega-sdd")
            [ -d "${PROJECT_ROOT}/docs/mega-sdd" ] && PTU_PROBE_DIRS+=("${PROJECT_ROOT}/docs/mega-sdd")
            for _bd in "${PROJECT_ROOT}"/*-bound "${PROJECT_ROOT}"/*/*-bound; do
              [ -d "$_bd" ] && PTU_PROBE_DIRS+=("$_bd")
            done
            CHANGED_PTU=$(find "${PTU_PROBE_DIRS[@]}" -mindepth 1 \
              \( -name memory -o -name .cache \) -prune -o \
              \( -name .analyze-state.json -o -name CONSISTENCY-REPORT.md \
                 -o -name .analyze-freshness.json \
                 -o -name claims-ledger.json \
                 -o -name TOKEN-COST-REPORT.md -o -name .token-cost-state.json \
                 -o -name '.*-state.json' -o -name .validation-blockers.json \
                 -o -name .ui-quality-blockers.json -o -name .stop-scan-stamp \
                 -o -name .ptu-scan-stamp -o -name .dirty-paths.jsonl \
                 -o -name state.json -o -name graph.json \
                 -o -name .locked-files-index.json \
                 -o -name .compaction-snapshot.json \) -prune -o \
              -newer "$PTU_SCAN_STAMP" -print 2>/dev/null)
            FIND_RC_PTU=$?
            [ "$FIND_RC_PTU" -eq 0 ] && [ -z "$CHANGED_PTU" ] && NEED_PTU_SCAN=0
          fi
          ;;
      esac
    fi

    # ── Validator 2 (Phase B slice B.2): bolt artifacts ─────────────────────
    if [ "$NEED_PTU_SCAN" = "1" ]; then
    run_validator_and_emit \
      "${SCRIPT_DIR}/../scripts/validate-bolt-artifacts.sh" \
      "${PROJECT_ROOT}/.mega-sdd/.bolt-artifacts-state.json" \
      "PostToolUse-Write-validate-bolt-artifacts"
    fi

    # ── UI-deferral (Iter-79 B1): bolt-report defers a `## UI contract` to a future
    # unit ("scaffold kept; polish deferred"). Project-wide scan; self-SKIPs when no
    # bolt-reports / no pack UI signatures. ADVISORY (S6 EB-HONEST-2): nothing in
    # PreToolUse reads .ui-deferral-state.json — it is surfaced via analyze.
    if [ "$NEED_PTU_SCAN" = "1" ]; then
    run_validator_and_emit \
      "${SCRIPT_DIR}/../scripts/validate-ui-deferral.sh" \
      "${PROJECT_ROOT}/.mega-sdd/.ui-deferral-state.json" \
      "PostToolUse-Write-validate-ui-deferral"
    fi

    # ── Validator 3 (Phase B slice B.3): unit spec ──────────────────────────
    run_validator_and_emit \
      "${SCRIPT_DIR}/../scripts/validate-unit-spec.sh" \
      "${PROJECT_ROOT}/.mega-sdd/.unit-spec-state.json" \
      "PostToolUse-Write-validate-unit-spec"

    # ── Validator 4 (Phase B slice B.4): vault OQ citations ─────────────────
    run_validator_and_emit \
      "${SCRIPT_DIR}/../scripts/validate-vault-oqs.sh" \
      "${PROJECT_ROOT}/.mega-sdd/.vault-oqs-state.json" \
      "PostToolUse-Write-validate-vault-oqs"

    # ── Validator 5 (Phase B slice B.5): FSD template slots ─────────────────
    run_validator_and_emit \
      "${SCRIPT_DIR}/../scripts/validate-fsd-slots.sh" \
      "${PROJECT_ROOT}/.mega-sdd/.fsd-slots-state.json" \
      "PostToolUse-Write-validate-fsd-slots"

    # ── Validator 6 (Phase C slices 4+5): vault→binding + units→bolts ──────
    # Project-wide scan; runs on any Write|Edit (script self-skips when no vaults).
    if [ "$NEED_PTU_SCAN" = "1" ]; then
    run_validator_and_emit \
      "${SCRIPT_DIR}/../scripts/validate-vault-binding-coverage.sh" \
      "${PROJECT_ROOT}/.mega-sdd/.vault-binding-coverage-state.json" \
      "PostToolUse-Write-validate-vault-binding-coverage"
    fi

    # ── Validator 6b (semantic-depth): staged-input non-loss KB→vault ──────
    # Follows each 04-flows.md flow's `_kb_source` back-reference; FAILs with
    # vault_flow_staging_drop when the cited KB workflow has a `stages:` block but
    # the vault flow dropped it. Project-wide scan; self-skips when no KB / no
    # `_kb_source` (backward-compatible).
    #
    # ADVISORY — surfaced via analyze, NOT a blocking gate. This comment
    # previously claimed "PreToolUse Branch 14 gates execute-bolts on its
    # status==FAIL", which was false in both directions: `pre-tool-use:405` lists
    # vault-flow-staging among the states DEMOTED to advisory, and the gate's state
    # loader never reads `.vault-flow-staging-state.json` at all (verified against
    # the 11 `L(".…")` sites, 2026-07-29). CLAUDE.md's enforced/advisory table was
    # already correct; only this comment had drifted. A comment that overstates
    # enforcement is not cosmetic — it is what makes the next person scoping a
    # change here treat an advisory validator as load-bearing.
    if [ "$NEED_PTU_SCAN" = "1" ]; then
    run_validator_and_emit \
      "${SCRIPT_DIR}/../scripts/validate-vault-flow-staging.sh" \
      "${PROJECT_ROOT}/.mega-sdd/.vault-flow-staging-state.json" \
      "PostToolUse-Write-validate-vault-flow-staging"

    # Stamp ONLY after all four project-wide scans completed this firing, only
    # when HEAD resolved, and only in an ADOPTED project (the stamp must never
    # MINT .mega-sdd/ — the 4a cache/EB-GATE-6 lesson). A crash before this
    # line re-scans on the next firing — fail toward scanning.
    if [ -n "$CUR_HEAD_PTU" ] && [ -d "${PROJECT_ROOT}/.mega-sdd" ]; then
      printf '%s\n' "$CUR_HEAD_PTU" > "$PTU_SCAN_STAMP" 2>/dev/null || true
    fi
    fi

    # ── Validator 6c: vault flow Mermaid mandate (Mermaid-flows hard rule) ──
    # Fires on a vault 04-flows.md write. Each F-<prefix>-NNN flow body must be a
    # Mermaid diagram (not a prose Steps list); reuses the shared
    # _lib/mermaid_syntax.py tokenizer. Advisory (detection-only at hook layer).
    # See docs/superpowers/specs/2026-07-01-mermaid-flows-hard-rule.md.
    case "$FILE_PATH" in
      *04-flows.md)
        run_validator_and_emit \
          "${SCRIPT_DIR}/../scripts/validate-vault-flows.sh" \
          "${PROJECT_ROOT}/.mega-sdd/.vault-flows-state.json" \
          "PostToolUse-Write-validate-vault-flows"
        ;;
    esac

    # ── Validator 7 (R2): KB output validation ────────────────────────────
    # Fires when KB domain/workflow/business-rules files are saved.
    case "$FILE_PATH" in
      *.mega-sdd/knowledge-base/10-domains/*.md|*.mega-sdd/knowledge-base/20-workflows/*.md|*.mega-sdd/knowledge-base/40-business-rules/*.md|*.mega-sdd/knowledge-base/50-integrations/*.md|*.mega-sdd/knowledge-base/99-rebuild-architecture/*.md)
        run_validator_and_emit \
          "${SCRIPT_DIR}/../scripts/validate-kb-output.sh" \
          "${PROJECT_ROOT}/.mega-sdd/.kb-output-state.json" \
          "PostToolUse-Write-validate-kb-output"
        # Iter-79 U-EI: reengineering-synthesis presence (the phase's REASONING output,
        # vs the transcription checks above). Advisory; self-SKIPs when no mutability
        # markers / no 99-rebuild-architecture/.
        run_validator_and_emit \
          "${SCRIPT_DIR}/../scripts/validate-kb-reengineering.sh" \
          "${PROJECT_ROOT}/.mega-sdd/.kb-reengineering-state.json" \
          "PostToolUse-Write-validate-kb-reengineering"
        # Track 1: marker-accuracy validation (every [VERIFIED] must have citation)
        run_validator_and_emit \
          "${SCRIPT_DIR}/../scripts/validate-kb-markers.sh" \
          "${PROJECT_ROOT}/.mega-sdd/.kb-markers-state.json" \
          "PostToolUse-Write-validate-kb-markers"
        # Mermaid-consistency for flow sections
        run_validator_and_emit \
          "${SCRIPT_DIR}/../scripts/validate-kb-flows.sh" \
          "${PROJECT_ROOT}/.mega-sdd/.kb-flows-state.json" \
          "PostToolUse-Write-validate-kb-flows"
        # Iter 68: KB §11 citation resolution (auto-detects legacy root)
        run_validator_and_emit \
          "${SCRIPT_DIR}/../scripts/validate-kb-citations.sh" \
          "${PROJECT_ROOT}/.mega-sdd/.kb-citations-state.json" \
          "PostToolUse-Write-validate-kb-citations"
        ;;
    esac

    # ── Auto-analyze at phase boundary (aggregate-only) ────────────────────
    # When a major phase artifact is written, produce an updated consistency
    # report from existing state files. Cheap (no re-run), gives inter-phase
    # visibility. Fires on binding.md, vault.json, _index.md (unit index),
    # FSD.md, DRIFT-REPORT.md writes.
    case "$FILE_PATH" in
      */binding*.md|*/vault.json|*-bound/units/_index.md|*/fsd/FSD.md|*/DRIFT-REPORT*.md)
        ANALYZE_SCRIPT="${SCRIPT_DIR}/../scripts/run-analyze.sh"
        if [ -x "$ANALYZE_SCRIPT" ]; then
          bash "$ANALYZE_SCRIPT" --cwd="$PROJECT_ROOT" --aggregate-only --quiet >/dev/null 2>&1 || true
        fi
        ;;
    esac
    ;;

  *)
    exit 0
    ;;
esac

exit 0
