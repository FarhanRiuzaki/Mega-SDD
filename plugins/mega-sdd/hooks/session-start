#!/usr/bin/env bash
# SessionStart hook for mega-sdd plugin.
# Inject `using-mega-sdd` anchor skill content when SDD signals detected in CWD.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
ANCHOR_SKILL="${PLUGIN_ROOT}/skills/using-mega-sdd/SKILL.md"

# Detect SDD signals in CWD (purely heuristic, no false positives in casual sessions).
# Iter 67.5 (v3.48.0+): added `.mega-sdd` to the head of the list — canonical v3.4+ layout puts
# vaults/binding/codebase under `.mega-sdd/` not at cwd root. Without this entry, the anchor
# never injected for any v3.4+ project (audit 2026-05-27 §A1, silent regression since v3.4 ship).
cwd="$(pwd)"
has_sdd_signal=0
for signal in ".mega-sdd" "docs/mega-sdd" "vaults" "bound-vault" "units" "binding.md" "codebase-map.md"; do
  if [ -e "${cwd}/${signal}" ]; then
    has_sdd_signal=1
    break
  fi
done

# If no signals, skip injection
if [ "$has_sdd_signal" -eq 0 ]; then
  exit 0
fi

# Build context injection JSON for Claude Code SessionStart spec
if [ ! -f "$ANCHOR_SKILL" ]; then
  echo "WARN: anchor skill missing: $ANCHOR_SKILL" >&2
  exit 0
fi

ANCHOR_CONTENT="$(cat "$ANCHOR_SKILL")"

# Check superpowers presence
sp_cache="${HOME}/.claude/plugins/cache"
sp_present=0
if find "$sp_cache" -maxdepth 4 -type d -name "superpowers" 2>/dev/null | grep -q .; then
  sp_present=1
fi

WARN=""
if [ "$sp_present" -eq 0 ]; then
  WARN=$'\n\n<important-reminder>⚠️ Mega-SDD detected SDD work in CWD but the `superpowers` plugin is not installed. Bolts phase will use vendored fallback. For full features run: `/plugin install superpowers`</important-reminder>'
fi

# ─── C1 self-resolve: mode_migrate (Iter 67.7.1 hook-layer enforcement) ─────
# Gate B response (reviewer 2026-05-27): C1 protocol shipped as prose has
# audit-failed 4×. Hook-layer enforcement deterministically detects + fixes
# the mode_migrate precondition before any chain starts.
#
# Detects: any active <cwd>/.mega-sdd/vaults/*/vault.json (excluding .archived/)
# where `mode` field is missing OR mismatches CWD signals.
# CWD signals → mode mapping (deterministic; no fabrication):
#   any of {.git, composer.json, package.json, Gemfile, Cargo.toml, go.mod,
#           build.gradle, pom.xml, requirements.txt, pyproject.toml} present
#     → expected_mode = "existing"
#   none present → expected_mode = "greenfield"
# Honors opt-out: <cwd>/.mega-sdd/config.yaml `telemetry: false` (treats this
# guard as part of telemetry surface; user opting out of telemetry also opts
# out of auto-fix to avoid stealth mutations).

SELF_RESOLVE_NOTICES=""
CONFIG_FILE="${cwd}/.mega-sdd/config.yaml"
GUARD_ENABLED=1
if [ -f "$CONFIG_FILE" ]; then
  if grep -qE "^\s*telemetry:\s*false" "$CONFIG_FILE" 2>/dev/null; then
    GUARD_ENABLED=0
  fi
fi

if [ "$GUARD_ENABLED" -eq 1 ] && [ -d "${cwd}/.mega-sdd/vaults" ]; then
  TELEMETRY_FILE="${cwd}/.mega-sdd/memory/telemetry.jsonl"
  mkdir -p "$(dirname "$TELEMETRY_FILE")" 2>/dev/null || true

  # Run mode_migrate self-resolve via python (deterministic JSON read/write)
  SELF_RESOLVE_NOTICES=$(CWD="$cwd" TELEMETRY_FILE="$TELEMETRY_FILE" python3 <<'PYEOF' 2>/dev/null
import json
import os
import sys
import glob
from datetime import datetime, timezone

cwd = os.environ["CWD"]
telemetry_file = os.environ["TELEMETRY_FILE"]

# CWD signals
signals = [
    ".git", "composer.json", "package.json", "Gemfile", "Cargo.toml",
    "go.mod", "build.gradle", "pom.xml", "requirements.txt", "pyproject.toml",
]
detected_signals = [s for s in signals if os.path.exists(os.path.join(cwd, s))]
expected_mode = "existing" if detected_signals else "greenfield"

# Find active vault.json files (exclude .archived/)
vault_jsons = []
for f in sorted(glob.glob(os.path.join(cwd, ".mega-sdd", "vaults", "*", "vault.json"))):
    if "/.archived/" in f or "/.archived\\" in f:
        continue
    vault_jsons.append(f)

notices = []
ts = datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")
session_id = os.environ.get("CLAUDE_SESSION_ID", "session-start-hook")

for vj in vault_jsons:
    try:
        with open(vj) as f:
            data = json.load(f)
    except Exception:
        continue  # Skip corrupted vault.json — separate halt class

    current_mode = data.get("mode")
    if current_mode == expected_mode:
        continue  # No mismatch; skip

    # Mismatch detected — apply C1 self-resolve
    old_mode_repr = current_mode if current_mode is not None else "(missing)"
    data["mode"] = expected_mode
    try:
        with open(vj, "w") as f:
            json.dump(data, f, indent=2)
            f.write("\n")
    except Exception:
        continue  # Write fail; skip (don't claim resolve)

    # Build relative path for notice
    rel_vj = os.path.relpath(vj, cwd)
    scope_name = os.path.basename(os.path.dirname(vj))

    # Emit telemetry event (the anti-hiding net per attestation Gate A)
    event = {
        "ts": ts,
        "skill": "session-start",
        "event_type": "halt_self_resolved",
        "session_id": session_id,
        "hook_source": "SessionStart",
        "payload": {
            "halt_type": "mode_migrate",
            "fix_applied": f"vault.json mode {old_mode_repr} → {expected_mode}",
            "original_emit_site": "SessionStart-hook-c1-guard",
            "logged_at_chat": True,
            "scope": scope_name,
            "detected_signals": detected_signals,
            "vault_json_path": rel_vj,
        },
    }
    try:
        with open(telemetry_file, "a") as f:
            f.write(json.dumps(event, separators=(",", ":")) + "\n")
    except Exception:
        pass  # Telemetry write fail; still emit the chat notice

    notices.append(f"[self-resolved] mode_migrate: {scope_name} mode {old_mode_repr} → {expected_mode}")

if notices:
    print("\n".join(notices))
PYEOF
)
fi

# Build the optional self-resolve injection block (only if anything resolved)
SELF_RESOLVE_BLOCK=""
if [ -n "$SELF_RESOLVE_NOTICES" ]; then
  SELF_RESOLVE_BLOCK=$'\n\n<self-resolve-log>\n'"${SELF_RESOLVE_NOTICES}"$'\n</self-resolve-log>'
fi

cat <<EOF
<<EXTREMELY_IMPORTANT>>
You have mega-sdd skills available. SDD context detected in CWD.

${ANCHOR_CONTENT}${WARN}${SELF_RESOLVE_BLOCK}
<</EXTREMELY_IMPORTANT>>
EOF
