#!/usr/bin/env bash
# SessionStart hook for mega-sdd plugin.
# Inject `using-mega-sdd` anchor skill content when SDD signals detected in CWD.

set -euo pipefail

# Drain stdin opportunistically — SessionStart spec provides JSON with session_id,
# source, transcript_path, hook_event_name. We capture session_id for the diagnostic.
STDIN_JSON=$(cat 2>/dev/null || echo '{}')

# ─── Source-aware anchor injection (M-13 token-efficiency B3) ────────────────
# The anchor is re-injected on EVERY SessionStart (startup|resume|clear|compact).
# resume: the reloaded transcript still contains a prior full injection → the
#   anchor is already in context; re-injecting is pure duplication. Skip it
#   (dynamic state notices below still fire).
# compact: compaction REPLACES context with a summary, so the anchor is gone —
#   but the harness re-lists every skill's frontmatter description (the keyword
#   census) and PreCompact wrote COMPACT_RESUME. Inject only the SLIM core
#   (Hard rule + Output language — the two things NOT in any description).
# startup|clear: fresh/empty context → inject the FULL routing core.
# Unparseable/absent source → FAIL OPEN to the full core (never break routing to
#   save tokens).
# v7 Fase 2 spawn diet: `source` and `session_id` are top-level fields of the
# HARNESS-shaped SessionStart payload (no user-controlled tool_input surface),
# so bash-builtin extraction is safe here — the two python forks this hook paid
# on EVERY session on EVERY CWD were pure spawn tax. Fail-open: no match →
# "unknown" (full core) / "unknown-session" (label only).
HOOK_SOURCE="unknown"
if [[ "$STDIN_JSON" =~ \"source\"[[:space:]]*:[[:space:]]*\"(startup|resume|clear|compact)\" ]]; then
  HOOK_SOURCE="${BASH_REMATCH[1]}"
fi
SESSION_ID_SS="unknown-session"
if [[ "$STDIN_JSON" =~ \"session_id\"[[:space:]]*:[[:space:]]*\"([^\"]+)\" ]]; then
  SESSION_ID_SS="${BASH_REMATCH[1]}"
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
ANCHOR_SKILL="${PLUGIN_ROOT}/skills/using-mega-sdd/SKILL.md"

# Detect SDD signals in CWD (purely heuristic, no false positives in casual sessions).
# Iter 67.5 (v3.48.0+): added `.mega-sdd` to the head of the list — canonical v3.4+ layout puts
# vaults/binding/codebase under `.mega-sdd/` not at cwd root. Without this entry, the anchor
# never injected for any v3.4+ project (audit 2026-05-27 §A1, silent regression since v3.4 ship).
cwd="$(pwd)"
has_sdd_signal=0

# ─── Resolve project root (Iter 71 — class-bug fix) ──────────────────────────
# Model may cd into a subfolder (e.g., .mega-sdd/knowledge-base/) during a chain
# step. Without walking up, ${cwd}/.mega-sdd/ → .mega-sdd/knowledge-base/.mega-sdd/
# (nested). resolve_project_root walks UP until it finds the outermost .mega-sdd/
# parent. Fallback: original cwd (greenfield).
RPR_HELPER="${SCRIPT_DIR}/../scripts/_lib/resolve-project-root.sh"
if [ -f "$RPR_HELPER" ]; then
  # shellcheck disable=SC1090
  . "$RPR_HELPER"
  project_root=$(resolve_project_root "$cwd")
else
  project_root="$cwd"
fi

# ─── DIAGNOSTIC LAYER (Iter 68 — verify harness invocation) ──────────────────
# Mirror of Stop-hook 67.5 diagnostic. Proves the harness is invoking SessionStart
# for this project CWD. Only writes when .mega-sdd/ exists (avoids polluting
# unrelated CWDs). If hook-debug.log lacks `"hook":"session-start"` lines after
# a fresh session in a mega-sdd project, the hook is NOT being invoked — that's
# an install/registration issue, not a hook bug.
#
# Honors --no-telemetry opt-out via <project_root>/.mega-sdd/config.yaml (same as Stop).
if [ -d "${project_root}/.mega-sdd" ]; then
  CONFIG_FILE="${project_root}/.mega-sdd/config.yaml"
  TELEMETRY_OFF=0
  if [ -f "$CONFIG_FILE" ] && grep -qE "^\s*telemetry:" "$CONFIG_FILE" 2>/dev/null; then
    if grep -qE "^\s*telemetry:\s*false" "$CONFIG_FILE" 2>/dev/null; then
      TELEMETRY_OFF=1
    fi
  elif [ "${CLAUDE_PLUGIN_OPTION_TELEMETRY:-}" = "false" ]; then
    TELEMETRY_OFF=1
  fi
  if [ "$TELEMETRY_OFF" -eq 0 ]; then
    TS=$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo "unknown-ts")
    SESSION_ID_DBG="$SESSION_ID_SS"  # bash-extracted above (v7 Fase 2 — no python fork)
    DEBUG_DIR="${project_root}/.mega-sdd/memory"
    mkdir -p "$DEBUG_DIR" 2>/dev/null || true
    echo "{\"ts\":\"$TS\",\"hook\":\"session-start\",\"session_id\":\"$SESSION_ID_DBG\",\"cwd\":\"$cwd\",\"project_root\":\"$project_root\",\"stdin_bytes\":${#STDIN_JSON}}" \
      >> "$DEBUG_DIR/hook-debug.log" 2>/dev/null || true
  fi
fi
for signal in ".mega-sdd" "docs/mega-sdd" "vaults" "bound-vault" "units" "binding.md" "codebase-map.md"; do
  if [ -e "${project_root}/${signal}" ]; then
    has_sdd_signal=1
    break
  fi
done

# ─── Bare /mega-sdd front-door wrapper auto-heal (v5.2.5, debounced v7 Fase 2) ─
# Claude Code registers plugin commands ONLY as /mega-sdd:<command>; the bare
# /mega-sdd verb the docs advertise can only exist as a STANDALONE user-level
# command (~/.claude/commands/mega-sdd.md). Runs BEFORE the SDD-signal early-exit
# so any session on any CWD heals the wrapper, fully guarded — a wrapper install
# failure must never break anchor injection.
# DEBOUNCE: the common case (wrapper present + current) is decided with bash
# builtins — zero forks. The script is spawned only when the wrapper is absent
# or carries an OLDER marker version. A marker-less existing file is
# user-authored: skipped here, exactly as the script's ownership rail would.
# The "v1" literal below MUST match WRAPPER_VERSION in install-front-door.sh —
# bump them together.
FD_TARGET="${HOME}/.claude/commands/mega-sdd.md"
if [ ! -f "$FD_TARGET" ]; then
  bash "${SCRIPT_DIR}/../scripts/install-front-door.sh" >/dev/null 2>&1 || true
else
  FD_CUR=""
  { FD_CUR="$(<"$FD_TARGET")"; } 2>/dev/null || FD_CUR=""
  case "$FD_CUR" in
    *"mega-sdd-front-door-wrapper v1"*) : ;;  # current — skip the spawn
    *"mega-sdd-front-door-wrapper"*)
      bash "${SCRIPT_DIR}/../scripts/install-front-door.sh" >/dev/null 2>&1 || true ;;
    *) : ;;  # user-authored file — never overwritten (ownership rail)
  esac
fi

# ─── No-signal CWD: governance marker ONLY (v7.0.0) ─────────────────────────
# The v5.2.6 mandatory-routing slim block is DELETED (gate-1 decision, spec
# 2026-08-21-v7-weighted-routing-design.md): the v7 default is tier S — a CWD
# without SDD signals gets ZERO injected routing text. What SURVIVES is the one
# bare `mega-sdd-trace:session` line: it is the office AI-gateway governance
# detection contract (v6.19.2 — the hard check keys on :session per NIP window;
# specs/2026-08-17-artifact-publisher-gateway.md §2), and going fully silent
# here would false-flag every non-SDD session under the warn→block policy. One
# token, no routing pressure. The old opt-out file/env
# (~/.claude/.mega-sdd-routing-off, MEGA_SDD_ROUTING) are obsolete: the routing
# block they silenced no longer exists, and the marker is governance-mandated.
if [ "$has_sdd_signal" -eq 0 ]; then
  echo "mega-sdd-trace:session"
  exit 0
fi

# Build context injection JSON for Claude Code SessionStart spec
if [ ! -f "$ANCHOR_SKILL" ]; then
  echo "WARN: anchor skill missing: $ANCHOR_SKILL" >&2
  exit 0
fi

# Inject only the routing CORE of the anchor, not the whole skill. The anchor is
# re-injected on every session AND every compaction; the pipeline map / phase
# tables / red-flags below the marker are loadable on demand (Skill tool), so the
# per-injection footprint is the routing-critical core only. Strip YAML frontmatter
# (its triggers are duplicated by the harness's own description load) and stop at
# the ANCHOR-CORE marker.
#
# M-13: what we inject depends on HOOK_SOURCE (computed above).
if [ "$HOOK_SOURCE" = "resume" ]; then
  # Anchor is already in the reloaded transcript — do not re-inject it.
  ANCHOR_CONTENT=""
elif [ "$HOOK_SOURCE" = "compact" ]; then
  # SLIM core: only the sections NOT reloadable from skill descriptions — the
  # Hard rule (STOP + invoke + the bind→units gate) and Output language — plus a
  # one-line pointer to load the rest on demand.
  ANCHOR_CONTENT="$(awk 'BEGIN{take=0}
    /^## Hard rule/{take=1}
    /ANCHOR-CORE ends/{exit}
    take==1{print}' "$ANCHOR_SKILL")"
  if [ -n "$ANCHOR_CONTENT" ]; then
    ANCHOR_CONTENT="Post-compaction routing anchor (slim). Full router: invoke the \`using-mega-sdd\` skill; the keyword census is in every mega-sdd skill's description."$'\n\n'"${ANCHOR_CONTENT}"
  fi
else
  # startup | clear | unknown (fail-open) → FULL routing core.
  ANCHOR_CONTENT="$(awk 'BEGIN{dash=0;body=0}
    /^---[[:space:]]*$/{dash++; if(dash==2)body=1; next}
    body==0{next}
    /ANCHOR-CORE ends/{exit}
    {print}' "$ANCHOR_SKILL")"
fi
# Fail-open: if the source-selected extraction yields nothing (frontmatter/marker
# drift on a NON-resume source), inject the full skill rather than nothing — never
# break routing to save tokens. (resume legitimately yields empty; leave it empty.)
if [ -z "$ANCHOR_CONTENT" ] && [ "$HOOK_SOURCE" != "resume" ]; then ANCHOR_CONTENT="$(cat "$ANCHOR_SKILL")"; fi

# Check superpowers presence
sp_cache="${HOME}/.claude/plugins/cache"
sp_present=0
if find "$sp_cache" -maxdepth 4 -type d -name "superpowers" 2>/dev/null | grep -q .; then
  sp_present=1
fi

WARN=""
if [ "$sp_present" -eq 0 ]; then
  WARN=$'\n\n<important-reminder>⚠️ Mega-SDD detected SDD work in CWD but the `superpowers` plugin is not installed. Bolts phase will use vendored fallback. For full features run: `/plugin install superpowers`</important-reminder>'
fi

# ─── Missing-interpreter notice (Windows alias-stub class, 2026-07-28) ───────
# python3 is a HARD runtime requirement of every mega-sdd hook, and until now it
# was declared nowhere and detected with `command -v` — which SUCCEEDS against the
# Windows App Execution Alias stub. A machine with no usable interpreter ran the
# whole pipeline with every gate silently unevaluated and no diagnostic anywhere.
# Surface it once, at session start, so the degradation is never silent again.
# Fork-free probe; never blocks.
PY_WARN=""
PY_LIB_SS="${SCRIPT_DIR}/../scripts/_lib/resolve-python.sh"
if [ -f "$PY_LIB_SS" ]; then
  # shellcheck disable=SC1090
  . "$PY_LIB_SS"
  if ! mega_sdd_python >/dev/null 2>&1; then
    PY_WARN=$'\n\n<important-reminder>⚠️ Mega-SDD: tidak ada interpreter python3 yang bisa dipakai di mesin ini. Keterangan: seluruh hook mega-sdd (gate binding→units, CONFLICT gate, quality gates, anti-self-bypass) mem-parse input lewat python3 — tanpa itu gate TIDAK dievaluasi dan hanya jatuh ke mode fail-closed. Di Windows penyebab tersering adalah App Execution Alias stub di %LOCALAPPDATA%\\Microsoft\\WindowsApps yang terbaca ada di PATH tapi bukan Python asli. Remedy: jalankan `/mega-sdd:install-deps` — di Windows pilih route scoop (`scoop install python`), satu-satunya yang menghasilkan perintah `python3` berfungsi (winget/python.org hanya memasang python.exe + py.exe, jadi `python3` tetap jatuh ke stub). Alternatif: matikan alias di Settings > Apps > Advanced app settings > App execution aliases lalu pasang Python.</important-reminder>'
    # ── EARLY EXIT, and it is load-bearing ──────────────────────────────────
    # Every stage below parses JSON/YAML through python3 inside command
    # substitutions. With no usable interpreter those substitutions exit
    # non-zero and `set -euo pipefail` (line 5) aborts this hook MID-WAY —
    # emitting NOTHING AT ALL, so the routing anchor itself is silently lost
    # and mega-sdd never announces it exists. (Observed on a Windows 11
    # corporate laptop 2026-07-28: session-start produced 0 bytes.)
    # Emit what is already computed and stop cleanly instead. This also skips
    # the wasted stub invocations, each of which is a process spawn.
    cat <<EOF
<<EXTREMELY_IMPORTANT>>
mega-sdd-trace:session
You have mega-sdd skills available. SDD context detected in CWD.

${ANCHOR_CONTENT}${WARN}${PY_WARN}
<</EXTREMELY_IMPORTANT>>
EOF
    exit 0
  fi
fi

# ─── C1 self-resolve battery: MOVED to scripts/ground.sh (v7 Fase 2) ─────────
# The 9-guard block (mode_migrate, partial_state_corrupt, routing_outcome_corrupt,
# verify_unit_writable, pack integrity ×3, model_tier_unknown dep_missing
# memory_in_use) + the telemetry.jsonl rotation now run at GROUND (M/L entry):
# session-start must never write vault artifacts (gate-1 mandate, spec
# 2026-08-21-v7-weighted-routing-design.md §7 backlog).

# ─── Living-vault staleness notice (advisory; spec 2026-06-10-living-vault) ──
# One line, counts only — ambient awareness that the code moved since the last
# scan. Signals: dirty-paths journal non-empty OR git HEAD ≠ the map's
# last_scanned_commit stamp. Never blocks; absent when clean.
#
# P1 (v4.93.0, decision 8): the signals come from the ONE probe engine —
# scripts/derive-state.sh → .mega-sdd/state.json (shared _lib/state_probes.py,
# the same library routing + validate-preflight read) — so this notice can
# never diverge from what routing sees. Gated behind the existing map-present
# condition (no new latency on non-SDD CWDs). Stale-plugin-cache tolerance:
# when derive-state.sh is absent or fails, the pre-P1 bash computation below
# runs unchanged (byte-identical notice strings).
STALENESS_NOTICE=""
LV_MAP="${project_root}/.mega-sdd/codebase/codebase-map.md"
# P2 (round F3 — the index leg was DEAD CODE behind a map-only gate):
# express-born projects have an index and no map; either substrate opens
# the staleness computation.
LV_IDX="${project_root}/.mega-sdd/codebase/symbol-index.json"
if { [ -f "$LV_MAP" ] || [ -f "$LV_IDX" ]; } && \
   ! grep -qE "^[[:space:]]*staleness_notice:[[:space:]]*false" "${project_root}/.mega-sdd/config.yaml" 2>/dev/null; then
  LV_FROM_DIGEST=0
  LV_DS="${SCRIPT_DIR}/../scripts/derive-state.sh"
  if [ -f "$LV_DS" ] && bash "$LV_DS" --cwd="$project_root" >/dev/null 2>&1 \
     && [ -f "${project_root}/.mega-sdd/state.json" ]; then
    # Build the SAME notice strings from the digest. Prints "CLEAN" when no
    # notice is due, the notice line otherwise; empty output = parse failure
    # → the bash fallback below engages.
    LV_OUT=$(STATE="${project_root}/.mega-sdd/state.json" python3 - 2>/dev/null <<'PYLV'
import json, os
try:
    s = json.load(open(os.environ["STATE"]))
    p = s["probes"]
except Exception:
    raise SystemExit(0)  # empty output -> bash fallback
dirty = p.get("dirty_journal_rows", 0)
cmap = p.get("codebase_map") or {}
stamp = cmap.get("last_scanned_commit")
head = (p.get("git") or {}).get("head")
# P2: express-born projects have no map — the symbol-index head_commit is
# their freshness stamp. SUBSTRATE RULE (round F4): the index leg counts
# ONLY when the map is absent — map-bearing projects key on the map (the
# index is rebuilt every execute-bolts batch and briefly-stale by design).
sidx = p.get("symbol_index") or {}
istamp = sidx.get("head_commit") if not cmap.get("present") else None
detail = "%d journaled write(s)" % dirty
if stamp and head and head != stamp:
    detail += "; map stamp %s ≠ HEAD %s" % (stamp[:8], head[:8])
if istamp and head and head != istamp:
    detail += "; index stamp %s ≠ HEAD %s" % (istamp[:8], head[:8])
moved = (dirty > 0 or bool(stamp and head and head != stamp)
         or bool(istamp and head and head != istamp))
open_n = 0
pending = ""
for v in p.get("vaults") or []:
    if v.get("layout") not in ("canonical", "legacy-docs"):
        continue  # parity with the pre-P1 glob set
    n = v.get("pending_sync_open", 0)
    if n > 0:
        open_n += n
        pending = "%s/PENDING-SYNC.md" % v.get("path", "")
if open_n > 0:
    line = ("mega-sdd: %d open sync decision(s) queued in %s — resolve the queue first."
            % (open_n, pending))
    if moved:
        line += (" Code also moved since last scan (%s)." % detail)
    print(line)
elif moved:
    # v7: notice-only wording — sync is OFFERED at the next M/L entry (front
    # door), never proposed from an ambient session-start line (gate-1 §4.3).
    print("mega-sdd: codebase moved since last scan (%s) — sync tersedia saat masuk lane M/L (`/mega-sdd`)."
          % detail)
else:
    print("CLEAN")
PYLV
)
    if [ -n "$LV_OUT" ]; then
      LV_FROM_DIGEST=1
      if [ "$LV_OUT" != "CLEAN" ]; then
        STALENESS_NOTICE=$'\n\n'"$LV_OUT"
      fi
    fi
  fi
  if [ "$LV_FROM_DIGEST" -eq 0 ]; then
  LV_JOURNAL="${project_root}/.mega-sdd/codebase/.dirty-paths.jsonl"
  LV_DIRTY=0
  if [ -s "$LV_JOURNAL" ]; then
    LV_DIRTY=$(grep -c . "$LV_JOURNAL" 2>/dev/null || echo 0)
  fi
  LV_STAMP=$(sed -n 's/^last_scanned_commit:[[:space:]]*//p' "$LV_MAP" 2>/dev/null | head -1)
  LV_HEAD=""
  if [ -n "$LV_STAMP" ] && command -v git >/dev/null 2>&1; then
    LV_HEAD=$(git -C "$project_root" rev-parse HEAD 2>/dev/null || true)
  fi
  LV_DETAIL="${LV_DIRTY} journaled write(s)"
  if [ -n "$LV_STAMP" ] && [ -n "$LV_HEAD" ] && [ "$LV_HEAD" != "$LV_STAMP" ]; then
    LV_DETAIL="${LV_DETAIL}; map stamp ${LV_STAMP:0:8} ≠ HEAD ${LV_HEAD:0:8}"
  fi
  # Deferred-decision queue (PENDING-SYNC.md): when open items exist, the
  # notice points at the queue FIRST (sync-digest contract) — a fresh sync
  # would just re-queue the same decisions.
  LV_OPEN=0
  LV_PENDING=""
  for lv_ps in "${project_root}/.mega-sdd/vaults"/*/PENDING-SYNC.md "${project_root}/docs/mega-sdd/vaults"/*/PENDING-SYNC.md; do
    [ -f "$lv_ps" ] || continue
    lv_n=$(grep -c '^- \[ \]' "$lv_ps" 2>/dev/null || echo 0)
    if [ "${lv_n:-0}" -gt 0 ]; then
      LV_OPEN=$((LV_OPEN + lv_n))
      LV_PENDING="${lv_ps#"${project_root}"/}"
    fi
  done
  LV_MOVED=0
  if [ "$LV_DIRTY" -gt 0 ] || { [ -n "$LV_STAMP" ] && [ -n "$LV_HEAD" ] && [ "$LV_HEAD" != "$LV_STAMP" ]; }; then
    LV_MOVED=1
  fi
  if [ "$LV_OPEN" -gt 0 ]; then
    STALENESS_NOTICE=$'\n\n'"mega-sdd: ${LV_OPEN} open sync decision(s) queued in ${LV_PENDING} — resolve the queue first."
    if [ "$LV_MOVED" -eq 1 ]; then
      STALENESS_NOTICE="${STALENESS_NOTICE} Code also moved since last scan (${LV_DETAIL})."
    fi
  elif [ "$LV_MOVED" -eq 1 ]; then
    # v7: notice-only wording (same contract as the digest leg above).
    STALENESS_NOTICE=$'\n\n'"mega-sdd: codebase moved since last scan (${LV_DETAIL}) — sync tersedia saat masuk lane M/L (\`/mega-sdd\`)."
  fi
  fi  # LV_FROM_DIGEST fallback (pre-P1 bash computation, unchanged)
fi

# ─── Resumed-after-compaction notice (ECC Batch 2) ──────────────────────────
# When a fresh compaction snapshot exists (PreCompact wrote it) and the source
# is a compact/resume, surface one line so the next window re-orients to the
# in-flight phase instead of re-deriving it. Advisory; shares telemetry opt-out.
COMPACT_RESUME=""
SNAP="${project_root}/.mega-sdd/.compaction-snapshot.json"
if [ -f "$SNAP" ]; then
  COMPACT_RESUME=$(SNAP="$SNAP" python3 -c '
import json, os
try:
    d = json.load(open(os.environ["SNAP"]))
except Exception:
    raise SystemExit(0)
ph = d.get("phase", {})
guess = ph.get("guess", "unknown")
ut, bd = ph.get("units_total", 0), ph.get("bolts_done", 0)
pend = d.get("pending_sync_open", 0)
extra = (" — %d open sync decision(s)" % pend) if pend else ""
print("mega-sdd: resumed after a compaction at phase [%s] — %d unit(s), %d bolt(s) done%s. Re-orient from .mega-sdd/.compaction-snapshot.json." % (guess, ut, bd, extra))
' 2>/dev/null)
  if [ -n "$COMPACT_RESUME" ]; then
    COMPACT_RESUME=$'\n\n'"${COMPACT_RESUME}"
  fi
fi

# ─── Instinct injection (continuous learning, ECC-adoption Batch 1) ─────────
# Bounded re-injection of confidence-scored learnings: top 6 with confidence
# ≥0.7, project scope before global, hard budget 1200 chars. Opt-out:
# `instincts: false` in .mega-sdd/config.yaml. Schema + lifecycle:
# skills/memory/references/instincts.md. Fail-open: any parse error = no block.
INSTINCT_BLOCK=""
# v7 Fase 2: spawn the python harvester only when an instincts dir exists at
# all (project or global) — the common no-instincts session paid a python fork
# for a guaranteed-empty result.
if { [ -d "${project_root}/.mega-sdd/memory/instincts" ] || [ -d "${HOME}/.mega-sdd/memory/instincts" ]; } \
   && ! grep -qE "^[[:space:]]*instincts:[[:space:]]*false" "${project_root}/.mega-sdd/config.yaml" 2>/dev/null; then
  INSTINCT_BLOCK=$(PROJ="$project_root" python3 - 2>/dev/null <<'PYINST'
import glob, os

proj = os.environ["PROJ"]
dirs = [
    (0, os.path.join(proj, ".mega-sdd", "memory", "instincts")),
    (1, os.path.join(os.path.expanduser("~"), ".mega-sdd", "memory", "instincts")),
]
cands = []
for rank, d in dirs:
    for p in sorted(glob.glob(os.path.join(d, "*.yaml"))):
        kv = {}
        try:
            for line in open(p, encoding="utf-8", errors="replace"):
                if ":" in line and not line.startswith((" ", "\t", "-", "#")):
                    k, _, v = line.partition(":")
                    kv[k.strip()] = v.strip().strip("'\"")
        except OSError:
            continue
        try:
            conf = float(kv.get("confidence", "0"))
        except ValueError:
            continue
        if kv.get("status", "active") != "active" or conf < 0.7:
            continue
        trig, act = kv.get("trigger", ""), kv.get("action", "")
        if trig and act:
            cands.append((rank, -conf, "- [%.1f|%s] WHEN %s -> %s" % (conf, kv.get("domain", "general"), trig, act)))
cands.sort()
out, total = [], 0
for _, _, line in cands[:6]:
    if total + len(line) > 1200:
        break
    out.append(line)
    total += len(line)
print("\n".join(out))
PYINST
)
  if [ -n "$INSTINCT_BLOCK" ]; then
    INSTINCT_BLOCK=$'\n\n<learned-instincts>\n'"Learned instincts (confidence-scored from this project + global memory — apply unless the user, spec, or a Hard rule says otherwise):"$'\n'"${INSTINCT_BLOCK}"$'\n</learned-instincts>'
  fi
fi

# NOTE: ${PY_WARN} is empty on every path that reaches here — the branch that sets
# it exits early (see the missing-interpreter block above). Interpolated anyway so
# the notice still renders if that early exit is ever made conditional.
cat <<EOF
<<EXTREMELY_IMPORTANT>>
mega-sdd-trace:session
You have mega-sdd skills available. SDD context detected in CWD.

${ANCHOR_CONTENT}${WARN}${PY_WARN}${STALENESS_NOTICE}${COMPACT_RESUME}${INSTINCT_BLOCK}
<</EXTREMELY_IMPORTANT>>
EOF
