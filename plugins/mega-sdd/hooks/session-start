#!/usr/bin/env bash
# SessionStart hook for mega-sdd plugin.
# Inject `using-mega-sdd` anchor skill content when SDD signals detected in CWD.

set -euo pipefail

# Drain stdin opportunistically — SessionStart spec provides JSON with session_id,
# source, transcript_path, hook_event_name. We capture session_id for the diagnostic.
STDIN_JSON=$(cat 2>/dev/null || echo '{}')

# ─── Source-aware anchor injection (M-13 token-efficiency B3) ────────────────
# The anchor is re-injected on EVERY SessionStart (startup|resume|clear|compact).
# resume: the reloaded transcript still contains a prior full injection → the
#   anchor is already in context; re-injecting is pure duplication. Skip it
#   (dynamic state notices below still fire).
# compact: compaction REPLACES context with a summary, so the anchor is gone —
#   but the harness re-lists every skill's frontmatter description (the keyword
#   census) and PreCompact wrote COMPACT_RESUME. Inject only the SLIM core
#   (Hard rule + Output language — the two things NOT in any description).
# startup|clear: fresh/empty context → inject the FULL routing core.
# Unparseable/absent source → FAIL OPEN to the full core (never break routing to
#   save tokens).
HOOK_SOURCE=$(printf '%s' "$STDIN_JSON" | python3 -c '
import json, sys
try:
    s = json.loads(sys.stdin.read()).get("source", "")
    print(s if s in ("startup", "resume", "clear", "compact") else "unknown")
except Exception:
    print("unknown")
' 2>/dev/null || echo "unknown")

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
ANCHOR_SKILL="${PLUGIN_ROOT}/skills/using-mega-sdd/SKILL.md"

# Detect SDD signals in CWD (purely heuristic, no false positives in casual sessions).
# Iter 67.5 (v3.48.0+): added `.mega-sdd` to the head of the list — canonical v3.4+ layout puts
# vaults/binding/codebase under `.mega-sdd/` not at cwd root. Without this entry, the anchor
# never injected for any v3.4+ project (audit 2026-05-27 §A1, silent regression since v3.4 ship).
cwd="$(pwd)"
has_sdd_signal=0

# ─── Resolve project root (Iter 71 — class-bug fix) ──────────────────────────
# Model may cd into a subfolder (e.g., .mega-sdd/knowledge-base/) during a chain
# step. Without walking up, ${cwd}/.mega-sdd/ → .mega-sdd/knowledge-base/.mega-sdd/
# (nested). resolve_project_root walks UP until it finds the outermost .mega-sdd/
# parent. Fallback: original cwd (greenfield).
RPR_HELPER="${SCRIPT_DIR}/../scripts/_lib/resolve-project-root.sh"
if [ -f "$RPR_HELPER" ]; then
  # shellcheck disable=SC1090
  . "$RPR_HELPER"
  project_root=$(resolve_project_root "$cwd")
else
  project_root="$cwd"
fi

# ─── DIAGNOSTIC LAYER (Iter 68 — verify harness invocation) ──────────────────
# Mirror of Stop-hook 67.5 diagnostic. Proves the harness is invoking SessionStart
# for this project CWD. Only writes when .mega-sdd/ exists (avoids polluting
# unrelated CWDs). If hook-debug.log lacks `"hook":"session-start"` lines after
# a fresh session in a mega-sdd project, the hook is NOT being invoked — that's
# an install/registration issue, not a hook bug.
#
# Honors --no-telemetry opt-out via <project_root>/.mega-sdd/config.yaml (same as Stop).
if [ -d "${project_root}/.mega-sdd" ]; then
  CONFIG_FILE="${project_root}/.mega-sdd/config.yaml"
  TELEMETRY_OFF=0
  if [ -f "$CONFIG_FILE" ]; then
    if grep -qE "^\s*telemetry:\s*false" "$CONFIG_FILE" 2>/dev/null; then
      TELEMETRY_OFF=1
    fi
  fi
  if [ "$TELEMETRY_OFF" -eq 0 ]; then
    TS=$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo "unknown-ts")
    SESSION_ID_DBG=$(printf '%s' "$STDIN_JSON" | python3 -c '
import json, sys
try:
    print(json.loads(sys.stdin.read()).get("session_id", "unknown-session"))
except Exception:
    print("unknown-session")
' 2>/dev/null || echo "unknown-session")
    DEBUG_DIR="${project_root}/.mega-sdd/memory"
    mkdir -p "$DEBUG_DIR" 2>/dev/null || true
    echo "{\"ts\":\"$TS\",\"hook\":\"session-start\",\"session_id\":\"$SESSION_ID_DBG\",\"cwd\":\"$cwd\",\"project_root\":\"$project_root\",\"stdin_bytes\":${#STDIN_JSON}}" \
      >> "$DEBUG_DIR/hook-debug.log" 2>/dev/null || true
  fi
fi
for signal in ".mega-sdd" "docs/mega-sdd" "vaults" "bound-vault" "units" "binding.md" "codebase-map.md"; do
  if [ -e "${project_root}/${signal}" ]; then
    has_sdd_signal=1
    break
  fi
done

# ─── Bare /mega-sdd front-door wrapper auto-heal (v5.2.5) ────────────────────
# Claude Code registers plugin commands ONLY as /mega-sdd:<command>; the bare
# /mega-sdd verb the docs advertise can only exist as a STANDALONE user-level
# command (~/.claude/commands/mega-sdd.md). Ship it here: idempotent
# (version-marker check inside the script), runs BEFORE the SDD-signal early-exit
# so any session on any CWD heals the wrapper, and is fully guarded — a wrapper
# install failure must never break anchor injection.
bash "${SCRIPT_DIR}/../scripts/install-front-door.sh" >/dev/null 2>&1 || true

# If no signals, skip injection
if [ "$has_sdd_signal" -eq 0 ]; then
  exit 0
fi

# Build context injection JSON for Claude Code SessionStart spec
if [ ! -f "$ANCHOR_SKILL" ]; then
  echo "WARN: anchor skill missing: $ANCHOR_SKILL" >&2
  exit 0
fi

# Inject only the routing CORE of the anchor, not the whole skill. The anchor is
# re-injected on every session AND every compaction; the pipeline map / phase
# tables / red-flags below the marker are loadable on demand (Skill tool), so the
# per-injection footprint is the routing-critical core only. Strip YAML frontmatter
# (its triggers are duplicated by the harness's own description load) and stop at
# the ANCHOR-CORE marker.
#
# M-13: what we inject depends on HOOK_SOURCE (computed above).
if [ "$HOOK_SOURCE" = "resume" ]; then
  # Anchor is already in the reloaded transcript — do not re-inject it.
  ANCHOR_CONTENT=""
elif [ "$HOOK_SOURCE" = "compact" ]; then
  # SLIM core: only the sections NOT reloadable from skill descriptions — the
  # Hard rule (STOP + invoke + the bind→units gate) and Output language — plus a
  # one-line pointer to load the rest on demand.
  ANCHOR_CONTENT="$(awk 'BEGIN{take=0}
    /^## Hard rule/{take=1}
    /ANCHOR-CORE ends/{exit}
    take==1{print}' "$ANCHOR_SKILL")"
  if [ -n "$ANCHOR_CONTENT" ]; then
    ANCHOR_CONTENT="Post-compaction routing anchor (slim). Full router: invoke the \`using-mega-sdd\` skill; the keyword census is in every mega-sdd skill's description."$'\n\n'"${ANCHOR_CONTENT}"
  fi
else
  # startup | clear | unknown (fail-open) → FULL routing core.
  ANCHOR_CONTENT="$(awk 'BEGIN{dash=0;body=0}
    /^---[[:space:]]*$/{dash++; if(dash==2)body=1; next}
    body==0{next}
    /ANCHOR-CORE ends/{exit}
    {print}' "$ANCHOR_SKILL")"
fi
# Fail-open: if the source-selected extraction yields nothing (frontmatter/marker
# drift on a NON-resume source), inject the full skill rather than nothing — never
# break routing to save tokens. (resume legitimately yields empty; leave it empty.)
if [ -z "$ANCHOR_CONTENT" ] && [ "$HOOK_SOURCE" != "resume" ]; then ANCHOR_CONTENT="$(cat "$ANCHOR_SKILL")"; fi

# Check superpowers presence
sp_cache="${HOME}/.claude/plugins/cache"
sp_present=0
if find "$sp_cache" -maxdepth 4 -type d -name "superpowers" 2>/dev/null | grep -q .; then
  sp_present=1
fi

WARN=""
if [ "$sp_present" -eq 0 ]; then
  WARN=$'\n\n<important-reminder>⚠️ Mega-SDD detected SDD work in CWD but the `superpowers` plugin is not installed. Bolts phase will use vendored fallback. For full features run: `/plugin install superpowers`</important-reminder>'
fi

# ─── C1 self-resolve: mode_migrate (Iter 67.7.1 hook-layer enforcement) ─────
# Gate B response (reviewer 2026-05-27): C1 protocol shipped as prose has
# audit-failed 4×. Hook-layer enforcement deterministically detects + fixes
# the mode_migrate precondition before any chain starts.
#
# Detects: any active <cwd>/.mega-sdd/vaults/*/vault.json (excluding .archived/)
# where `mode` field is missing OR mismatches CWD signals.
# CWD signals → mode mapping (deterministic; no fabrication):
#   any of {.git, composer.json, package.json, Gemfile, Cargo.toml, go.mod,
#           build.gradle, pom.xml, requirements.txt, pyproject.toml} present
#     → expected_mode = "existing"
#   none present → expected_mode = "greenfield"
# Honors opt-out: <cwd>/.mega-sdd/config.yaml `telemetry: false` (treats this
# guard as part of telemetry surface; user opting out of telemetry also opts
# out of auto-fix to avoid stealth mutations).

SELF_RESOLVE_NOTICES=""
CONFIG_FILE="${cwd}/.mega-sdd/config.yaml"
GUARD_ENABLED=1
if [ -f "$CONFIG_FILE" ]; then
  if grep -qE "^\s*telemetry:\s*false" "$CONFIG_FILE" 2>/dev/null; then
    GUARD_ENABLED=0
  fi
fi

if [ "$GUARD_ENABLED" -eq 1 ] && [ -d "${cwd}/.mega-sdd" ]; then
  TELEMETRY_FILE="${cwd}/.mega-sdd/memory/telemetry.jsonl"
  mkdir -p "$(dirname "$TELEMETRY_FILE")" 2>/dev/null || true

  # Run C1 self-resolve guards via python (deterministic detection + fix).
  # Iter 67.7.1: mode_migrate.  Iter 67.7.2 (v3.51.1+): adds partial_state_corrupt.
  SELF_RESOLVE_NOTICES=$(CWD="$cwd" TELEMETRY_FILE="$TELEMETRY_FILE" python3 <<'PYEOF' 2>/dev/null
import json
import os
import sys
import glob
from datetime import datetime, timezone

cwd = os.environ["CWD"]
telemetry_file = os.environ["TELEMETRY_FILE"]
ts = datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")
session_id = os.environ.get("CLAUDE_SESSION_ID", "session-start-hook")  # not a documented hook env var; label-only fallback (stdin session_id is the real source if ever needed)
notices = []

def emit_event(halt_type, fix_applied, **payload_extras):
    event = {
        "ts": ts,
        "skill": "session-start",
        "event_type": "halt_self_resolved",
        "session_id": session_id,
        "hook_source": "SessionStart",
        "payload": {
            "halt_type": halt_type,
            "fix_applied": fix_applied,
            "original_emit_site": "SessionStart-hook-c1-guard",
            "logged_at_chat": True,
            **payload_extras,
        },
    }
    try:
        with open(telemetry_file, "a") as f:
            f.write(json.dumps(event, separators=(",", ":")) + "\n")
    except Exception:
        pass  # telemetry write fail; chat notice still records the resolve

# ─── Guard 1: mode_migrate (vault.json mode vs CWD signals) ─────────────────
signals = [
    ".git", "composer.json", "package.json", "Gemfile", "Cargo.toml",
    "go.mod", "build.gradle", "pom.xml", "requirements.txt", "pyproject.toml",
]
detected_signals = [s for s in signals if os.path.exists(os.path.join(cwd, s))]
expected_mode = "existing" if detected_signals else "greenfield"

vault_jsons = []
for f in sorted(glob.glob(os.path.join(cwd, ".mega-sdd", "vaults", "*", "vault.json"))):
    if "/.archived/" in f or "/.archived\\" in f:
        continue
    vault_jsons.append(f)

for vj in vault_jsons:
    try:
        with open(vj) as f:
            data = json.load(f)
    except Exception:
        continue  # corrupted vault.json — separate halt class (future slice)
    current_mode = data.get("mode")
    if current_mode == expected_mode:
        continue
    old_mode_repr = current_mode if current_mode is not None else "(missing)"
    data["mode"] = expected_mode
    try:
        with open(vj, "w") as f:
            json.dump(data, f, indent=2)
            f.write("\n")
    except Exception:
        continue
    rel_vj = os.path.relpath(vj, cwd)
    scope_name = os.path.basename(os.path.dirname(vj))
    emit_event(
        "mode_migrate",
        f"vault.json mode {old_mode_repr} → {expected_mode}",
        scope=scope_name,
        detected_signals=detected_signals,
        vault_json_path=rel_vj,
    )
    notices.append(f"[self-resolved] mode_migrate: {scope_name} mode {old_mode_repr} → {expected_mode}")

# ─── Guard 2: partial_state_corrupt (Iter 67.7.2 — v3.51.1+) ───────────────
# Scan <cwd>/.mega-sdd/vaults/*-bound/bolts/U-*/partial-state.json
# If file fails JSON parse → rename to partial-state.json.corrupt-<ISO8601>
# (forensics preserved; --resume restarts fresh per plugins/mega-sdd/references/halt-protocol.md).
# NEVER halts. Honors same opt-out as mode_migrate (handled by GUARD_ENABLED above).
ts_fname = ts.replace(":", "-").replace(".", "-")  # filename-safe ISO8601
for f in sorted(glob.glob(os.path.join(cwd, ".mega-sdd", "vaults", "*-bound", "bolts", "U-*", "partial-state.json"))):
    if "/.archived/" in f or "/.archived\\" in f:
        continue
    try:
        with open(f) as fh:
            json.load(fh)
        # Parsed cleanly; no action
        continue
    except json.JSONDecodeError:
        # Corrupted — rename and emit
        corrupt_path = f"{f}.corrupt-{ts_fname}"
        try:
            os.rename(f, corrupt_path)
        except Exception:
            continue  # rename failed; don't claim resolve
        rel_orig = os.path.relpath(f, cwd)
        rel_corrupt = os.path.relpath(corrupt_path, cwd)
        unit_id = os.path.basename(os.path.dirname(f))  # U-XXX from path
        emit_event(
            "partial_state_corrupt",
            f"renamed → {os.path.basename(corrupt_path)}; --resume will restart fresh",
            unit_id=unit_id,
            original_path=rel_orig,
            corrupt_path=rel_corrupt,
        )
        notices.append(f"[self-resolved] partial_state_corrupt: {unit_id} renamed (JSON parse fail); --resume will restart fresh")
    except Exception:
        # Non-JSONDecodeError (file system error, encoding etc.) → skip; not a clean self-resolve
        continue

# ─── Guard 3: routing_outcome_corrupt (Iter 67.7.3 — v3.52.0+) ─────────────
# Scan <cwd>/.mega-sdd/memory/routing-outcomes.md
# Format: markdown with `# Routing Outcomes` header + table-style entries.
# Corruption detection (conservative):
#   - File exists, non-empty, but not valid UTF-8 → corrupt
#   - File exists, non-empty, but missing expected header in first 200 chars → corrupt
# Empty file = initialization state, NOT corrupt (skip).
# On corruption: rename to routing-outcomes.md.corrupt-<ISO8601>; chain proceeds
# with default routing (no replacement file created; memory subsystem will rebuild
# on next end-of-chain write).
ROUTING_FILE = os.path.join(cwd, ".mega-sdd", "memory", "routing-outcomes.md")
if os.path.isfile(ROUTING_FILE):
    try:
        with open(ROUTING_FILE, "rb") as fh:
            raw = fh.read()
    except Exception:
        raw = None
    if raw is not None and len(raw) > 0:
        try:
            content = raw.decode("utf-8")
            header_ok = "Routing Outcomes" in content[:200]
        except UnicodeDecodeError:
            content = None
            header_ok = False
        if content is None or not header_ok:
            corrupt_path = f"{ROUTING_FILE}.corrupt-{ts_fname}"
            try:
                os.rename(ROUTING_FILE, corrupt_path)
                rel_orig = os.path.relpath(ROUTING_FILE, cwd)
                rel_corrupt = os.path.relpath(corrupt_path, cwd)
                reason = "non-utf8-binary" if content is None else "missing_schema_header"
                emit_event(
                    "routing_outcome_corrupt",
                    f"renamed → {os.path.basename(corrupt_path)}; default routing used; memory rebuilds next end-of-chain",
                    original_path=rel_orig,
                    corrupt_path=rel_corrupt,
                    corruption_reason=reason,
                )
                notices.append(f"[self-resolved] routing_outcome_corrupt: routing-outcomes.md renamed ({reason}); default routing used")
            except Exception:
                pass  # rename failed; don't claim resolve

# ─── Guard 4: verify_unit_writable (Iter 67.7.4 — v3.52.0+) ────────────────
# Scan units for task_type=verify with non-empty target_files (forbidden per
# attestation reclassification: verify units MUST be read-only). DETECTION-ONLY:
# emit warning telemetry + chat notice; DO NOT modify on-disk unit (preserves
# bad spec for human review). Dispatch-time auto-clear is execute-bolts's job
# (separate concern).
#
# Two layouts (per Iter 67.6.1 validator pattern):
#   Layout A (phase-2):  <vault>/*-bound/units/U-*.md
#   Layout B (phase-1):  <vault>/*-bound/units/U-*/unit.md
import re as _re

FRONTMATTER_RE_VW = _re.compile(r"^---\n(.*?)\n---", _re.DOTALL)
unit_paths_vw = sorted(
    glob.glob(os.path.join(cwd, ".mega-sdd", "vaults", "*-bound", "units", "U-*.md")) +
    glob.glob(os.path.join(cwd, ".mega-sdd", "vaults", "*-bound", "units", "U-*", "unit.md"))
)
for up in unit_paths_vw:
    if "/.archived/" in up or "/.archived\\" in up:
        continue
    try:
        body = open(up).read()
    except Exception:
        continue
    m = FRONTMATTER_RE_VW.match(body)
    if not m:
        continue
    fm = m.group(1)
    # Quick task_type extraction
    tt_match = _re.search(r"^task_type:\s*(\w+)", fm, _re.MULTILINE)
    if not tt_match or tt_match.group(1) != "verify":
        continue
    # Line-based target_files block extraction (regex with nested groups is unreliable
    # for YAML lists with mixed indent — see Iter 67.7.x debug). The block is
    # everything from `target_files:` up to the next top-level YAML key or end of fm.
    fm_lines = fm.split("\n")
    in_block = False
    block_lines = []
    for ln in fm_lines:
        if ln.startswith("target_files:"):
            in_block = True
            continue
        if in_block:
            if ln and ln[0] not in " \t":
                break  # next top-level key
            block_lines.append(ln)
    block_text = "\n".join(block_lines)
    if not block_text.strip():
        continue
    forbidden_ops = _re.findall(r"operation:\s*(create|modify|delete)", block_text)
    if not forbidden_ops:
        continue
    # Violation: verify unit with writable target_files
    rel_up = os.path.relpath(up, cwd)
    # Layout A uses unit_id:, Layout B uses id: — accept both
    unit_id_match = _re.search(r"^(?:unit_id|id):\s*(\S+)", fm, _re.MULTILINE)
    if unit_id_match:
        unit_id = unit_id_match.group(1)
    elif os.path.basename(up) == "unit.md":
        # Layout B fallback: dir name (e.g., U-002-some-name)
        unit_id = os.path.basename(os.path.dirname(up))
    else:
        unit_id = os.path.basename(up).replace(".md", "")
    emit_event(
        "verify_unit_writable",
        f"detected at SessionStart; on-disk unit preserved for review; execute-bolts will auto-clear at dispatch time",
        unit_id=unit_id,
        unit_path=rel_up,
        forbidden_operations=forbidden_ops,
    )
    notices.append(f"[self-resolved] verify_unit_writable: {unit_id} has task_type=verify + writable target_files (review needed; dispatch will auto-clear)")

# ─── Guard 5: framework_pack_unparseable (B.7) + framework_pack_cycle (B.8) ─
# + framework_pack_missing (B.10) — combined pack-integrity scan.
# Pack files live under <cwd>/.mega-sdd/codebase/framework-conventions/*.md
# OR referenced from binding docs / starterkit-context.yaml.
# Walking-skeleton scope:
#   - Find all *.md files under framework-conventions/
#   - For each: try to read; check for `extends:` field that points to other pack
#   - Build inheritance graph; detect cycles
#   - Detect references in binding/starterkit-context.yaml pointing to missing packs
pack_dir_candidates = [
    os.path.join(cwd, ".mega-sdd", "codebase", "framework-conventions"),
    os.path.join(cwd, ".mega-sdd", "codebase", "packs"),
]
pack_dir = next((d for d in pack_dir_candidates if os.path.isdir(d)), None)
pack_files = {}  # basename → path
pack_extends = {}  # basename → list of extended basenames

if pack_dir:
    for pf in sorted(glob.glob(os.path.join(pack_dir, "*.md"))):
        base = os.path.basename(pf).replace(".md", "")
        pack_files[base] = pf
        # Try to parse — detect unparseable + extends references
        try:
            content = open(pf, encoding="utf-8").read()
        except Exception:
            emit_event(
                "framework_pack_unparseable",
                f"pack {base} could not be read as UTF-8 text",
                pack_name=base,
                pack_path=os.path.relpath(pf, cwd),
                reason="non-utf8 or read error",
            )
            notices.append(f"[self-resolved] framework_pack_unparseable: {base} unreadable; skipping pack")
            continue
        # Look for extends: field in YAML frontmatter
        fm_match = _re.match(r"^---\n(.*?)\n---", content, _re.DOTALL) if "_re" in dir() else None
        if not fm_match:
            import re as _re2
            fm_match = _re2.match(r"^---\n(.*?)\n---", content, _re2.DOTALL)
        if fm_match:
            fm = fm_match.group(1)
            import re as _re3
            ext_match = _re3.search(r"^extends:\s*\[?([^\]\n]+)\]?", fm, _re3.MULTILINE)
            if ext_match:
                ext_value = ext_match.group(1).strip().strip("'\"")
                # Could be list "[A, B]" or single "A"
                ext_list = [e.strip().strip("'\"") for e in ext_value.split(",") if e.strip()]
                pack_extends[base] = ext_list

    # Detect cycles via DFS
    import re as _re4
    visited = set()
    rec_stack = set()

    def find_cycle(node, path):
        if node in rec_stack:
            return path + [node]
        if node in visited:
            return None
        visited.add(node)
        rec_stack.add(node)
        for nxt in pack_extends.get(node, []):
            cyc = find_cycle(nxt, path + [node])
            if cyc:
                return cyc
        rec_stack.remove(node)
        return None

    cycles_reported = set()
    for base in pack_files:
        cyc = find_cycle(base, [])
        if cyc:
            cyc_key = tuple(sorted(set(cyc)))
            if cyc_key in cycles_reported:
                continue
            cycles_reported.add(cyc_key)
            emit_event(
                "framework_pack_cycle",
                f"pack inheritance cycle detected: {' → '.join(cyc)}",
                cycle_path=cyc,
                break_at=cyc[-2] if len(cyc) >= 2 else cyc[0],
            )
            notices.append(f"[self-resolved] framework_pack_cycle: cycle {' → '.join(cyc[:3])}... breaking at most-derived edge")

    # Detect missing pack references (referenced in extends but file not found)
    for base, ext_list in pack_extends.items():
        for ext in ext_list:
            if ext not in pack_files:
                emit_event(
                    "framework_pack_missing",
                    f"pack {base} extends nonexistent pack {ext}",
                    referencing_pack=base,
                    missing_pack=ext,
                )
                notices.append(f"[self-resolved] framework_pack_missing: {base} extends missing {ext}; dropping reference")

# ─── Guard 6: dep_missing (B.11 — non-interactive only) ────────────────────
# Check required binaries on PATH. Per reviewer 2026-05-27 refinement R2:
# DETECTION only at SessionStart. Auto-install is NOT performed here (would
# risk hanging on sudo/network). Emit warning telemetry + chat notice.
# install-deps subsystem invocation is left to explicit user action.
import shutil as _shutil
required_bins = ["tree-sitter", "ast-grep"]  # optional but useful
missing_bins = [b for b in required_bins if _shutil.which(b) is None]
if missing_bins:
    emit_event(
        "dep_missing",
        f"required binaries missing on PATH (advisory): {missing_bins}",
        missing_binaries=missing_bins,
        suggested_action="run /mega-sdd:install-deps (non-interactive only; manual install if needed)",
        will_degrade_to="regex tier (scan-codebase) / v1 grammar (execute-bolts)",
    )
    notices.append(f"[self-resolved] dep_missing: {missing_bins} not on PATH; will degrade gracefully")

# ─── Guard 7: deep_scan_cache_corrupt (B.9) ────────────────────────────────
# Check <cwd>/.mega-sdd/codebase/starterkit-context.yaml — if exists, validate
# it as parseable YAML (or at least structured key:value pairs). If corrupt,
# rename and let scan-codebase re-build on next invocation.
import re as _re5
starterkit_path = os.path.join(cwd, ".mega-sdd", "codebase", "starterkit-context.yaml")
if os.path.isfile(starterkit_path):
    try:
        with open(starterkit_path, "rb") as f:
            raw = f.read()
        try:
            content = raw.decode("utf-8")
            # Heuristic: must have at least one top-level key: value or comment
            if not raw or not _re5.search(r"^[a-zA-Z_][\w-]*:", content, _re5.MULTILINE):
                raise ValueError("no top-level YAML keys found")
        except (UnicodeDecodeError, ValueError) as e:
            corrupt_path = f"{starterkit_path}.corrupt-{ts_fname}"
            os.rename(starterkit_path, corrupt_path)
            rel_orig = os.path.relpath(starterkit_path, cwd)
            rel_corrupt = os.path.relpath(corrupt_path, cwd)
            emit_event(
                "deep_scan_cache_corrupt",
                f"starterkit-context.yaml unparseable; renamed → {os.path.basename(corrupt_path)}; next scan-codebase rebuilds",
                original_path=rel_orig,
                corrupt_path=rel_corrupt,
                reason=str(e),
            )
            notices.append(f"[self-resolved] deep_scan_cache_corrupt: starterkit-context.yaml renamed; scan-codebase will rebuild")
    except Exception:
        pass

# ─── Guard 8: model_tier_unknown (edge-case track — SessionStart config pre-validation) ─
# Reframe of Phase A flagged slice 5. Original was mid-chain orchestrate-flow Step 2.8.f
# (no SessionStart surface). Reframe: pre-validate user/project model-tier config files
# against canonical catalog AT SESSION START. Catches misconfigs before they fire mid-chain.
import re as _re_mt

mt_catalog_path = None
# Catalog ships in plugin source; find via SCRIPT_DIR → plugin root
# PLUGIN_ROOT_HINT is unreliable; derive from known hook location instead.
import pathlib as _pathlib_mt
_hook_dir = _pathlib_mt.Path(__file__).resolve().parent if "__file__" in dir() else None
_plugin_root_derived = str(_hook_dir.parent) if _hook_dir else ""
plugin_root_env = os.environ.get("PLUGIN_ROOT_HINT", "") or _plugin_root_derived
catalog_candidates = [
    os.path.join(plugin_root_env, "references", "model-tiers.md") if plugin_root_env else None,
]
# Fallback: walk cache directory, picking the LATEST version by SemVer (NOT a
# lexical string sort — "4.9.0" > "4.36.0" lexically; mirrors scripts/resolve-plugin-root.sh).
import glob as _glob_mt
def _semver_key_mt(_p):
    try:
        _ver = _p.split("/mega-sdd/mega-sdd/")[1].split("/")[0]
        return [int(_x) for _x in _ver.split(".")]
    except Exception:
        return [-1]
for cached in sorted(_glob_mt.glob(os.path.expanduser(
        "~/.claude/plugins/cache/mega-sdd/mega-sdd/*/references/model-tiers.md")), key=_semver_key_mt, reverse=True):
    catalog_candidates.append(cached)
    break  # newest version first
for c in catalog_candidates:
    if c and os.path.isfile(c):
        mt_catalog_path = c
        break

if mt_catalog_path:
    try:
        catalog_content = open(mt_catalog_path).read()
        catalog_roles = set(_re_mt.findall(r"^\|\s*([\w-]+)\s*\|", catalog_content, _re_mt.MULTILINE))
    except Exception:
        catalog_roles = set()

    config_paths = [
        os.path.join(cwd, ".mega-sdd", "config.yaml"),
    ]
    user_pref = os.path.expanduser("~/.mega-sdd/memory/preferences.md")
    if os.path.isfile(user_pref):
        config_paths.append(user_pref)

    for cp in config_paths:
        if not os.path.isfile(cp):
            continue
        try:
            cfg_text = open(cp).read()
        except Exception:
            continue
        # Look for model_tiers: block or preferences.md ## Model tiers section
        # Extract `- role: tier` or `role: tier` lines
        in_block = False
        for ln in cfg_text.split("\n"):
            if _re_mt.match(r"^\s*model_tiers:\s*$", ln) or _re_mt.match(r"^##\s+Model\s+tiers", ln, _re_mt.IGNORECASE):
                in_block = True
                continue
            if in_block:
                # End block on next top-level key or heading
                if _re_mt.match(r"^\w", ln) or _re_mt.match(r"^##\s", ln):
                    in_block = False
                    continue
                # Try to match role: tier (with or without leading - )
                m = _re_mt.match(r"^\s*-?\s*([\w-]+):\s*(\w+)", ln)
                if m:
                    role = m.group(1)
                    tier = m.group(2)
                    if role in ("model_tiers", "preferences"):
                        continue
                    if catalog_roles and role not in catalog_roles:
                        emit_event(
                            "model_tier_unknown",
                            f"override role '{role}' not in catalog ({len(catalog_roles)} known roles); chain will use catalog default",
                            unknown_role=role,
                            override_tier=tier,
                            override_source=os.path.relpath(cp, cwd) if cp.startswith(cwd) else cp,
                        )
                        notices.append(f"[self-resolved] model_tier_unknown: role '{role}' unknown; chain uses catalog default")

# ─── Guard 9: memory_in_use (edge-case track — SessionStart stale-lock cleanup) ──
# Reframe of Phase A flagged slice 6. Original was memory-write file-lock retry inside
# skill body (no SessionStart surface). Reframe: pre-emptive scan for stale lock files
# AT SESSION START. Removes locks older than 60 seconds (likely from crashed/orphaned
# writers). Reduces frequency of lock collisions at runtime.
import time as _time_mil
memory_dir = os.path.join(cwd, ".mega-sdd", "memory")
if os.path.isdir(memory_dir):
    stale_threshold_sec = 60
    now = _time_mil.time()
    for lock_pattern in ["*.lock", "*.lck", ".lock-*"]:
        for lock_file in glob.glob(os.path.join(memory_dir, lock_pattern)):
            try:
                age = now - os.path.getmtime(lock_file)
                if age > stale_threshold_sec:
                    os.remove(lock_file)
                    rel_lock = os.path.relpath(lock_file, cwd)
                    emit_event(
                        "memory_in_use",
                        f"stale lock file {rel_lock} (age={age:.0f}s) removed at session start",
                        lock_file=rel_lock,
                        age_seconds=int(age),
                        action="removed_stale_lock",
                    )
                    notices.append(f"[self-resolved] memory_in_use: stale lock {os.path.basename(lock_file)} removed (age {age:.0f}s)")
            except Exception:
                pass

if notices:
    print("\n".join(notices))
PYEOF
)
fi

# Build the optional self-resolve injection block (only if anything resolved)
SELF_RESOLVE_BLOCK=""
if [ -n "$SELF_RESOLVE_NOTICES" ]; then
  SELF_RESOLVE_BLOCK=$'\n\n<self-resolve-log>\n'"${SELF_RESOLVE_NOTICES}"$'\n</self-resolve-log>'
fi

# ─── Living-vault staleness notice (advisory; spec 2026-06-10-living-vault) ──
# One line, counts only — ambient awareness that the code moved since the last
# scan. Signals: dirty-paths journal non-empty OR git HEAD ≠ the map's
# last_scanned_commit stamp. Never blocks; absent when clean.
#
# P1 (v4.93.0, decision 8): the signals come from the ONE probe engine —
# scripts/derive-state.sh → .mega-sdd/state.json (shared _lib/state_probes.py,
# the same library routing + validate-preflight read) — so this notice can
# never diverge from what routing sees. Gated behind the existing map-present
# condition (no new latency on non-SDD CWDs). Stale-plugin-cache tolerance:
# when derive-state.sh is absent or fails, the pre-P1 bash computation below
# runs unchanged (byte-identical notice strings).
STALENESS_NOTICE=""
LV_MAP="${project_root}/.mega-sdd/codebase/codebase-map.md"
if [ -f "$LV_MAP" ] && \
   ! grep -qE "^[[:space:]]*staleness_notice:[[:space:]]*false" "${project_root}/.mega-sdd/config.yaml" 2>/dev/null; then
  LV_FROM_DIGEST=0
  LV_DS="${SCRIPT_DIR}/../scripts/derive-state.sh"
  if [ -f "$LV_DS" ] && bash "$LV_DS" --cwd="$project_root" >/dev/null 2>&1 \
     && [ -f "${project_root}/.mega-sdd/state.json" ]; then
    # Build the SAME notice strings from the digest. Prints "CLEAN" when no
    # notice is due, the notice line otherwise; empty output = parse failure
    # → the bash fallback below engages.
    LV_OUT=$(STATE="${project_root}/.mega-sdd/state.json" python3 - 2>/dev/null <<'PYLV'
import json, os
try:
    s = json.load(open(os.environ["STATE"]))
    p = s["probes"]
except Exception:
    raise SystemExit(0)  # empty output -> bash fallback
dirty = p.get("dirty_journal_rows", 0)
cmap = p.get("codebase_map") or {}
stamp = cmap.get("last_scanned_commit")
head = (p.get("git") or {}).get("head")
detail = "%d journaled write(s)" % dirty
if stamp and head and head != stamp:
    detail += "; map stamp %s ≠ HEAD %s" % (stamp[:8], head[:8])
moved = dirty > 0 or bool(stamp and head and head != stamp)
open_n = 0
pending = ""
for v in p.get("vaults") or []:
    if v.get("layout") not in ("canonical", "legacy-docs"):
        continue  # parity with the pre-P1 glob set
    n = v.get("pending_sync_open", 0)
    if n > 0:
        open_n += n
        pending = "%s/PENDING-SYNC.md" % v.get("path", "")
if open_n > 0:
    line = ("mega-sdd: %d open sync decision(s) queued in %s — resolve the queue first."
            % (open_n, pending))
    if moved:
        line += (" Code also moved since last scan (%s) — re-run `/mega-sdd:sync` after."
                 % detail)
    print(line)
elif moved:
    print("mega-sdd: codebase moved since last scan (%s) — `/mega-sdd:sync` reconciles map → drift → binding → units."
          % detail)
else:
    print("CLEAN")
PYLV
)
    if [ -n "$LV_OUT" ]; then
      LV_FROM_DIGEST=1
      if [ "$LV_OUT" != "CLEAN" ]; then
        STALENESS_NOTICE=$'\n\n'"$LV_OUT"
      fi
    fi
  fi
  if [ "$LV_FROM_DIGEST" -eq 0 ]; then
  LV_JOURNAL="${project_root}/.mega-sdd/codebase/.dirty-paths.jsonl"
  LV_DIRTY=0
  if [ -s "$LV_JOURNAL" ]; then
    LV_DIRTY=$(grep -c . "$LV_JOURNAL" 2>/dev/null || echo 0)
  fi
  LV_STAMP=$(sed -n 's/^last_scanned_commit:[[:space:]]*//p' "$LV_MAP" 2>/dev/null | head -1)
  LV_HEAD=""
  if [ -n "$LV_STAMP" ] && command -v git >/dev/null 2>&1; then
    LV_HEAD=$(git -C "$project_root" rev-parse HEAD 2>/dev/null || true)
  fi
  LV_DETAIL="${LV_DIRTY} journaled write(s)"
  if [ -n "$LV_STAMP" ] && [ -n "$LV_HEAD" ] && [ "$LV_HEAD" != "$LV_STAMP" ]; then
    LV_DETAIL="${LV_DETAIL}; map stamp ${LV_STAMP:0:8} ≠ HEAD ${LV_HEAD:0:8}"
  fi
  # Deferred-decision queue (PENDING-SYNC.md): when open items exist, the
  # notice points at the queue FIRST (sync-digest contract) — a fresh sync
  # would just re-queue the same decisions.
  LV_OPEN=0
  LV_PENDING=""
  for lv_ps in "${project_root}/.mega-sdd/vaults"/*/PENDING-SYNC.md "${project_root}/docs/mega-sdd/vaults"/*/PENDING-SYNC.md; do
    [ -f "$lv_ps" ] || continue
    lv_n=$(grep -c '^- \[ \]' "$lv_ps" 2>/dev/null || echo 0)
    if [ "${lv_n:-0}" -gt 0 ]; then
      LV_OPEN=$((LV_OPEN + lv_n))
      LV_PENDING="${lv_ps#"${project_root}"/}"
    fi
  done
  LV_MOVED=0
  if [ "$LV_DIRTY" -gt 0 ] || { [ -n "$LV_STAMP" ] && [ -n "$LV_HEAD" ] && [ "$LV_HEAD" != "$LV_STAMP" ]; }; then
    LV_MOVED=1
  fi
  if [ "$LV_OPEN" -gt 0 ]; then
    STALENESS_NOTICE=$'\n\n'"mega-sdd: ${LV_OPEN} open sync decision(s) queued in ${LV_PENDING} — resolve the queue first."
    if [ "$LV_MOVED" -eq 1 ]; then
      STALENESS_NOTICE="${STALENESS_NOTICE} Code also moved since last scan (${LV_DETAIL}) — re-run \`/mega-sdd:sync\` after."
    fi
  elif [ "$LV_MOVED" -eq 1 ]; then
    STALENESS_NOTICE=$'\n\n'"mega-sdd: codebase moved since last scan (${LV_DETAIL}) — \`/mega-sdd:sync\` reconciles map → drift → binding → units."
  fi
  fi  # LV_FROM_DIGEST fallback (pre-P1 bash computation, unchanged)
fi

# ─── Resumed-after-compaction notice (ECC Batch 2) ──────────────────────────
# When a fresh compaction snapshot exists (PreCompact wrote it) and the source
# is a compact/resume, surface one line so the next window re-orients to the
# in-flight phase instead of re-deriving it. Advisory; shares telemetry opt-out.
COMPACT_RESUME=""
SNAP="${project_root}/.mega-sdd/.compaction-snapshot.json"
if [ -f "$SNAP" ]; then
  COMPACT_RESUME=$(SNAP="$SNAP" python3 -c '
import json, os
try:
    d = json.load(open(os.environ["SNAP"]))
except Exception:
    raise SystemExit(0)
ph = d.get("phase", {})
guess = ph.get("guess", "unknown")
ut, bd = ph.get("units_total", 0), ph.get("bolts_done", 0)
pend = d.get("pending_sync_open", 0)
extra = (" — %d open sync decision(s)" % pend) if pend else ""
print("mega-sdd: resumed after a compaction at phase [%s] — %d unit(s), %d bolt(s) done%s. Re-orient from .mega-sdd/.compaction-snapshot.json." % (guess, ut, bd, extra))
' 2>/dev/null)
  if [ -n "$COMPACT_RESUME" ]; then
    COMPACT_RESUME=$'\n\n'"${COMPACT_RESUME}"
  fi
fi

# ─── Instinct injection (continuous learning, ECC-adoption Batch 1) ─────────
# Bounded re-injection of confidence-scored learnings: top 6 with confidence
# ≥0.7, project scope before global, hard budget 1200 chars. Opt-out:
# `instincts: false` in .mega-sdd/config.yaml. Schema + lifecycle:
# skills/memory/references/instincts.md. Fail-open: any parse error = no block.
INSTINCT_BLOCK=""
if ! grep -qE "^[[:space:]]*instincts:[[:space:]]*false" "${project_root}/.mega-sdd/config.yaml" 2>/dev/null; then
  INSTINCT_BLOCK=$(PROJ="$project_root" python3 - 2>/dev/null <<'PYINST'
import glob, os

proj = os.environ["PROJ"]
dirs = [
    (0, os.path.join(proj, ".mega-sdd", "memory", "instincts")),
    (1, os.path.join(os.path.expanduser("~"), ".mega-sdd", "memory", "instincts")),
]
cands = []
for rank, d in dirs:
    for p in sorted(glob.glob(os.path.join(d, "*.yaml"))):
        kv = {}
        try:
            for line in open(p, encoding="utf-8", errors="replace"):
                if ":" in line and not line.startswith((" ", "\t", "-", "#")):
                    k, _, v = line.partition(":")
                    kv[k.strip()] = v.strip().strip("'\"")
        except OSError:
            continue
        try:
            conf = float(kv.get("confidence", "0"))
        except ValueError:
            continue
        if kv.get("status", "active") != "active" or conf < 0.7:
            continue
        trig, act = kv.get("trigger", ""), kv.get("action", "")
        if trig and act:
            cands.append((rank, -conf, "- [%.1f|%s] WHEN %s -> %s" % (conf, kv.get("domain", "general"), trig, act)))
cands.sort()
out, total = [], 0
for _, _, line in cands[:6]:
    if total + len(line) > 1200:
        break
    out.append(line)
    total += len(line)
print("\n".join(out))
PYINST
)
  if [ -n "$INSTINCT_BLOCK" ]; then
    INSTINCT_BLOCK=$'\n\n<learned-instincts>\n'"Learned instincts (confidence-scored from this project + global memory — apply unless the user, spec, or a Hard rule says otherwise):"$'\n'"${INSTINCT_BLOCK}"$'\n</learned-instincts>'
  fi
fi

cat <<EOF
<<EXTREMELY_IMPORTANT>>
You have mega-sdd skills available. SDD context detected in CWD.

${ANCHOR_CONTENT}${WARN}${SELF_RESOLVE_BLOCK}${STALENESS_NOTICE}${COMPACT_RESUME}${INSTINCT_BLOCK}
<</EXTREMELY_IMPORTANT>>
EOF
