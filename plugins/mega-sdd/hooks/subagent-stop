#!/usr/bin/env bash
# SubagentStop hook for mega-sdd — S3 (token batch): capture per-subagent token cost.
#
# WHY: SubagentStop NEVER fires the Stop hook (the harness converts Stop->SubagentStop
# at the subagent boundary), so the entire bolt phase (bolt-implementer + the blind
# review panel) and every dispatched subagent emitted ZERO telemetry. A full-pipeline
# field audit measured ~half of the 100.7M intent->unit tokens inside subagents that were
# invisible to turn_end_marker — and the heaviest phase (bolts) was 100% dark.
#
# This hook reads the subagent's OWN transcript (stdin field `agent_transcript_path`,
# a nested subagents/*.jsonl) and emits a `subagent_end_marker` whose usage is SUMMED
# across the subagent's turns. A subagent runs many internal turns but SubagentStop
# fires ONCE at the end; the last message's usage is only the FINAL turn's context size
# (empirically ~7x under the real cumulative cost), so we sum every turn's usage to get
# the true cost. report-token-cost.sh consumes subagent_end_marker for cost-weighting.
#
# No double-count: the subagent's turns live in its OWN nested transcript, disjoint from
# the main-session transcript the Stop hook reads for turn_end_marker.
#
# Observe-only: exit 0 always (never blocks a subagent from stopping). Mirrors the Stop
# hook's gates — opt-out (config telemetry:false), project-root resolution, and the
# "telemetry.jsonl must already exist" gate (don't bootstrap telemetry for untracked work).

set -uo pipefail

STDIN_JSON=$(cat 2>/dev/null || echo '{}')

# ─── v7 fast negative short-circuit (spec §3.6) ──────────────────────────────
# SubagentStop fires for every subagent in every project (~2 python spawns).
# Same fork-free pattern as the Stop hook; doubt falls through to python.
SC_CWD=""
case "$STDIN_JSON" in
  *'"cwd"'*)
    _sc="${STDIN_JSON#*\"cwd\"}"
    _sc="${_sc#*\"}"
    SC_CWD="${_sc%%\"*}"
    ;;
esac
if [ -n "$SC_CWD" ]; then
  case "$0" in */*) SC_DIR="${0%/*}" ;; *) SC_DIR="." ;; esac
  SC_RPR="${SC_DIR}/../scripts/_lib/resolve-project-root.sh"
  if [ -f "$SC_RPR" ]; then
    # shellcheck disable=SC1090
    . "$SC_RPR"
    case "${OSTYPE:-}" in msys*|cygwin*|win32*) SC_CWD="${SC_CWD//\\\\//}"; SC_CWD="${SC_CWD//\\//}" ;; esac
    if [ -d "$SC_CWD" ]; then
      SC_ROOT=$(resolve_project_root "$SC_CWD")
      if [ ! -d "${SC_ROOT}/.mega-sdd" ]; then exit 0; fi
    fi
  fi
fi

# Safely extract cwd (no eval — paths may contain spaces).
CWD=$(printf '%s' "$STDIN_JSON" | python3 -c 'import json,sys
try: print(json.loads(sys.stdin.read()).get("cwd","") or "")
except Exception: print("")' 2>/dev/null)
[ -z "$CWD" ] && exit 0

# Resolve project root (CWD may be a sub-folder; walk up to outermost .mega-sdd/).
SCRIPT_DIR_RPR="$(cd "$(dirname "$0")" && pwd 2>/dev/null)"
RPR_HELPER="${SCRIPT_DIR_RPR}/../scripts/_lib/resolve-project-root.sh"
if [ -f "$RPR_HELPER" ]; then
  # shellcheck disable=SC1090
  . "$RPR_HELPER"
  PROJECT_ROOT=$(resolve_project_root "$CWD")
else
  PROJECT_ROOT="$CWD"
fi

[ -d "${PROJECT_ROOT}/.mega-sdd" ] || exit 0

# Opt-out.
CONFIG_FILE="${PROJECT_ROOT}/.mega-sdd/config.yaml"
if [ -f "$CONFIG_FILE" ] && grep -qE "^\s*telemetry:\s*false" "$CONFIG_FILE" 2>/dev/null; then
  exit 0
fi

mkdir -p "${PROJECT_ROOT}/.mega-sdd/memory" 2>/dev/null || true
TS=$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo "unknown-ts")

# Everything else in one python pass (keeps paths out of the shell — no eval/quoting bugs).
printf '%s' "$STDIN_JSON" | PROJECT_ROOT="$PROJECT_ROOT" TS="$TS" python3 -c '
import json, os, sys
try:
    data = json.loads(sys.stdin.read())
except Exception:
    sys.exit(0)

root = os.environ["PROJECT_ROOT"]
ts = os.environ["TS"]
mem = os.path.join(root, ".mega-sdd", "memory")
telemetry = os.path.join(mem, "telemetry.jsonl")
debug_log = os.path.join(mem, "hook-debug.log")

session_id = data.get("session_id", "unknown")
agent_id = data.get("agent_id", "") or ""
agent_type = data.get("agent_type", "") or "subagent"
atp = data.get("agent_transcript_path", "") or ""

# Diagnostic line ALWAYS (parity with Stop hook — proves the harness fired SubagentStop).
try:
    with open(debug_log, "a") as f:
        f.write(json.dumps({"ts": ts, "hook": "subagent-stop", "session_id": session_id,
                            "agent_id": agent_id, "agent_type": agent_type,
                            "agent_transcript_path": atp}, separators=(",", ":")) + "\n")
except Exception:
    pass

# Telemetry gate: emit only if telemetry.jsonl already exists (consistent with the
# turn_end_marker gate — do not bootstrap telemetry for an untracked/disabled session).
if not os.path.isfile(telemetry):
    sys.exit(0)

# SUM usage across ALL assistant turns in the subagent transcript (not last-only),
# DEDUPED BY message.id: the harness writes one JSONL record per content block, all
# sharing one message.id and repeating the SAME usage object, so a blind sum
# over-counts (measured 2.47x aggregate over 10 real transcripts; duplicate records
# verified usage-identical). Summing the whole file is correct HERE and only here —
# a subagent transcript is read once, at the subagent boundary. (The main-session
# transcript is append-only and its hook fires every turn, so hooks/stop windows by
# a byte cursor instead.)
# Also captured: the exact cache_creation TTL split, so report-token-cost.sh prices
# cache creation at its real rate instead of assuming a TTL for this lane; and the
# model, which is what settles "what tier did bolt-implementer actually run at".
keys = ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens", "output_tokens")
tot = {k: 0 for k in keys}
cc5 = 0
cc1 = 0
model = ""
seen = set()
nameless = 0
have = False
if atp and os.path.isfile(atp):
    with open(atp) as f:
        for line in f:
            try:
                rec = json.loads(line)
            except Exception:
                continue
            msg = rec.get("message") if isinstance(rec.get("message"), dict) else None
            if not (msg and isinstance(msg.get("usage"), dict)):
                continue
            mid = msg.get("id")
            # Dedup only on a REAL id. A message with no id has no identity to
            # dedup on, so collapsing those would silently drop distinct turns.
            if isinstance(mid, str) and mid:
                if mid in seen:
                    continue
                seen.add(mid)
            else:
                nameless += 1
            u = msg["usage"]
            have = True
            if not model and isinstance(msg.get("model"), str):
                model = msg["model"]
            for k in keys:
                v = u.get(k, 0)
                if isinstance(v, (int, float)):
                    tot[k] += int(v)
            cc = u.get("cache_creation")
            if isinstance(cc, dict):
                v5 = cc.get("ephemeral_5m_input_tokens", 0)
                v1 = cc.get("ephemeral_1h_input_tokens", 0)
                if isinstance(v5, (int, float)):
                    cc5 += int(v5)
                if isinstance(v1, (int, float)):
                    cc1 += int(v1)
if not have:
    sys.exit(0)  # subagent transcript missing/empty — nothing to attribute
tot["cache_creation_5m_input_tokens"] = cc5
tot["cache_creation_1h_input_tokens"] = cc1

event = {
    "ts": ts,
    "skill": agent_type,
    "event_type": "subagent_end_marker",
    "session_id": session_id,
    "hook_source": "SubagentStop",
    "payload": {
        "usage": tot,
        "messages": len(seen) + nameless,
        "model": model,
        "skill_name": agent_type,
        "agent_type": agent_type,
        "agent_id": agent_id,
        "logged_at_chat": False,
    },
}
try:
    with open(telemetry, "a") as f:
        f.write(json.dumps(event, separators=(",", ":")) + "\n")
except Exception:
    pass
' 2>/dev/null

exit 0
