#!/usr/bin/env bash
# PreToolUse hook for mega-sdd plugin.
#
# [HOOK-VALIDATE] enforcement layer. Blocks two classes of agent actions:
#   1. mega-sdd:execute-bolts while a HARD-BLOCK gate is FAILing (the gate
#      aggregator below — the binding->units moat gate + the kept code-delivery
#      quality gates). The DEMOTED code-delivery checks (dispatch-prompt,
#      operator-UX, fan-out-parity, ui-deferral, vault-flow-staging) are advisory
#      only and surface via /mega-sdd:analyze — they do NOT block here.
#   2. Anti-self-bypass: agent attempts to delete/truncate/overwrite guard state
#      files (.validation-blockers.json, .plan-pending, .replan-budget,
#      .iter-classifier.json).
#
# Honest design constraint: the human user (Farhan) is not the adversary — they
# are on the same side as the guard. The agent (Claude) is what we constrain.
# Manual override via filesystem ops outside agent context (user types `rm` in
# their shell) is a FEATURE, not a leak. Hooks only see tool calls from the
# agent; user-shell ops bypass hooks naturally.
#
# Output protocol (Claude Code PreToolUse):
#   - JSON to stdout with hookSpecificOutput.permissionDecision: "deny" (current
#     → tool is blocked; reason shown to agent
#   - Or exit 2 with stderr message → tool is blocked (other non-zero codes are non-blocking notices)
#   - Else exit 0 → tool proceeds normally
#
# Input (stdin): JSON {session_id, cwd, tool_name, tool_input, ...}

set -uo pipefail

STDIN_JSON=$(cat 2>/dev/null || echo '{}')

# Parse via python3 — assign to local vars first (no backslash in f-string)
PARSE_OUTPUT=$(printf '%s' "$STDIN_JSON" | python3 -c '
import json
import sys
import base64

try:
    data = json.loads(sys.stdin.read())
except Exception:
    sys.exit(0)

cwd = data.get("cwd", "")
tool_name = data.get("tool_name", "")
tool_input = data.get("tool_input", {})
transcript_path = data.get("transcript_path", "")

print(f"CWD={cwd}")
print(f"TOOL_NAME={tool_name}")
print(f"TRANSCRIPT_PATH={transcript_path}")

if tool_name == "Skill":
    skill_name = tool_input.get("skill", "")
    print(f"SKILL_NAME={skill_name}")
elif tool_name == "Bash":
    cmd = tool_input.get("command", "")
    cmd_b64 = base64.b64encode(cmd.encode()).decode()
    print(f"BASH_CMD_B64={cmd_b64}")
elif tool_name in ("Edit", "Write", "MultiEdit"):
    fp = tool_input.get("file_path", "")
    fp_b64 = base64.b64encode(fp.encode()).decode()
    print(f"FILE_PATH_B64={fp_b64}")
    sid = data.get("session_id", "")
    print(f"SESSION_ID={sid}")
' 2>/dev/null)

if [ -z "$PARSE_OUTPUT" ]; then
  # ── python3-absent fail-closed fallback (moat integrity) ───────────────────
  # Without python3 the JSON parse yields nothing and this hook would silently
  # fail OPEN — bypassing the binding→units gate. Best-effort shell extraction:
  # block execute-bolts when a blockers file exists and does not attest PASS.
  if ! command -v python3 >/dev/null 2>&1; then
    FB_CWD=$(printf '%s' "$STDIN_JSON" | sed -n 's/.*"cwd"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
    FB_SKILL=$(printf '%s' "$STDIN_JSON" | sed -n 's/.*"skill"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
    if [ -n "$FB_CWD" ] && [ -d "${FB_CWD}/.mega-sdd" ]; then
      case "$FB_SKILL" in
        *execute-bolts*)
          FB_MOAT="${FB_CWD}/.mega-sdd/.validation-blockers.json"
          if [ -f "$FB_MOAT" ] && ! grep -q '"status"[[:space:]]*:[[:space:]]*"PASS"' "$FB_MOAT" 2>/dev/null; then
            printf '{"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny", "permissionDecisionReason": "mega-sdd gate (fail-closed): python3 unavailable and .validation-blockers.json does not attest PASS — install python3 or resolve blockers before execute-bolts"}, "decision": "block", "reason": "mega-sdd gate fail-closed without python3"}\n'
            exit 0
          fi
          ;;
      esac
    fi
  fi
  exit 0
fi
eval "$PARSE_OUTPUT" 2>/dev/null || true

if [ -z "${CWD:-}" ]; then exit 0; fi

# ─── Resolve project root ────────────────────────────────────────────────────
# Model may cd into a subfolder during a chain step (extract-intelligence often
# operates inside .mega-sdd/knowledge-base/). Without walking up, ${CWD}/.mega-sdd/
# → .mega-sdd/knowledge-base/.mega-sdd/ (nested). resolve_project_root walks UP
# to the outermost .mega-sdd/ parent. Fallback: original CWD.
SCRIPT_DIR_RPR="$(cd "$(dirname "$0")" && pwd 2>/dev/null)"
RPR_HELPER="${SCRIPT_DIR_RPR}/../scripts/_lib/resolve-project-root.sh"
if [ -f "$RPR_HELPER" ]; then
  # shellcheck disable=SC1090
  . "$RPR_HELPER"
  PROJECT_ROOT=$(resolve_project_root "$CWD")
else
  PROJECT_ROOT="$CWD"
fi

# Only act on mega-sdd projects (skip if .mega-sdd/ doesn't exist).
# Ordered BEFORE the config grep: this 1-stat check is the common-case exit for
# every non-SDD project, and config.yaml only exists inside .mega-sdd/ anyway.
if [ ! -d "${PROJECT_ROOT}/.mega-sdd" ]; then exit 0; fi

# Opt-out: telemetry: false in config.yaml also disables this hook
# (a project that opts out of telemetry generally wants to opt out of guards too)
CONFIG_FILE="${PROJECT_ROOT}/.mega-sdd/config.yaml"
if [ -f "$CONFIG_FILE" ]; then
  if grep -qE "^\s*telemetry:\s*false" "$CONFIG_FILE" 2>/dev/null; then
    exit 0
  fi
fi

# Helper: emit block JSON to stdout and exit
emit_block() {
  local reason="$1"
  # Escape for JSON string (basic)
  local reason_json
  reason_json=$(printf '%s' "$reason" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))' 2>/dev/null)
  if [ -z "$reason_json" ]; then
    # no-python3 fallback: strip JSON-hostile chars so the deny JSON stays valid
    reason_json="\"$(printf '%s' "$reason" | tr '"\\' "'/" | tr -d '\n')\""
  fi
  # Current PreToolUse contract (code.claude.com/docs/en/hooks): deny via
  # hookSpecificOutput.permissionDecision — {"continue": false} is NOT
  # processed for PreToolUse (it only stops the session on other events).
  # The legacy decision/block pair rides along for older Claude Code versions.
  cat <<EOF
{"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny", "permissionDecisionReason": $reason_json}, "decision": "block", "reason": $reason_json}
EOF
  exit 0  # PreToolUse uses stdout JSON for block, not exit code
}

# ─── BRANCH 1: Skill invocation gate ─────────────────────────────────────────
case "${TOOL_NAME:-}" in
  Skill)
    # Branch 1c: scope flag validation for mega-sdd:auto / generate-intent /
    # orchestrate-flow. Reads transcript_path to find user's most recent message +
    # extract --scope=X flag (args not in tool_input). Validates against PRD scopes.
    case "${SKILL_NAME:-}" in
      mega-sdd:auto|mega-sdd:generate-intent|mega-sdd:orchestrate-flow)
        if [ -n "${TRANSCRIPT_PATH:-}" ] && [ -f "$TRANSCRIPT_PATH" ]; then
          # Extract most recent USER message text from transcript
          USER_MSG=$(TRANSCRIPT_PATH="$TRANSCRIPT_PATH" python3 -c '
import json, os
last_user_text = None
with open(os.environ["TRANSCRIPT_PATH"]) as f:
    for line in f:
        try:
            rec = json.loads(line)
        except Exception:
            continue
        msg = rec.get("message") if isinstance(rec.get("message"), dict) else None
        if not msg or msg.get("role") != "user":
            continue
        content = msg.get("content")
        if isinstance(content, str):
            last_user_text = content
        elif isinstance(content, list):
            parts = [b.get("text","") for b in content if isinstance(b, dict) and b.get("type") == "text"]
            if parts:
                last_user_text = "\n".join(parts)
if last_user_text:
    print(last_user_text)
' 2>/dev/null)

          if [ -n "$USER_MSG" ]; then
            SCRIPT_DIR_HV="$(cd "$(dirname "$0")" && pwd)"
            VALIDATOR_SCOPE="${SCRIPT_DIR_HV}/../scripts/validate-scope-flag.sh"
            if [ -x "$VALIDATOR_SCOPE" ]; then
              SCOPE_RESULT=$(printf '%s' "$USER_MSG" | bash "$VALIDATOR_SCOPE" --cwd="$PROJECT_ROOT" --quiet 2>/dev/null)
              SCOPE_EXIT=$?
              if [ "$SCOPE_EXIT" = "1" ]; then
                # FAIL — extract stopReason from state file and emit block
                STATE_SCOPE="${PROJECT_ROOT}/.mega-sdd/.scope-flag-state.json"
                if [ -f "$STATE_SCOPE" ]; then
                  STOP_REASON=$(python3 -c "
import json
try:
    d = json.load(open('$STATE_SCOPE'))
    print(d.get('stopReason', 'scope_not_declared_in_prd'))
except Exception:
    print('scope_not_declared_in_prd')
" 2>/dev/null)
                  emit_block "$STOP_REASON"
                fi
              fi
            fi
          fi
        fi
        ;;
    esac

    # Branch 0: predictive preflight — fatal INPUT-precondition check for the skill
    # about to run, BEFORE it burns minutes and halts mid-way. Conservative: only
    # GENUINELY-FATAL preconditions block (a skill that cannot do anything useful
    # without the missing input). scan-codebase tree-sitter is WARN-only (never
    # FATAL). State recomputed each invocation → self-clears (no deadlock).
    case "${SKILL_NAME:-}" in
      mega-sdd:bind-codebase|mega-sdd:generate-units|mega-sdd:execute-bolts|mega-sdd:scan-codebase)
        PREFLIGHT="${SCRIPT_DIR_RPR}/../scripts/validate-preflight.sh"
        if [ -x "$PREFLIGHT" ]; then
          bash "$PREFLIGHT" --cwd="$PROJECT_ROOT" --skill="$SKILL_NAME" --quiet >/dev/null 2>&1 || true
          PF_STATE="${PROJECT_ROOT}/.mega-sdd/.preflight-state.json"
          if [ -f "$PF_STATE" ]; then
            PF_STATUS=$(python3 -c "
import json
try:
    print(json.load(open('$PF_STATE')).get('status', 'PASS'))
except Exception:
    print('PARSE_ERROR')
" 2>/dev/null)
            if [ "$PF_STATUS" = "FATAL" ]; then
              PF_MSG=$(python3 -c "
import json
try:
    print(json.load(open('$PF_STATE')).get('fatal_on_fail', ''))
except Exception:
    print('')
" 2>/dev/null)
              emit_block "${SKILL_NAME} is blocked by a predictive preflight check — ${PF_MSG} (preflight state: ${PF_STATE})"
            fi
          fi
        fi
        ;;
    esac

    # Branch 1a: handoff validation gate — applies to ALL mega-sdd:* skills except
    # using-mega-sdd (auto-loaded anchor, not a chain step).
    #
    # Producer self-fix attempts MUST be allowed. The state file records WHICH skill
    # emitted the bad handoff (state.skill_name); when the same skill is being
    # re-invoked, that IS the producer attempting to re-run with a fixed template —
    # let it through so its re-emitted handoff overwrites the FAIL state.
    case "${SKILL_NAME:-}" in
      mega-sdd:*)
        if [ "${SKILL_NAME:-}" != "mega-sdd:using-mega-sdd" ]; then
          HANDOFF_STATE="${PROJECT_ROOT}/.mega-sdd/.handoff-validation-state.json"
          if [ -f "$HANDOFF_STATE" ]; then
            HSTATUS_AND_PRODUCER=$(STATE_PATH="$HANDOFF_STATE" python3 -c "
import json, os
try:
    d = json.load(open(os.environ['STATE_PATH']))
    print(d.get('status', 'UNKNOWN'))
    print(d.get('skill_name', ''))
except Exception:
    print('PARSE_ERROR')
    print('')
" 2>/dev/null)
            HSTATUS=$(echo "$HSTATUS_AND_PRODUCER" | sed -n '1p')
            STATE_PRODUCER=$(echo "$HSTATUS_AND_PRODUCER" | sed -n '2p')
            if [ "$HSTATUS" = "FAIL" ]; then
              if [ -n "$STATE_PRODUCER" ] && [ "$SKILL_NAME" = "$STATE_PRODUCER" ]; then
                : # producer self-fix retry — fall through to allow
              else
                HDETAIL=$(STATE_PATH="$HANDOFF_STATE" python3 -c "
import json, os
try:
    d = json.load(open(os.environ['STATE_PATH']))
    ht = d.get('halt_type', 'unknown')
    sk = d.get('skill_name', 'unknown')
    rc = d.get('retry_count', 0)
    esc = d.get('escalate_to_c2', False)
    na = d.get('next_action', {})
    hint = na.get('hint', '(no hint)') if isinstance(na, dict) else str(na)
    reason = d.get('details', {}).get('reason', '(no reason)')
    print(f'upstream {sk} emitted bad handoff ({ht}, retry={rc}, escalate_c2={esc}). Reason: {reason}. Suggestion: {hint}')
except Exception as e:
    print(f'(state file parse error: {e})')
" 2>/dev/null)
                REASON="${SKILL_NAME} blocked by handoff validation — ${HDETAIL}. Resolve by EITHER (a) re-invoke the upstream producer (${STATE_PRODUCER:-unknown}) — this is auto-allowed and overwrites the FAIL state when it emits a valid handoff; OR (b) delete the stale state file manually: rm ${PROJECT_ROOT}/.mega-sdd/.handoff-validation-state.json (the file is NOT in the anti-self-bypass protected list)."
                emit_block "$REASON"
              fi
            fi
          fi
        fi
        ;;
    esac

    # ─── execute-bolts HARD-BLOCK gate aggregator ────────────────────────────
    # One data-driven pass over the gates Farhan kept as HARD BLOCKS (v4 Phase 2,
    # Hybrid decision). Replaces the former Branch 1b + Branches 5/6/7/8/11 + the
    # CD-4 multi-fail precompute. The MOAT gate (binding->units) is checked first.
    # Each gate reads its PostToolUse-written state file and blocks on its precise
    # failing condition (status==FAIL, or a specific halt_type count for render-test).
    # Multi-fail surfacing is built in: when >1 gate fails, all names are listed up
    # front so the agent fixes them together instead of one-at-a-time.
    #
    # DEMOTED to /mega-sdd:analyze advisory (NOT blocking here): dispatch-prompt,
    # operator-UX (vault-oqs), fan-out-parity, ui-deferral, vault-flow-staging.
    if [ "${SKILL_NAME:-}" = "mega-sdd:execute-bolts" ]; then
      GATE_REASON=$(PROJECT_ROOT="$PROJECT_ROOT" python3 -c '
import json, os
md = os.path.join(os.environ["PROJECT_ROOT"], ".mega-sdd")
def L(fn):
    try:
        return json.load(open(os.path.join(md, fn)))
    except Exception:
        return None
fails = []

# MOAT GATE — binding->units: unresolved drops/CONFLICT block unit->bolt.
# Fail-CLOSED on a corrupt moat state (AUDIT L4): a present-but-unparseable
# .validation-blockers.json must NOT silently pass — a torn/garbage write would
# otherwise fail-open via L()=None and open the binding->units gate (invariant #2).
# Absent = never evaluated = allow (unchanged). ONLY the moat file is fail-closed;
# the other gates below stay fail-open to avoid spurious blocks on transient corruption.
moat_path = os.path.join(md, ".validation-blockers.json")
if os.path.exists(moat_path):
    try:
        d = json.load(open(moat_path))
    except Exception as e:
        d = None
        fails.append(("binding->units", "the binding->units moat state file .validation-blockers.json is PRESENT but UNPARSEABLE (%s) — failing CLOSED: a corrupt moat state must not silently open the gate (invariant #2). Re-run /mega-sdd:validate-handoff (or bind-codebase) to rewrite a clean state; or delete the file if you are certain no binding ran. State: %s/.validation-blockers.json" % (type(e).__name__, md)))
    if d and d.get("status") == "FAIL":
        n = len(d.get("drops", []))
        fails.append(("binding->units", "handoff validator detected %s unresolved drop(s) at the binding->units boundary. Run /mega-sdd:validate-handoff to see the drop list, then add the missing OQ-IDs to the relevant unit frontmatter binding_refs lists. State: %s/.validation-blockers.json" % (n, md)))

# bolt-orphans (status==FAIL) — bolt COMMITS with no bolt-report.md (interactive-run
# gap, clinic-project audit 2026-06-12). The Stop hook writes this state on every
# turn end; blocking the NEXT execute-bolts is what makes the audit trail
# un-skippable without --auto.
d = L(".bolt-orphans-state.json")
if d and d.get("status") == "FAIL":
    n = d.get("issues_count", len(d.get("issues", [])))
    units = ", ".join(i.get("unit_id", "?") for i in d.get("issues", [])[:8])
    fails.append(("bolt-orphans", "orphan-bolt scan found %s bolt commit(s) with NO <vault>/bolts/U-XXX/bolt-report.md (%s%s) — code shipped but the audit trail was never written (Procedure Step 0/5 skipped). Backfill a bolt-report (mark retroactive: true) for each listed unit, or re-run those units; then the scan re-passes on the next turn end. State: %s/.bolt-orphans-state.json" % (n, units, ", …" if n > 8 else "", md)))

# flow-coverage (status==FAIL)
d = L(".flow-coverage-state.json")
if d and d.get("status") == "FAIL":
    miss = sum(m.get("shortfall", 1) for m in d.get("missing_artifacts", []))
    dead = len(d.get("dead_scaffold", []))
    fails.append(("flow-coverage", "flow-coverage validator found %s input-accepting flow step(s) with no mapped input-validation artifact (e.g. missing per-stage Form Requests) and %s dead scaffold stub(s) (e.g. edit views with no update/PUT flow step). Add the missing per-step artifacts to the relevant module unit ## Target files and remove the dead scaffold stubs, then re-save the unit. State: %s/.flow-coverage-state.json" % (miss, dead, md)))

# render-test (precise halt_type count, never status==FAIL)
d = L(".unit-spec-state.json")
if d:
    n = len([i for i in d.get("issues", []) if i.get("halt_type") == "render_test_missing"])
    if n:
        fails.append(("render-test", "unit-spec validator flagged %s unit(s) shipping a detail/show view with no acceptance_test of type render (render_test_missing). A route-200 smoke test misses empty-model / null-field render crashes. Add a structured acceptance_test entry with type: render to each view-bearing unit, then re-save the unit. State: %s/.unit-spec-state.json" % (n, md)))

# sibling-consistency (status==FAIL)
d = L(".sibling-consistency-state.json")
if d and d.get("status") == "FAIL":
    incon = len(d.get("inconsistent", []))
    rel = len(d.get("missing_relations", []))
    fails.append(("sibling-consistency", "sibling-consistency validator found %s cross-cutting concern divergence(s) across sibling units (a shared concern such as branch-scoping implemented differently in one sibling than the others) and %s FK column(s) with no derived relation accessor. Make every sibling sharing a concern declare the same mechanism, and declare the relation accessor for each FK column, then re-save the unit. State: %s/.sibling-consistency-state.json" % (incon, rel, md)))

# ui-quality (status==FAIL)
d = L(".ui-quality-blockers.json")
if d and d.get("status") == "FAIL":
    s = d.get("summary", {})
    tells = s.get("scaffold_tells_matched", 0)
    miss = s.get("required_elements_missing", 0)
    fails.append(("ui-quality", "UI-quality validator found %s raw-scaffold tell(s) (e.g. a Controller-class page title, Customer Id-style column labels, raw UUID foreign-key echoes, unformatted money, or a native alert/confirm dialog) and %s missing required element(s) (app-layout extend / responsive grid) in a written view file. Humanize labels, resolve FK ids to a human label via the relation, format money, replace native dialogs with the project notification idiom, and ensure the view extends the app layout + carries a responsive grid; then re-save the view. State: %s/.ui-quality-blockers.json" % (tells, miss, md)))

# cross-cutting-registration (status==FAIL)
d = L(".cross-cutting-state.json")
if d and d.get("status") == "FAIL":
    n = len(d.get("missing_registration", []))
    fails.append(("cross-cutting", "cross-cutting-registration validator found %s generated source file(s) that declare a cross-cutting concern (e.g. the BranchScoped global scope) but never register it (e.g. the addGlobalScope(new BranchScoped) call is missing from the model booted()) — a silent cross-branch/tenant leak. Add the registration call to each flagged file, then re-save it. State: %s/.cross-cutting-state.json" % (n, md)))

if fails:
    prefix = ""
    if len(fails) > 1:
        prefix = "[%d execute-bolts gates are failing: %s — fix ALL before re-running; each is reported in turn] " % (len(fails), ", ".join(n for n, _ in fails))
    print("mega-sdd:execute-bolts is blocked — " + prefix + fails[0][1])
' 2>/dev/null)
      if [ -n "$GATE_REASON" ]; then emit_block "$GATE_REASON"; fi
    fi

    # ─── bind-codebase DEGENERATE-MAP gate (clinic-project audit 2026-06-12) ──
    # The moat's invariant #1 is spec↔code grounding; binding against a
    # codebase-map.md that is missing its frontmatter languages AND all content
    # sections is false grounding (the clinic run bound against an empty shell
    # and every downstream verdict inherited the void). Block bind-codebase when
    # the map validator attests the map is structurally degenerate; a partial
    # map (some sections present) is NOT blocked — only the empty-shell shape.
    if [ "${SKILL_NAME:-}" = "mega-sdd:bind-codebase" ]; then
      MAP_REASON=$(PROJECT_ROOT="$PROJECT_ROOT" python3 -c '
import json, os
p = os.path.join(os.environ["PROJECT_ROOT"], ".mega-sdd", ".codebase-map-state.json")
try:
    d = json.load(open(p))
except Exception:
    d = None
if d and d.get("status") == "FAIL":
    issues = d.get("issues", [])
    sec = next((i for i in issues if i.get("halt_type") == "codebase_map_sections_incomplete"), None)
    if sec and "7 sections" in (sec.get("detail") or "") or (sec and len(sec.get("missing", [])) >= 7):
        print("mega-sdd:bind-codebase is blocked — codebase-map.md is structurally DEGENERATE (all content sections missing per the map validator). Binding against an empty map produces false CONFIRMED/CONFLICT verdicts (invariant #1: spec-to-code grounding). Re-run /mega-sdd:scan-codebase to produce a real map, then bind. State: %s" % p)
' 2>/dev/null)
      if [ -n "$MAP_REASON" ]; then emit_block "$MAP_REASON"; fi
    fi
    ;;

  Edit|Write|MultiEdit)
    # ─── GateGuard: LOCKED-file investigation gate (deny→force→allow) ────────
    # ECC-adoption Batch 1 (spec 2026-06-12-instincts-and-gateguard-design.md §B).
    # The FIRST edit touching a file anchored to a [LOCKED] claim is denied with
    # the exact investigation to perform; the RETRY passes (session-scoped state,
    # 30-min expiry). Empty/absent index (greenfield, no LOCKED markers) = inert.
    # Fast path: two stat-class checks before any python.
    [ -z "${FILE_PATH_B64:-}" ] && exit 0
    if grep -qE "^[[:space:]]*gateguard:[[:space:]]*false" "$CONFIG_FILE" 2>/dev/null; then exit 0; fi
    GG_IDX="${PROJECT_ROOT}/.mega-sdd/.locked-files-index.json"
    # Lazy rebuild: index absent or older than the newest binding.md
    GG_NEWEST=$(ls -t "${PROJECT_ROOT}/.mega-sdd/vaults"/*/binding.md 2>/dev/null | head -1)
    if [ -n "$GG_NEWEST" ]; then
      if [ ! -f "$GG_IDX" ] || [ "$GG_NEWEST" -nt "$GG_IDX" ]; then
        bash "${SCRIPT_DIR_RPR}/../scripts/build-locked-index.sh" --cwd="$PROJECT_ROOT" >/dev/null 2>&1 || true
      fi
    fi
    [ -f "$GG_IDX" ] || exit 0
    GG_REASON=$(PROJECT_ROOT="$PROJECT_ROOT" FILE_PATH_B64="$FILE_PATH_B64" SESSION_ID="${SESSION_ID:-}" GG_IDX="$GG_IDX" python3 - 2>/dev/null <<'PYGG'
import base64, json, os, time

root = os.environ["PROJECT_ROOT"]
idx_path = os.environ["GG_IDX"]
sid = os.environ.get("SESSION_ID", "") or "no-session"
try:
    fp = base64.b64decode(os.environ["FILE_PATH_B64"]).decode()
except Exception:
    raise SystemExit(0)
try:
    idx = json.load(open(idx_path))
except Exception:
    raise SystemExit(0)  # corrupt index never crashes the tool call (gate is advisory-shaped)
files = idx.get("files", {})
if not files:
    raise SystemExit(0)
try:
    rel = os.path.relpath(os.path.abspath(fp), root)
except Exception:
    raise SystemExit(0)
if rel not in files:
    raise SystemExit(0)

state_path = os.path.join(root, ".mega-sdd", ".gateguard-state.json")
now = time.time()
state = {"session_id": sid, "entries": {}}
try:
    s = json.load(open(state_path))
    if s.get("session_id") == sid:
        state = s
except Exception:
    pass
entries = {k: v for k, v in state.get("entries", {}).items() if now - v < 1800}
if rel in entries:
    raise SystemExit(0)  # already investigated this session — allow

# Record FIRST (deny-once: the retry passes even if the model ignores the prescription)
entries[rel] = now
if len(entries) > 500:
    entries = dict(sorted(entries.items(), key=lambda kv: kv[1])[-500:])
state = {"session_id": sid, "entries": entries}
tmp = state_path + ".tmp"
try:
    with open(tmp, "w") as f:
        json.dump(state, f)
    os.replace(tmp, state_path)
except Exception:
    pass  # state-write failure must not crash the deny

refs = ", ".join(files[rel][:3])
print(
    "GateGuard (LOCKED grounding gate): %s is anchored to a [LOCKED] claim (%s). "
    "Before editing, gather these facts in THIS session: "
    "(1) Read the claim + its binding verdict at the ref above; "
    "(2) Grep every file that imports/uses %s and list them; "
    "(3) name the acceptance test that covers this behavior. "
    "Then RETRY the same edit — the retry is allowed (deny-once gate). "
    "If the change ALTERS the locked behavior, do not edit directly: route it through "
    "/mega-sdd:sync (drift triage) or the bolt propose-and-confirm path." % (rel, refs, rel)
)
PYGG
)
    if [ -n "$GG_REASON" ]; then emit_block "$GG_REASON"; fi
    exit 0
    ;;

  Bash)
    # ─── BRANCH 2: Anti-self-bypass on state files ──────────────────────────
    # Detect agent attempts to delete/truncate/overwrite guard state files.
    # SCOPED: only protects state files in ACTIVE project .mega-sdd/ (CWD root).
    # EXCLUDES: tests/, examples/, fixtures/, plugin source repo (dev-mode).
    BASH_CMD_B64="${BASH_CMD_B64:-}"
    [ -z "$BASH_CMD_B64" ] && exit 0

    # Decode command
    BASH_CMD=$(printf '%s' "$BASH_CMD_B64" | python3 -c '
import base64, sys
print(base64.b64decode(sys.stdin.read()).decode("utf-8", errors="replace"), end="")
' 2>/dev/null)
    [ -z "$BASH_CMD" ] && exit 0

    # ── Scope exclusion: skip guard for test/fixture/plugin-dev paths ──────
    GUARD_SKIP=0
    if echo "$BASH_CMD" | grep -qE "tests/|examples/|fixtures/"; then
      GUARD_SKIP=1
    fi
    # Plugin-dev-mode: CWD is the plugin source repo, not a target project.
    if [ -d "${CWD}/plugins/mega-sdd/hooks" ]; then
      GUARD_SKIP=1
    fi
    if [ "$GUARD_SKIP" -eq 1 ]; then
      exit 0
    fi

    # Protected state files
    PROTECTED='\.validation-blockers\.json|\.plan-pending|\.replan-budget|\.iter-classifier\.json'

    BYPASS_DETECTED=""
    if echo "$BASH_CMD" | grep -qE "\b(rm|unlink)\s+[^|;&]*($PROTECTED)"; then
      BYPASS_DETECTED="rm/unlink of protected state file"
    elif echo "$BASH_CMD" | grep -qE ">[[:space:]]*[^|;&]*($PROTECTED)"; then
      BYPASS_DETECTED="shell redirect (>) overwriting protected state file"
    elif echo "$BASH_CMD" | grep -qE "\bsed\s+(-[^[:space:]]*i[^[:space:]]*)\s+[^|;&]*($PROTECTED)"; then
      BYPASS_DETECTED="sed -i modifying protected state file"
    elif echo "$BASH_CMD" | grep -qE "\b(mv|cp)\s+[^|;&]*\s+[^|;&]*($PROTECTED)"; then
      BYPASS_DETECTED="mv/cp replacing protected state file"
    elif echo "$BASH_CMD" | grep -qE "\btee\s+[^|;&]*($PROTECTED)"; then
      BYPASS_DETECTED="tee overwriting protected state file"
    fi

    if [ -n "$BYPASS_DETECTED" ]; then
      REASON="Blocked: $BYPASS_DETECTED. Guard state files (.validation-blockers.json, .plan-pending, .replan-budget, .iter-classifier.json) are managed by hooks/skill chain — direct agent modification bypasses the guard. To clear a blocker, fix the underlying issue (e.g., add missing OQ-IDs to unit frontmatter) and let PostToolUse re-validate, OR use the appropriate slash command (/mega-sdd:validate-handoff, /mega-sdd:act, etc.). Human user can still modify these files via shell outside the agent."
      emit_block "$REASON"
    fi
    ;;
esac

# Default: allow the tool call
exit 0
