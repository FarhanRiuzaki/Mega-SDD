#!/usr/bin/env bash
# PreToolUse hook for mega-sdd plugin.
#
# [HOOK-VALIDATE] enforcement layer. Blocks two classes of agent actions:
#   1. mega-sdd:execute-bolts while a HARD-BLOCK gate is FAILing (the gate
#      aggregator below — the binding->units moat gate + the kept code-delivery
#      quality gates). The DEMOTED code-delivery checks (dispatch-prompt,
#      operator-UX, fan-out-parity, ui-deferral, vault-flow-staging) are advisory
#      only and surface via /mega-sdd:analyze — they do NOT block here.
#   2. Anti-self-bypass: agent attempts to delete/truncate/overwrite guard state
#      files (.validation-blockers.json, .plan-pending, .replan-budget,
#      .iter-classifier.json).
#
# Honest design constraint: the human user (Farhan) is not the adversary — they
# are on the same side as the guard. The agent (Claude) is what we constrain.
# Manual override via filesystem ops outside agent context (user types `rm` in
# their shell) is a FEATURE, not a leak. Hooks only see tool calls from the
# agent; user-shell ops bypass hooks naturally.
#
# Output protocol (Claude Code PreToolUse):
#   - JSON to stdout with hookSpecificOutput.permissionDecision: "deny" (current
#     → tool is blocked; reason shown to agent
#   - Or exit 2 with stderr message → tool is blocked (other non-zero codes are non-blocking notices)
#   - Else exit 0 → tool proceeds normally
#
# Input (stdin): JSON {session_id, cwd, tool_name, tool_input, ...}

set -uo pipefail

STDIN_JSON=$(cat 2>/dev/null || echo '{}')

# ─── Fast negative short-circuit (pure shell, BEFORE the python3 parse) ────────
# Speed: the matcher is global (Skill|Bash|Edit|Write), so EVERY such tool call in
# EVERY project hits this blocking hook — including non-mega-sdd projects, where the
# .mega-sdd gate below simply no-ops. Resolve cwd + project root in pure shell here
# and exit 0 BEFORE paying a python3 cold-start (~30-150ms) when there is no
# .mega-sdd ancestor. This is MOAT-NEUTRAL by construction: it fires ONLY when no
# .mega-sdd exists — mutually exclusive with the fall-through path that reaches the
# gates, so it can never bypass invariant #2 or any other gate. It uses the SAME
# pure-sed cwd extraction (cf. the python-absent fallback below) and the SAME
# resolve_project_root walk-up as the authoritative gate, so its .mega-sdd decision
# is byte-identical. When the cwd can't be extracted OR the resolver helper is
# absent, it does NOT short-circuit — it falls through to the authoritative path.
SC_CWD=$(printf '%s' "$STDIN_JSON" | sed -n 's/.*"cwd"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
if [ -n "$SC_CWD" ]; then
  SC_SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd 2>/dev/null)"
  SC_RPR="${SC_SCRIPT_DIR}/../scripts/_lib/resolve-project-root.sh"
  if [ -f "$SC_RPR" ]; then
    # shellcheck disable=SC1090
    . "$SC_RPR"
    SC_ROOT=$(resolve_project_root "$SC_CWD")
    if [ ! -d "${SC_ROOT}/.mega-sdd" ]; then exit 0; fi
  fi
fi

# Parse via python3 — assign to local vars first (no backslash in f-string)
PARSE_OUTPUT=$(printf '%s' "$STDIN_JSON" | python3 -c '
import json
import sys
import base64

try:
    data = json.loads(sys.stdin.read())
except Exception:
    sys.exit(0)

cwd = data.get("cwd", "")
tool_name = data.get("tool_name", "")
tool_input = data.get("tool_input", {})
transcript_path = data.get("transcript_path", "")

print(f"CWD={cwd}")
print(f"TOOL_NAME={tool_name}")
print(f"TRANSCRIPT_PATH={transcript_path}")

if tool_name == "Skill":
    skill_name = tool_input.get("skill", "")
    print(f"SKILL_NAME={skill_name}")
    args = tool_input.get("args", "") or ""
    args_b64 = base64.b64encode(str(args).encode()).decode()
    print(f"SKILL_ARGS_B64={args_b64}")
elif tool_name == "Bash":
    cmd = tool_input.get("command", "")
    cmd_b64 = base64.b64encode(cmd.encode()).decode()
    print(f"BASH_CMD_B64={cmd_b64}")
elif tool_name in ("Edit", "Write"):
    fp = tool_input.get("file_path", "")
    fp_b64 = base64.b64encode(fp.encode()).decode()
    print(f"FILE_PATH_B64={fp_b64}")
    sid = data.get("session_id", "")
    print(f"SESSION_ID={sid}")
' 2>/dev/null)

if [ -z "$PARSE_OUTPUT" ]; then
  # ── python3-UNUSABLE fail-closed fallback (moat integrity) ─────────────────
  # Without a working python3 the JSON parse yields nothing and this hook would
  # silently fail OPEN — bypassing the binding→units gate. Best-effort shell
  # extraction: block execute-bolts when a blockers file exists and does not
  # attest PASS.
  #
  # The guard USED to be `! command -v python3`, which is a FALSE POSITIVE on
  # Windows: the App Execution Alias stub in %LOCALAPPDATA%\Microsoft\WindowsApps
  # is on the default PATH, so `command -v` succeeded, this branch never ran, and
  # the hook exited 0 with every gate unevaluated — the moat died silently.
  # Measured on a Windows 11 corporate laptop 2026-07-28 (python3 AND python both
  # stubs, `py` absent). mega_sdd_python resolves a USABLE interpreter, fork-free.
  PY_LIB="${0%/*}/../scripts/_lib/resolve-python.sh"
  PY_USABLE=1
  if [ -f "$PY_LIB" ]; then
    # shellcheck disable=SC1090
    . "$PY_LIB"
    mega_sdd_python >/dev/null 2>&1 || PY_USABLE=0
  else
    command -v python3 >/dev/null 2>&1 || PY_USABLE=0
  fi
  if [ "$PY_USABLE" -eq 0 ]; then
    FB_CWD=$(printf '%s' "$STDIN_JSON" | sed -n 's/.*"cwd"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
    # Windows cwd arrives with backslashes (JSON-escaped); normalize so the
    # -d test below can actually find .mega-sdd.
    case "${OSTYPE:-}" in msys*|cygwin*|win32*) FB_CWD="${FB_CWD//\\//}" ;; esac
    FB_SKILL=$(printf '%s' "$STDIN_JSON" | sed -n 's/.*"skill"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
    if [ -n "$FB_CWD" ] && [ -d "${FB_CWD}/.mega-sdd" ]; then
      case "$FB_SKILL" in
        *execute-bolts*)
          FB_MOAT="${FB_CWD}/.mega-sdd/.validation-blockers.json"
          if [ -f "$FB_MOAT" ] && ! grep -q '"status"[[:space:]]*:[[:space:]]*"PASS"' "$FB_MOAT" 2>/dev/null; then
            printf '{"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny", "permissionDecisionReason": "mega-sdd gate (fail-closed): no usable python3 interpreter, and .validation-blockers.json does not attest PASS. Keterangan: hook mega-sdd butuh python3 untuk mengevaluasi gate; tanpa itu gate tidak bisa dipercaya, jadi execute-bolts diblokir alih-alih diloloskan diam-diam. Di Windows penyebab tersering adalah App Execution Alias stub di %%LOCALAPPDATA%%\\\\Microsoft\\\\WindowsApps yang terlihat ada di PATH tapi bukan Python. Remedy: jalankan `/mega-sdd:install-deps`, atau matikan alias di Settings > Apps > Advanced app settings > App execution aliases lalu pasang Python — kemudian selesaikan blocker sebelum execute-bolts."}, "decision": "block", "reason": "mega-sdd gate fail-closed: no usable python3"}\n'
            exit 0
          fi
          ;;
      esac
    fi
  fi
  exit 0
fi
eval "$PARSE_OUTPUT" 2>/dev/null || true

if [ -z "${CWD:-}" ]; then exit 0; fi

# ─── Resolve project root ────────────────────────────────────────────────────
# Model may cd into a subfolder during a chain step (extract-intelligence often
# operates inside .mega-sdd/knowledge-base/). Without walking up, ${CWD}/.mega-sdd/
# → .mega-sdd/knowledge-base/.mega-sdd/ (nested). resolve_project_root walks UP
# to the outermost .mega-sdd/ parent. Fallback: original CWD.
SCRIPT_DIR_RPR="$(cd "$(dirname "$0")" && pwd 2>/dev/null)"
RPR_HELPER="${SCRIPT_DIR_RPR}/../scripts/_lib/resolve-project-root.sh"
if [ -f "$RPR_HELPER" ]; then
  # shellcheck disable=SC1090
  . "$RPR_HELPER"
  PROJECT_ROOT=$(resolve_project_root "$CWD")
else
  PROJECT_ROOT="$CWD"
fi

# Only act on mega-sdd projects (skip if .mega-sdd/ doesn't exist).
# Ordered BEFORE the config grep: this 1-stat check is the common-case exit for
# every non-SDD project, and config.yaml only exists inside .mega-sdd/ anyway.
if [ ! -d "${PROJECT_ROOT}/.mega-sdd" ]; then exit 0; fi

# Opt-out: telemetry: false in config.yaml also disables this hook
# (a project that opts out of telemetry generally wants to opt out of guards too)
CONFIG_FILE="${PROJECT_ROOT}/.mega-sdd/config.yaml"
if [ -f "$CONFIG_FILE" ]; then
  if grep -qE "^\s*telemetry:\s*false" "$CONFIG_FILE" 2>/dev/null; then
    exit 0
  fi
fi

# Helper: emit block JSON to stdout and exit
emit_block() {
  local reason="$1"
  # Escape for JSON string (basic)
  local reason_json
  reason_json=$(printf '%s' "$reason" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))' 2>/dev/null)
  if [ -z "$reason_json" ]; then
    # no-python3 fallback: strip JSON-hostile chars so the deny JSON stays valid
    reason_json="\"$(printf '%s' "$reason" | tr '"\\' "'/" | tr -d '\n')\""
  fi
  # Current PreToolUse contract (code.claude.com/docs/en/hooks): deny via
  # hookSpecificOutput.permissionDecision — {"continue": false} is NOT
  # processed for PreToolUse (it only stops the session on other events).
  # The legacy decision/block pair rides along for older Claude Code versions.
  cat <<EOF
{"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny", "permissionDecisionReason": $reason_json}, "decision": "block", "reason": $reason_json}
EOF
  exit 0  # PreToolUse uses stdout JSON for block, not exit code
}

# ─── BRANCH 1: Skill invocation gate ─────────────────────────────────────────
case "${TOOL_NAME:-}" in
  Skill)
    # Branch 1c: scope flag validation for orchestrate-flow (the /mega-sdd front
    # door) / generate-intent; the mega-sdd:auto case arm stays for 5.x alias
    # back-compat. Reads transcript_path to find user's most recent message +
    # extract --scope=X flag (args not in tool_input). Validates against PRD scopes.
    case "${SKILL_NAME:-}" in
      mega-sdd:auto|mega-sdd:generate-intent|mega-sdd:orchestrate-flow)
        if [ -n "${TRANSCRIPT_PATH:-}" ] && [ -f "$TRANSCRIPT_PATH" ]; then
          # Extract most recent USER message text from transcript
          USER_MSG=$(TRANSCRIPT_PATH="$TRANSCRIPT_PATH" python3 -c '
import json, os
last_user_text = None
with open(os.environ["TRANSCRIPT_PATH"]) as f:
    for line in f:
        try:
            rec = json.loads(line)
        except Exception:
            continue
        msg = rec.get("message") if isinstance(rec.get("message"), dict) else None
        if not msg or msg.get("role") != "user":
            continue
        content = msg.get("content")
        if isinstance(content, str):
            last_user_text = content
        elif isinstance(content, list):
            parts = [b.get("text","") for b in content if isinstance(b, dict) and b.get("type") == "text"]
            if parts:
                last_user_text = "\n".join(parts)
if last_user_text:
    print(last_user_text)
' 2>/dev/null)

          if [ -n "$USER_MSG" ]; then
            SCRIPT_DIR_HV="$(cd "$(dirname "$0")" && pwd)"
            VALIDATOR_SCOPE="${SCRIPT_DIR_HV}/../scripts/validate-scope-flag.sh"
            if [ -x "$VALIDATOR_SCOPE" ]; then
              SCOPE_RESULT=$(printf '%s' "$USER_MSG" | bash "$VALIDATOR_SCOPE" --cwd="$PROJECT_ROOT" --quiet 2>/dev/null)
              SCOPE_EXIT=$?
              if [ "$SCOPE_EXIT" = "1" ]; then
                # FAIL — extract stopReason from state file and emit block
                STATE_SCOPE="${PROJECT_ROOT}/.mega-sdd/.scope-flag-state.json"
                if [ -f "$STATE_SCOPE" ]; then
                  STOP_REASON=$(python3 -c "
import json
try:
    d = json.load(open('$STATE_SCOPE'))
    print(d.get('stopReason', 'scope_not_declared_in_prd'))
except Exception:
    print('scope_not_declared_in_prd')
" 2>/dev/null)
                  emit_block "$STOP_REASON"
                fi
              fi
            fi
          fi
        fi
        ;;
    esac

    # Branch 0-pre: Factory Line backward-dispatch halt (R3-1). When the factory
    # ledger shows a phase has breached its retry cap (phase_stuck) or re-ran with
    # no progress (anti_spin), re-dispatching THAT SAME upstream phase will only spin
    # — block it. The forward execute-bolts aggregator already covers the downstream
    # side; this closes the backward side (factory-routing.md step-4 safety checks).
    # RECOMPUTE first (like preflight/scope-flag below) so a ledger reset SELF-CLEARS:
    # the validator with no raw ledger writes SKIP → no block (no stale-state deadlock).
    # Per-phase precision: ONLY the stuck phase is blocked — a sibling phase (e.g. a
    # re-scan to FIX the stuck bind) stays allowed. orchestrate-flow / auto are NOT
    # gated: they own the --resume recovery route. Placed BEFORE preflight so a stuck
    # preflight-gated phase reports the more-specific Factory halt.
    case "${SKILL_NAME:-}" in
      mega-sdd:extract-intelligence|mega-sdd:generate-intent|mega-sdd:scan-codebase|mega-sdd:bind-codebase|mega-sdd:generate-units)
        FACTORY_VALIDATOR="${SCRIPT_DIR_RPR}/../scripts/validate-factory-ledger.sh"
        if [ -x "$FACTORY_VALIDATOR" ]; then
          bash "$FACTORY_VALIDATOR" --cwd="$PROJECT_ROOT" --quiet >/dev/null 2>&1 || true
          FL_STATE="${PROJECT_ROOT}/.mega-sdd/.factory-ledger-state.json"
          if [ -f "$FL_STATE" ]; then
            FL_REASON=$(SKILL_NAME="$SKILL_NAME" FL_STATE="$FL_STATE" PROJECT_ROOT="$PROJECT_ROOT" python3 -c '
import json, os
d_state = os.environ["FL_STATE"]
skill = os.environ["SKILL_NAME"]
md = os.path.join(os.environ["PROJECT_ROOT"], ".mega-sdd")
phase = skill.split(":")[-1]
try:
    d = json.load(open(d_state))
except Exception:
    raise SystemExit(0)
if not d or d.get("status") != "FAIL":
    raise SystemExit(0)
# Map each breached phase to its halt class. A schema/unparseable FAIL has no
# cap/spin breaches → no phase match → never blocks (the forward gate handles those).
stuck = {}
for b in (d.get("cap_breaches") or []):
    stuck[b.get("phase")] = "phase_stuck"
for b in (d.get("spin_breaches") or []):
    stuck.setdefault(b.get("phase"), "anti_spin")
if phase not in stuck:
    raise SystemExit(0)
halt = stuck[phase]
msg = (d.get("details", {}) or {}).get("message") or "factory halt"
print(
    "%s is blocked by the Factory Line — phase %s is HALTED (%s): %s. Re-dispatching the "
    "same stuck phase will only spin. RECOVERY: resolve the underlying OQ/CONFLICT for this "
    "phase, then RESET the rebuildable ledger (rm %s/factory-ledger.json — it rebuilds from "
    "phase handoffs, clearing the stale attempt history; it is NOT anti-self-bypass protected) "
    "and re-run via /mega-sdd --resume. State: %s"
    % (skill, phase, halt, msg, md, d_state)
)
' 2>/dev/null)
            if [ -n "$FL_REASON" ]; then emit_block "$FL_REASON"; fi
          fi
        fi
        ;;
    esac

    # Branch 0: predictive preflight — fatal INPUT-precondition check for the skill
    # about to run, BEFORE it burns minutes and halts mid-way. Conservative: only
    # GENUINELY-FATAL preconditions block (a skill that cannot do anything useful
    # without the missing input). scan-codebase tree-sitter is WARN-only (never
    # FATAL). State recomputed each invocation → self-clears (no deadlock).
    case "${SKILL_NAME:-}" in
      mega-sdd:bind-codebase|mega-sdd:generate-units|mega-sdd:execute-bolts|mega-sdd:scan-codebase)
        PREFLIGHT="${SCRIPT_DIR_RPR}/../scripts/validate-preflight.sh"
        if [ -x "$PREFLIGHT" ]; then
          bash "$PREFLIGHT" --cwd="$PROJECT_ROOT" --skill="$SKILL_NAME" --quiet >/dev/null 2>&1 || true
          PF_STATE="${PROJECT_ROOT}/.mega-sdd/.preflight-state.json"
          if [ -f "$PF_STATE" ]; then
            PF_STATUS=$(python3 -c "
import json
try:
    print(json.load(open('$PF_STATE')).get('status', 'PASS'))
except Exception:
    print('PARSE_ERROR')
" 2>/dev/null)
            if [ "$PF_STATUS" = "FATAL" ]; then
              PF_MSG=$(python3 -c "
import json
try:
    print(json.load(open('$PF_STATE')).get('fatal_on_fail', ''))
except Exception:
    print('')
" 2>/dev/null)
              emit_block "${SKILL_NAME} is blocked by a predictive preflight check — ${PF_MSG} (preflight state: ${PF_STATE})"
            fi
          fi
        fi
        ;;
    esac

    # Branch 1a: handoff validation gate — applies to ALL mega-sdd:* skills except
    # using-mega-sdd (auto-loaded anchor, not a chain step).
    #
    # Producer self-fix attempts MUST be allowed. The state file records WHICH skill
    # emitted the bad handoff (state.skill_name); when the same skill is being
    # re-invoked, that IS the producer attempting to re-run with a fixed template —
    # let it through so its re-emitted handoff overwrites the FAIL state.
    case "${SKILL_NAME:-}" in
      mega-sdd:*)
        if [ "${SKILL_NAME:-}" != "mega-sdd:using-mega-sdd" ]; then
          HANDOFF_STATE="${PROJECT_ROOT}/.mega-sdd/.handoff-validation-state.json"
          if [ -f "$HANDOFF_STATE" ]; then
            HSTATUS_AND_PRODUCER=$(STATE_PATH="$HANDOFF_STATE" python3 -c "
import json, os
try:
    d = json.load(open(os.environ['STATE_PATH']))
    print(d.get('status', 'UNKNOWN'))
    print(d.get('skill_name', ''))
except Exception:
    print('PARSE_ERROR')
    print('')
" 2>/dev/null)
            HSTATUS=$(echo "$HSTATUS_AND_PRODUCER" | sed -n '1p')
            STATE_PRODUCER=$(echo "$HSTATUS_AND_PRODUCER" | sed -n '2p')
            if [ "$HSTATUS" = "FAIL" ]; then
              if [ -n "$STATE_PRODUCER" ] && [ "$SKILL_NAME" = "$STATE_PRODUCER" ]; then
                : # producer self-fix retry — fall through to allow
              else
                HDETAIL=$(STATE_PATH="$HANDOFF_STATE" python3 -c "
import json, os
try:
    d = json.load(open(os.environ['STATE_PATH']))
    ht = d.get('halt_type', 'unknown')
    sk = d.get('skill_name', 'unknown')
    rc = d.get('retry_count', 0)
    esc = d.get('escalate_to_c2', False)
    na = d.get('next_action', {})
    hint = na.get('hint', '(no hint)') if isinstance(na, dict) else str(na)
    reason = d.get('details', {}).get('reason', '(no reason)')
    print(f'upstream {sk} emitted bad handoff ({ht}, retry={rc}, escalate_c2={esc}). Reason: {reason}. Suggestion: {hint}')
except Exception as e:
    print(f'(state file parse error: {e})')
" 2>/dev/null)
                REASON="${SKILL_NAME} blocked by handoff validation — ${HDETAIL}. Resolve by EITHER (a) re-invoke the upstream producer (${STATE_PRODUCER:-unknown}) — this is auto-allowed and overwrites the FAIL state when it emits a valid handoff; OR (b) delete the stale state file manually: rm ${PROJECT_ROOT}/.mega-sdd/.handoff-validation-state.json (the file is NOT in the anti-self-bypass protected list)."
                emit_block "$REASON"
              fi
            fi
          fi
        fi
        ;;
    esac

    # ─── execute-bolts HARD-BLOCK gate aggregator ────────────────────────────
    # One data-driven pass over the gates Farhan kept as HARD BLOCKS (v4 Phase 2,
    # Hybrid decision). Replaces the former Branch 1b + Branches 5/6/7/8/11 + the
    # CD-4 multi-fail precompute. The MOAT gate (binding->units) is checked first.
    # Each gate reads its PostToolUse-written state file and blocks on its precise
    # failing condition (status==FAIL, or a specific halt_type count for render-test).
    # Multi-fail surfacing is built in: when >1 gate fails, all names are listed up
    # front so the agent fixes them together instead of one-at-a-time.
    #
    # DEMOTED to /mega-sdd:analyze advisory (NOT blocking here): dispatch-prompt,
    # operator-UX (vault-oqs), fan-out-parity, ui-deferral, vault-flow-staging.
    if [ "${SKILL_NAME:-}" = "mega-sdd:execute-bolts" ]; then
      # ── S4 BC-GATE-1 self-heal: the moat-state writer used to fire on UNIT
      # writes only, so a re-bind/sync that wrote binding.md with fresh active
      # CONFLICTs left .validation-blockers.json at a stale PASS (or absent)
      # and this gate opened over an unresolved CONFLICT (invariant #2). Same
      # class as INT-1: enforcement keyed to the wrong write path.
      # S4 round-2: re-validate UNCONDITIONALLY whenever a vaults dir exists —
      # an mtime heuristic here was defeated by (a) the nested units/U-*/unit.md
      # layout the ls globs cannot reach and (b) backdated mtimes (cp -p /
      # rsync -a restores). The validator is sub-second python and this is the
      # execute-bolts-only path; current truth beats a stale cache at a gate.
      # Round-2 (ATK-6): no vaults-dir condition — the legacy root *-bound layout
      # has units the validators see but no .mega-sdd/vaults/; every validator
      # handles the empty case gracefully (PASS/SKIP), so run unconditionally
      # (the hook already exited for non-mega-sdd projects).
      if [ -d "${PROJECT_ROOT}/.mega-sdd" ]; then
        bash "${SCRIPT_DIR_RPR}/../scripts/validate-handoff-binding-units.sh" --cwd="$PROJECT_ROOT" --quiet >/dev/null 2>&1 || true
        # ── S5 GU-HOOK-1/3/4: re-derive the three unit-stage gate states at gate
        # time too. Their PostToolUse dispatch is (a) keyed to the Write|Edit tool
        # path only (a unit written via Bash heredoc never re-validates — stale
        # PASS), and (b) async (TOCTOU: execute-bolts dispatched right after the
        # last unit write can read one-write-stale state). validate-unit-spec in
        # project mode + the two project-wide scanners are sub-second; current
        # truth beats a stale cache at the gate that launches a multi-minute run.
        bash "${SCRIPT_DIR_RPR}/../scripts/validate-unit-spec.sh" --cwd="$PROJECT_ROOT" --quiet >/dev/null 2>&1 || true
        bash "${SCRIPT_DIR_RPR}/../scripts/validate-flow-coverage.sh" --cwd="$PROJECT_ROOT" --quiet >/dev/null 2>&1 || true
        bash "${SCRIPT_DIR_RPR}/../scripts/validate-sibling-consistency.sh" --cwd="$PROJECT_ROOT" --quiet >/dev/null 2>&1 || true
        # ── S6 EB-GATE-1: re-derive the SIX bolt-stage/quality states at gate
        # time too. Their producers are Stop-hook keyed (orphans/batch-suite/
        # postflight: one-turn lag, and NONE exist on a fresh session/clone) or
        # Write|Edit-glob keyed (ui-quality/cross-cutting: a heredoc-written
        # view keeps a stale PASS), and factory-ledger previously ran only in
        # its own branch. Same doctrine as the moat: a stale, absent, or forged
        # state is overwritten with current truth BEFORE the aggregator reads
        # it (this also neutralizes any Bash-forged PASS — EB-GATE-5).
        bash "${SCRIPT_DIR_RPR}/../scripts/validate-bolt-artifacts.sh" --cwd="$PROJECT_ROOT" --orphan-scan --quiet >/dev/null 2>&1 || true
        bash "${SCRIPT_DIR_RPR}/../scripts/validate-bolt-artifacts.sh" --cwd="$PROJECT_ROOT" --batch-suite-gate --quiet >/dev/null 2>&1 || true
        # B1 recompute-at-gate: --recompute re-executes each committed Hard-rule bolt's
        # mechanical rules from git/fs ground truth and OVERWRITES its postflight.json
        # before the state is derived — a forged/stale evidence artifact cannot open the
        # gate. (The 6 state files are already re-derived; this extends it to B1's artifact.)
        bash "${SCRIPT_DIR_RPR}/../scripts/validate-bolt-artifacts.sh" --cwd="$PROJECT_ROOT" --postflight-scan --recompute --quiet >/dev/null 2>&1 || true
        bash "${SCRIPT_DIR_RPR}/../scripts/validate-bolt-artifacts.sh" --cwd="$PROJECT_ROOT" --whitelist-scan --quiet >/dev/null 2>&1 || true
        # B4 acceptance evidence (P4 v4.96.0): commit-keyed — only bolts whose
        # commits carry the SDD-Acceptance:v5 trailer can FAIL this state; legacy
        # bolts are advisory-only. Like B2 the artifact is READ, never re-executed
        # here (re-running acceptance tests in a hook is the forbidden inflation).
        bash "${SCRIPT_DIR_RPR}/../scripts/validate-bolt-artifacts.sh" --cwd="$PROJECT_ROOT" --acceptance-scan --quiet >/dev/null 2>&1 || true
        bash "${SCRIPT_DIR_RPR}/../scripts/validate-ui-quality.sh" --cwd="$PROJECT_ROOT" --quiet >/dev/null 2>&1 || true
