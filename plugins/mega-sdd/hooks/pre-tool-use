# ui-quality (status==FAIL)
d = L(".ui-quality-blockers.json")
if d and d.get("status") == "FAIL":
    s = d.get("summary", {})
    tells = s.get("scaffold_tells_matched", 0)
    miss = s.get("required_elements_missing", 0)
    fails.append(("ui-quality", "UI-quality validator found %s raw-scaffold tell(s) (e.g. a Controller-class page title, Customer Id-style column labels, raw UUID foreign-key echoes, unformatted money, or a native alert/confirm dialog) and %s missing required element(s) (app-layout extend / responsive grid) in a written view file. Humanize labels, resolve FK ids to a human label via the relation, format money, replace native dialogs with the project notification idiom, and ensure the view extends the app layout + carries a responsive grid; then re-save the view. State: %s/.ui-quality-blockers.json" % (tells, miss, md)))

# cross-cutting-registration (status==FAIL)
d = L(".cross-cutting-state.json")
if d and d.get("status") == "FAIL":
    n = len(d.get("missing_registration", []))
    fails.append(("cross-cutting", "cross-cutting-registration validator found %s source file(s) that declare a cross-cutting concern (e.g. BranchScoped global scope) but never register it (e.g. addGlobalScope(new BranchScoped) missing from the model booted()). Add the registration call to each flagged file, then re-save. State: %s/.cross-cutting-state.json" % (n, md)))

# factory-ledger — anti-spin cap / phase_stuck / schema (Factory Line)
d = L(".factory-ledger-state.json")
if d and d.get("status") == "FAIL":
    ht = d.get("halt_type") or "ledger_error"
    msg = (d.get("details", {}) or {}).get("message") or "factory-ledger validation failed"
    fails.append(("factory-ledger", "%s — %s" % (ht, msg)))

if fails:
    prefix = ""
    if len(fails) > 1:
        # M-07: emit the remediation of EVERY failing gate in the ONE deny (was
        # fails[0] only — each extra gate cost a full deny→fix→re-invoke cycle).
        # Strictly more information per block; identical block semantics.
        prefix = "[%d execute-bolts gates are failing: %s — fix ALL before re-running] " % (len(fails), ", ".join(n for n, _ in fails))
        body = " ||| ".join("(%s) %s" % (n, m) for n, m in fails)
        if len(body) > 2500:
            body = body[:2500] + "… [truncated — run the analyze skill (\"cek konsistensi\") for the full list]"
        print("mega-sdd:execute-bolts is blocked — " + prefix + body)
    else:
        print("mega-sdd:execute-bolts is blocked — " + fails[0][1])
' 2>/dev/null)
      if [ -n "$GATE_REASON" ]; then emit_block "$GATE_REASON"; fi
    fi

    # ─── bind-codebase DEGENERATE-MAP gate (clinic-project audit 2026-06-12) ──
    # The moat's invariant #1 is spec↔code grounding; binding against a
    # codebase-map.md that is missing its frontmatter languages AND all content
    # sections is false grounding (the clinic run bound against an empty shell
    # and every downstream verdict inherited the void). Block bind-codebase when
    # the map validator attests the map is structurally degenerate; a partial
    # map (some sections present) is NOT blocked — only the empty-shell shape.
    if [ "${SKILL_NAME:-}" = "mega-sdd:bind-codebase" ]; then
      # ── INT-1 self-heal (god-review S3): the scan procedure's mandated write
      # path is temp-file + mv (Step 10a scrub), which never fires the PostToolUse
      # Write|Edit dispatch — so .codebase-map-state.json can be stale in BOTH
      # directions (fail-open on a fresh degenerate map; permanent false-block
      # after a valid re-scan). Re-validate lazily when the map is newer than its
      # state (GateGuard lazy-rebuild pattern). Probe order mirrors bind-codebase.
      CM_STATE="${PROJECT_ROOT}/.mega-sdd/.codebase-map-state.json"
      # S4 BC-MAPARG-1: bind-codebase accepts an explicit second-positional map
      # path — a custom-path map used to escape this gate entirely (degenerate
      # custom map bound ungated; valid custom map falsely blocked on a stale
      # canonical shell). When the Skill args name an existing *.md that is not
      # a vault doc, validate THAT file (--file-path mode) instead of the probe.
      # S4 round-2 hardening: shlex tokenizing (quoted paths with spaces),
      # vault-doc paths are never map candidates (a vault .md named positionally
      # must not be validated as the map), LAST candidate wins (vault positional
      # comes first; the map is the later positional).
      CM_MAP=""
      CM_ARG=$(printf '%s' "${SKILL_ARGS_B64:-}" | PROJECT_ROOT="$PROJECT_ROOT" python3 -c '
import base64, os, shlex, sys
root = os.environ.get("PROJECT_ROOT", "")
try:
    args = base64.b64decode(sys.stdin.read()).decode("utf-8", errors="replace")
except Exception:
    raise SystemExit(0)
try:
    toks = shlex.split(args)
except Exception:
    toks = args.split()
cand = None
for tok in toks:
    if not tok.endswith(".md") or tok.startswith("--"):
        continue
    if "/vaults/" in tok or tok.startswith("vaults/") or "/.mega-sdd/vaults/" in tok:
        continue  # vault docs are never codebase maps
    p = tok if os.path.isabs(tok) else os.path.join(root, tok)
    if os.path.isfile(p):
        cand = p
if cand:
    print(cand)
' 2>/dev/null)
      if [ -n "$CM_ARG" ]; then
        CM_MAP="$CM_ARG"
      else
        CM_MAP="${PROJECT_ROOT}/.mega-sdd/codebase/codebase-map.md"
        [ -f "$CM_MAP" ] || CM_MAP="${PROJECT_ROOT}/codebase-map.md"
      fi
      if [ -n "$CM_ARG" ]; then
        # Custom-path map: validate the actual bind input (--file-path).
        # S4 round-2 (state-poisoning fix): the shared .codebase-map-state.json
        # must keep describing the CANONICAL map — a custom-map verdict left in
        # it either opened the NEXT plain bind over a degenerate canonical map
        # (PASS poisoning) or false-blocked it (FAIL poisoning). Snapshot the
        # state, evaluate, then restore before acting on the verdict.
        CM_BAK="$(mktemp 2>/dev/null || mktemp -t cmbak)"
        CM_HAD_STATE=0
        [ -f "$CM_STATE" ] && { cp "$CM_STATE" "$CM_BAK" 2>/dev/null; CM_HAD_STATE=1; }
        bash "${SCRIPT_DIR_RPR}/../scripts/validate-codebase-map.sh" --cwd="$PROJECT_ROOT" --file-path="$CM_MAP" --quiet >/dev/null 2>&1 || true
      elif [ -f "$CM_MAP" ]; then
        # Tie-loses hazard: bash-3.2 -nt compares whole seconds, and mv/cp -p can
        # preserve an OLDER mtime — so trust the state only when it is STRICTLY
        # newer than the map; any tie or inversion re-validates (cheap, bind-only path).
        if [ ! -f "$CM_STATE" ] || [ ! "$CM_STATE" -nt "$CM_MAP" ]; then
          bash "${SCRIPT_DIR_RPR}/../scripts/validate-codebase-map.sh" --cwd="$PROJECT_ROOT" --quiet >/dev/null 2>&1 || true
        fi
      fi
      MAP_REASON=$(PROJECT_ROOT="$PROJECT_ROOT" python3 -c '
import json, os
p = os.path.join(os.environ["PROJECT_ROOT"], ".mega-sdd", ".codebase-map-state.json")
try:
    d = json.load(open(p))
except Exception:
    d = None
if d and d.get("status") == "FAIL":
    issues = d.get("issues", [])
    sec = next((i for i in issues if i.get("halt_type") == "codebase_map_sections_incomplete"), None)
    if sec and "7 sections" in (sec.get("detail") or "") or (sec and len(sec.get("missing", [])) >= 7):
        print("mega-sdd:bind-codebase is blocked — codebase-map.md is structurally DEGENERATE (all content sections missing per the map validator). Binding against an empty map produces false CONFIRMED/CONFLICT verdicts (invariant #1: spec-to-code grounding). Re-run scan-codebase to produce a real map, then bind. State: %s" % p)
' 2>/dev/null)
      # S4 round-2: restore the canonical-map state BEFORE acting on the custom
      # verdict — the shared state must never carry a custom-file verdict.
      if [ -n "$CM_ARG" ]; then
        if [ "${CM_HAD_STATE:-0}" -eq 1 ]; then
          cp "$CM_BAK" "$CM_STATE" 2>/dev/null || true
        else
          rm -f "$CM_STATE" 2>/dev/null || true
        fi
        rm -f "${CM_BAK:-}" 2>/dev/null || true
      fi
      if [ -n "$MAP_REASON" ]; then emit_block "$MAP_REASON"; fi
    fi
    ;;

  Edit|Write)
    # ─── GateGuard: LOCKED-file investigation gate (deny→force→allow) ────────
    # ECC-adoption Batch 1 (spec 2026-06-12-instincts-and-gateguard-design.md §B).
    # The FIRST edit touching a file anchored to a [LOCKED] claim is denied with
    # the exact investigation to perform; the RETRY passes (session-scoped state,
    # session-lifetime dedup per M-07 — no time expiry; 500-entry LRU). Empty/absent index (greenfield, no LOCKED markers) = inert.
    # Fast path: two stat-class checks before any python.
    [ -z "${FILE_PATH_B64:-}" ] && exit 0

    # ── S4 BC-BYPASS-1: anti-self-bypass must cover the sibling write tools. ──
    # The PROTECTED guard-state check existed only on the Bash branch, so a
    # Write/Edit call could overwrite .validation-blockers.json with a forged
    # PASS and open the CONFLICT gate (PostToolUse never re-derives moat state
    # for .mega-sdd/ paths). S4 round-2 scoping:
    #  - ONLY the moat state is Write/Edit-denied — .plan-pending and
    #    .iter-classifier.json have DOCUMENTED skill-body Write paths
    #    (orchestrate-flow Plan mode / iteration classifier), so denying the
    #    tool write would break Plan→Act; their tamper protection stays on the
    #    Bash branch (rm/redirect/sed).
    #  - the tests/examples/fixtures exemption is evaluated on the path
    #    RELATIVE to PROJECT_ROOT — a real project living under a path segment
    #    named examples/ must not silently lose the guard.
    if [ ! -d "${CWD}/plugins/mega-sdd/hooks" ]; then
      FP_GUARD=$(printf '%s' "$FILE_PATH_B64" | PROJECT_ROOT="$PROJECT_ROOT" python3 -c '
import base64, os, re, sys
try:
    fp = base64.b64decode(sys.stdin.read()).decode("utf-8", errors="replace")
except Exception:
    raise SystemExit(0)
root = os.environ.get("PROJECT_ROOT", "")
p = os.path.abspath(fp) if os.path.isabs(fp) else os.path.abspath(os.path.join(root, fp))
rel = os.path.relpath(p, root) if root else p
# D3 (2026-07-29): os.path.relpath returns OS-native separators, and every pattern
# below is written with "/". On Windows `rel` came back as
# `.mega-sdd\.validation-blockers.json`, so `rel == ".mega-sdd/" + g`, the
# `.endswith("/.mega-sdd/" + g)` test and the evidence-artifact regex ALL matched
# nothing — the forged-gate-verdict guard did not exist there (invariant #2). It
# stayed inert whatever shape the model sent, because ntpath.abspath normalizes a
# forward-slash path to backslashes anyway. Proven with ntpath, which gives exact
# Windows semantics on any host; pinned by tests/hooks/guard-path-separators.test.sh.
# Guarded on os.sep so a POSIX filename legitimately containing a backslash is
# never rewritten.
if os.sep != "/":
    rel = rel.replace(os.sep, "/")
if re.search(r"(?:^|/)(?:tests|examples|fixtures)/", rel):
    raise SystemExit(0)
# S5 GU-HOOK-2: the quality-gate states join the moat state — every one of
# these is validator/hook-written ONLY (no documented skill Write path), and a
# forged PASS in any of them opened its execute-bolts hard block. .plan-pending /
# .iter-classifier.json stay OUT (documented orchestrate-flow write paths).
_GUARDED = (
    # v7 review R-1: the ARM SWITCH joins the guard — .gateguard-state.json now
    # decides whether every chain-scoped gate runs; its only legitimate writers
    # are the hook-internal python (marker writer + GateGuard deny-once), never
    # an agent tool call, so denying the agent lane costs nothing.
    ".gateguard-state.json",
    ".stop-scan-stamp", ".ptu-scan-stamp",
    ".validation-blockers.json", ".unit-spec-state.json", ".flow-coverage-state.json",
    ".sibling-consistency-state.json", ".ui-quality-blockers.json",
    ".cross-cutting-state.json", ".bolt-orphans-state.json",
    ".batch-suite-gate-state.json", ".bolt-postflight-state.json",
    ".factory-ledger-state.json", ".bolt-whitelist-state.json",
    ".bolt-acceptance-state.json",
)
if any(rel == ".mega-sdd/" + g or rel.endswith("/.mega-sdd/" + g) for g in _GUARDED):
    print("protected")
# S6 EB-GATE-4: the two B1/B2 EVIDENCE artifacts join the guard — they were
# agent-writable while the gates trusted their self-reported status, so one
# plain Write of {status:green} cleared a documented hard block (and the deny
# text itself coached that write). The deterministic writers
# (scripts/run-full-suite.sh / run-postflight-scan.sh) are the only sanctioned
# write path; they run via Bash so this Write/Edit guard never blocks them.
# W4: the B1 pre-flight BASELINE preflight.json joins the guard — scan_unit
# gives a present sha/signature snapshot PRECEDENCE over commit evidence, so
# a forged baseline laundered a DO_NOT_MODIFY/SIGNATURE violation past B1
# even at the recompute gate; sanctioned writer: scripts/run-preflight-scan.sh.
# P4: the B4 acceptance evidence acceptance.json joins the guard the same way —
# the gate READS it (B2-style, never recomputed in the hook), so one plain
# Write of {status:pass} would clear a documented hard block; sanctioned
# writer: scripts/run-acceptance-tests.sh.
elif re.search(r"(?:^|/)\.mega-sdd/\.cache/pack-resolver/[^/]+$", rel):
    # Round-1 CRIT-1 (tranche 4): the resolver cache is a hook-consumed input to
    # four blocking gates and validates by mtime alone — a Write-forged cache
    # (rc=3 meta) flips a real FAIL to SKIP and the gate re-derive re-reads the
    # poison. Sanctioned writer: the resolver itself (python, not the agent).
    # The Bash lane already denies this path; this closes the Write/Edit lane
    # (the _GUARDED tuple is exact-basename and cannot express the path).
    print("evidence")
elif re.search(r"(?:^|/)(?:\.mega-sdd/vaults/[^/]+|docs/mega-sdd/vaults/[^/]+|[^/]+-bound)/bolts/(?:[^/]+/(?:(?:pre|post)flight|acceptance)\.json|_batch-suite\.json)$", rel):
    # Anchored to a real vault prefix (S6 EB-VAL-7 fix): a user project'"'"'s OWN
    # top-level or unrelated bolts/…/postflight.json is no longer false-blocked;
    # a forged mega-sdd artifact always lives under <vault>/bolts/ so it still matches.
    print("evidence")
elif re.search(r"(?:^|/)(?:\.mega-sdd/vaults/[^/]+|docs/mega-sdd/vaults/[^/]+|[^/]+-bound)/uat/evidence/(?:[^/]+/)*result\.json$", rel):
    # P2 v6.10.0: the UAT §5 annex is RENDERED from result.json (recompute-at-
    # gate) — a hand-written {status:{pass:N}} would launder fabricated rows
    # through the legitimate render path. Sanctioned writer: scripts/uat-run.sh
    # (its invocation never NAMES the artifact). Vault-prefix-anchored like the
    # bolts evidence class (EB-VAL-7).
    print("evidence")
' 2>/dev/null)
      if [ "$FP_GUARD" = "protected" ]; then
        emit_block "Blocked: direct Write/Edit of a gate state file under .mega-sdd/. These files (.validation-blockers.json + the quality-gate states: unit-spec, flow-coverage, sibling-consistency, ui-quality, cross-cutting, bolt-orphans, batch-suite-gate, bolt-postflight, bolt-whitelist, bolt-acceptance, factory-ledger — plus the derived scan stamps .stop-scan-stamp / .ptu-scan-stamp) are written exclusively by validators/hooks — a direct agent write is a forged gate verdict. To clear a blocker, fix the underlying issue and let the validators re-derive (they re-run automatically on unit writes AND at the execute-bolts gate). Human user can still modify these files via shell outside the agent."
      fi
      if [ "$FP_GUARD" = "evidence" ]; then
        emit_block "Blocked: direct Write/Edit of a guarded evidence artifact (preflight.json / postflight.json / acceptance.json / _batch-suite.json / uat evidence result.json). These are produced ONLY by their deterministic writers — run \`bash <plugin>/scripts/run-preflight-scan.sh --cwd=<project-root> --unit=U-XXX\` (captures the pre-flight Hard-rule BASELINE snapshot), \`bash <plugin>/scripts/run-postflight-scan.sh --cwd=<project-root> --unit=U-XXX\` (executes the unit's Hard rules and records verdicts), \`bash <plugin>/scripts/run-acceptance-tests.sh --cwd=<project-root> --unit=U-XXX\` (re-executes the unit's acceptance_test entries + the L0 syntax floor and records the B4 evidence), \`bash <plugin>/scripts/run-full-suite.sh --cwd=<project-root>\` (runs the FULL suite and records the result at the pinned HEAD) or \`bash <plugin>/scripts/uat-run.sh --vault=<vault> --cwd=<project-root>\` (executes the generated UAT e2e specs and records the §5 annex evidence). A hand-written artifact is a forged gate verdict — and a hand-written preflight is a forged BASELINE (a wrong sha256 at pre-flight makes a DO_NOT_MODIFY violation undetectable). Human user can still modify these files via shell outside the agent."
      fi
    fi

    # ── v7: GateGuard is CHAIN-SCOPED (gate-0/gate-1 decision, spec §3.2) ──
    # Outside an armed chain session the LOCKED-investigation deny does not
    # fire; the residual risk (hotfix edits of LOCKED-anchored files between
    # chains) is accepted at gate-1 and re-caught by the gate-time re-derive +
    # full re-bind at the next chain entry. FP_GUARD above stays ALWAYS-ON.
    v7_chain_armed || exit 0
    if grep -qE "^[[:space:]]*gateguard:[[:space:]]*false" "$CONFIG_FILE" 2>/dev/null; then exit 0; fi
    GG_IDX="${PROJECT_ROOT}/.mega-sdd/.locked-files-index.json"
    # Lazy rebuild: index absent or older than the newest binding.md
    GG_NEWEST=$(ls -t "${PROJECT_ROOT}/.mega-sdd/vaults"/*/binding.md 2>/dev/null | head -1)
    if [ -n "$GG_NEWEST" ]; then
      if [ ! -f "$GG_IDX" ] || [ "$GG_NEWEST" -nt "$GG_IDX" ]; then
        bash "${SCRIPT_DIR_RPR}/../scripts/build-locked-index.sh" --cwd="$PROJECT_ROOT" >/dev/null 2>&1 || true
      fi
    fi
    [ -f "$GG_IDX" ] || exit 0
    GG_REASON=$(PROJECT_ROOT="$PROJECT_ROOT" FILE_PATH_B64="$FILE_PATH_B64" SESSION_ID="${SESSION_ID:-}" GG_IDX="$GG_IDX" python3 - 2>/dev/null <<'PYGG'
import base64, json, os, time

root = os.environ["PROJECT_ROOT"]
idx_path = os.environ["GG_IDX"]
sid = os.environ.get("SESSION_ID", "") or "no-session"
try:
    fp = base64.b64decode(os.environ["FILE_PATH_B64"]).decode()
except Exception:
    raise SystemExit(0)
try:
    idx = json.load(open(idx_path))
except Exception:
    raise SystemExit(0)  # corrupt index never crashes the tool call (gate is advisory-shaped)
files = idx.get("files", {})
if not files:
    raise SystemExit(0)
try:
    rel = os.path.relpath(os.path.abspath(fp), root)
except Exception:
    raise SystemExit(0)
# D3: match the POSIX-normalized keys build-locked-index.sh writes. Before this the
# lookup used OS-native separators on both sides, so a committed index built on one
# platform never matched a teammate on the other and the LOCKED guard went inert.
if os.sep != "/":
    rel = rel.replace(os.sep, "/")
if rel not in files:
    raise SystemExit(0)

state_path = os.path.join(root, ".mega-sdd", ".gateguard-state.json")
now = time.time()
state = {"session_id": sid, "entries": {}}
try:
    s = json.load(open(state_path))
    if s.get("session_id") == sid:
        state = s
    else:
        # v7 review R-2: a session reset must never drop the multi-session arm map
        eng = dict(s.get("engaged_sessions") or {})
        psid = s.get("session_id")
        if psid and s.get("chain_engaged"):
            eng[psid] = True
        if eng:
            state["engaged_sessions"] = eng
except Exception:
    pass
# M-07: session-LIFETIME dedup (was a 1800s window — any bolts run >30 min
# re-denied the SAME file + forced a re-investigation the session already did,
# ~1-3K tokens each). First touch per file per session still gets the full
# deny + prescription; the session_id key + 500-entry LRU bound the state.
entries = dict(state.get("entries", {}))
if rel in entries:
    raise SystemExit(0)  # already investigated this session — allow

# Record FIRST (deny-once: the retry passes even if the model ignores the prescription)
entries[rel] = now
if len(entries) > 500:
    entries = dict(sorted(entries.items(), key=lambda kv: kv[1])[-500:])
# v7: preserve extra keys (chain_engaged) — this writer must never un-arm the session
state = dict(state)
state["session_id"] = sid
state["entries"] = entries
tmp = state_path + ".tmp"
try:
    with open(tmp, "w") as f:
        json.dump(state, f)
    os.replace(tmp, state_path)
except Exception:
    pass  # state-write failure must not crash the deny

refs = ", ".join(files[rel][:3])
print(
    "GateGuard (LOCKED grounding gate): %s is anchored to a [LOCKED] claim (%s). "
    "Before editing, gather these facts in THIS session: "
    "(1) Read the claim + its binding verdict at the ref above; "
    "(2) Grep every file that imports/uses %s and list them; "
    "(3) name the acceptance test that covers this behavior. "
    "Then RETRY the same edit — the retry is allowed (deny-once gate). "
    "If the change ALTERS the locked behavior, do not edit directly: route it through "
    "/mega-sdd:sync (drift triage) or the bolt propose-and-confirm path." % (rel, refs, rel)
)
PYGG
)
    if [ -n "$GG_REASON" ]; then emit_block "$GG_REASON"; fi
    exit 0
    ;;

  Bash)
    # ─── BRANCH 2: Anti-self-bypass on state files ──────────────────────────
    # Detect agent attempts to delete/truncate/overwrite guard state files.
    # SCOPED: only protects state files in ACTIVE project .mega-sdd/ (CWD root).
    # EXCLUDES: tests/, examples/, fixtures/, plugin source repo (dev-mode).
    BASH_CMD_B64="${BASH_CMD_B64:-}"
    [ -z "$BASH_CMD_B64" ] && exit 0

    # Decode command
    BASH_CMD=$(printf '%s' "$BASH_CMD_B64" | python3 -c '
import base64, sys
print(base64.b64decode(sys.stdin.read()).decode("utf-8", errors="replace"), end="")
' 2>/dev/null)
    [ -z "$BASH_CMD" ] && exit 0

    # ── Scope exclusion: skip guard for test/fixture/plugin-dev paths ──────
    # S4 BC-BYPASS-2: the old check skipped the guard when "tests/" (etc.)
    # appeared ANYWHERE in the command — so `rm .mega-sdd/.validation-blockers.json
    # # cleanup for tests/` sailed through on a comment token. The exemption now
    # applies only when every PROTECTED-file reference in the command is ITSELF
    # inside a tests/examples/fixtures path — evaluated RELATIVE to PROJECT_ROOT
    # (S4 round-2: a project living under an examples/ path segment must not
    # silently lose the guard).
    GUARD_SKIP=$(printf '%s' "$BASH_CMD" | PROJECT_ROOT="$PROJECT_ROOT" python3 -c '
import os, re, sys
cmd = sys.stdin.read()
root = (os.environ.get("PROJECT_ROOT", "") or "").rstrip("/")
prot = re.compile(r"[^\s\"'"'"';|&<>]*(?:\.gateguard-state\.json|\.validation-blockers\.json|\.plan-pending|\.replan-budget|\.iter-classifier\.json|\.unit-spec-state\.json|\.flow-coverage-state\.json|\.sibling-consistency-state\.json|\.ui-quality-blockers\.json|\.cross-cutting-state\.json|\.bolt-orphans-state\.json|\.batch-suite-gate-state\.json|\.bolt-postflight-state\.json|\.factory-ledger-state\.json|\.bolt-whitelist-state\.json|\.bolt-acceptance-state\.json|bolts/[^\s\"'"'"';|&<>]*(?:(?:pre|post)flight|acceptance)\.json|bolts/_batch-suite\.json|uat/evidence/[^\s\"'"'"';|&<>]*result\.json|\.stop-scan-stamp|\.ptu-scan-stamp|\.mega-sdd/\.cache/pack-resolver/[^\s\"'"'"';|&<>]*|\.mega-sdd/vaults/[^\s\"'"'"';|&<>]*binding[^\s\"'"'"';|&<>]*\.md)")
def rel(t):
    if root and t.startswith(root + "/"):
        return t[len(root) + 1:]
    return t
toks = prot.findall(cmd)
if not toks:
    print(1)  # no protected-file reference at all — nothing to guard
elif all(re.search(r"(?:^|/)(?:tests|examples|fixtures)/", rel(t)) for t in toks):
    print(1)  # every reference is a test/fixture path — dev workflow, skip
else:
    print(0)
' 2>/dev/null)
    [ -z "$GUARD_SKIP" ] && GUARD_SKIP=0  # python3 hiccup → guard stays on (fail-closed)
    # Plugin-dev-mode: CWD is the plugin source repo, not a target project.
    if [ -d "${CWD}/plugins/mega-sdd/hooks" ]; then
      GUARD_SKIP=1
    fi
    if [ "$GUARD_SKIP" -eq 1 ]; then
      exit 0
    fi

    # Protected state files (S5 GU-HOOK-2: quality-gate states added — a single
    # `rm` cleared any execute-bolts hard block except the moat; absent = allow.
    # S6 EB-GATE-4: the B1/B2 evidence artifacts join — their deterministic
    # writers run as `bash <script>` commands that never NAME the artifact, so
    # the guard only ever fires on direct forging/tampering verbs.)
    PROTECTED='\.gateguard-state\.json|\.validation-blockers\.json|\.plan-pending|\.replan-budget|\.iter-classifier\.json|\.unit-spec-state\.json|\.flow-coverage-state\.json|\.sibling-consistency-state\.json|\.ui-quality-blockers\.json|\.cross-cutting-state\.json|\.bolt-orphans-state\.json|\.batch-suite-gate-state\.json|\.bolt-postflight-state\.json|\.factory-ledger-state\.json|\.bolt-whitelist-state\.json|\.bolt-acceptance-state\.json|bolts/[^[:space:]]*((pre|post)flight|acceptance)\.json|bolts/_batch-suite\.json|uat/evidence/[^[:space:]]*result\.json|\.stop-scan-stamp|\.ptu-scan-stamp|\.mega-sdd/\.cache/pack-resolver/[^[:space:]]*'
    # S4 BC-BINDING-DELETE rail: deleting binding docs is a one-indirection
    # bypass (orphaned units re-validate to PASS). rm/unlink of a binding doc
    # under .mega-sdd/vaults/ is denied; re-binds OVERWRITE via Write, never rm.
    # The deterministic backstop lives in validate-handoff-binding-units.sh
    # (binding_missing drop when units cite conflicts and no binding doc exists).
    PROTECTED_RM_ONLY='\.mega-sdd/vaults/[^[:space:]]*binding[^[:space:]]*\.md'

    BYPASS_DETECTED=""
    if echo "$BASH_CMD" | grep -qE "\b(rm|unlink)\s+[^|;&]*($PROTECTED)"; then
      BYPASS_DETECTED="rm/unlink of protected state file"
    elif echo "$BASH_CMD" | grep -qE "\b(truncate|shred)\s+[^|;&]*($PROTECTED)"; then
      BYPASS_DETECTED="truncate/shred of protected state file"
    elif echo "$BASH_CMD" | grep -qE "\bfind\s+[^|;&]*($PROTECTED)[^|;&]*-delete" || echo "$BASH_CMD" | grep -qE "\bfind\s+[^|;&]*-delete[^|;&]*($PROTECTED)" || { echo "$BASH_CMD" | grep -qE "\bfind\b.*-delete" && echo "$BASH_CMD" | grep -qE "($PROTECTED)"; }; then
      BYPASS_DETECTED="find -delete targeting protected state file"
    elif echo "$BASH_CMD" | grep -qE "os\.(remove|unlink)|pathlib[^|;&]*unlink|Path\([^)]*($PROTECTED)" && echo "$BASH_CMD" | grep -qE "($PROTECTED)"; then
      BYPASS_DETECTED="python file removal targeting protected state file"
    # S6 EB-GATE-5: python file WRITE verbs — the guard enumerated removal/
    # redirect shapes but not open(...,'w'), so a one-liner forged a PASS state
    # the (pre-S6) gate then trusted. open() in READ mode stays allowed (the
    # mode letter must appear in the SAME call as the protected path).
    # [[:space:]] not \s — this runs under BSD grep on macOS where \s is literal.
    # [^;|&]* (not [^)]*) so a nested call like open(os.path.join(root,PROTECTED),'w')
    # is still caught (the join'"'"'s ) no longer terminates the scan). Layered defense —
    # a variable-indirected target (f=…; open(f,'w')) is NOT caught here; for the six
    # gate STATES that is covered by gate-time re-derivation, and for the two evidence
    # artifacts it is the documented best-effort residual (see CLAUDE.md inventory).
    elif echo "$BASH_CMD" | grep -qE "open[[:space:]]*\([^;|&]*($PROTECTED)[^;|&]*,[[:space:]]*[\"'][wax]" ; then
      BYPASS_DETECTED="python open-for-write targeting protected state file"
    elif echo "$BASH_CMD" | grep -qE "($PROTECTED)[\"']?[[:space:]]*\)?[[:space:]]*\.write_(text|bytes)[[:space:]]*\("; then
      BYPASS_DETECTED="python write_text/write_bytes targeting protected state file"
    elif echo "$BASH_CMD" | grep -qE "\bdd\b[^|;&]*\bof=[^|;&]*($PROTECTED)"; then
      BYPASS_DETECTED="dd of= overwriting protected state file"
    elif echo "$BASH_CMD" | grep -qE "\binstall\s+[^|;&]*($PROTECTED)"; then
      BYPASS_DETECTED="install(1) replacing protected state file"
    elif echo "$BASH_CMD" | grep -qE "\b(rm|unlink)\s+[^|;&]*($PROTECTED_RM_ONLY)"; then
      BYPASS_DETECTED="rm/unlink of a binding doc (deleting binding.md erases active CONFLICTs and orphans unit citations — invariant #2/#3)"
    elif echo "$BASH_CMD" | grep -qE ">[[:space:]]*[^|;&]*($PROTECTED)"; then
      BYPASS_DETECTED="shell redirect (>) overwriting protected state file"
    elif echo "$BASH_CMD" | grep -qE "\bsed\s+(-[^[:space:]]*i[^[:space:]]*)\s+[^|;&]*($PROTECTED)"; then
      BYPASS_DETECTED="sed -i modifying protected state file"
    elif echo "$BASH_CMD" | grep -qE "\b(mv|cp)\s+[^|;&]*\s+[^|;&]*($PROTECTED)"; then
      BYPASS_DETECTED="mv/cp replacing protected state file"
    elif echo "$BASH_CMD" | grep -qE "\btee\s+[^|;&]*($PROTECTED)"; then
      BYPASS_DETECTED="tee overwriting protected state file"
    fi

    if [ -n "$BYPASS_DETECTED" ]; then
      REASON="Blocked: $BYPASS_DETECTED. Guard state files (moat + quality-gate states under .mega-sdd/) and the B1/B2/B4 evidence artifacts (preflight.json, postflight.json, acceptance.json, _batch-suite.json) are managed by hooks/validators/deterministic writers — direct agent modification is a forged gate verdict, and a hand-written preflight is a forged BASELINE (a wrong sha256 at pre-flight makes a DO_NOT_MODIFY violation undetectable). To clear a blocker, fix the underlying issue and let the validators re-derive (they re-run at the execute-bolts gate), or run the sanctioned writer (scripts/run-preflight-scan.sh / scripts/run-postflight-scan.sh / scripts/run-acceptance-tests.sh / scripts/run-full-suite.sh). Human user can still modify these files via shell outside the agent."
      emit_block "$REASON"
    fi
    ;;
esac

# Default: allow the tool call
exit 0
