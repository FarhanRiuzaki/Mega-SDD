#!/usr/bin/env bash
# PreToolUse hook for mega-sdd plugin.
#
# [HOOK-VALIDATE] enforcement layer. Blocks two classes of agent actions:
#   1. mega-sdd:execute-bolts while a HARD-BLOCK gate is FAILing (the gate
#      aggregator below — the binding->units moat gate + the kept code-delivery
#      quality gates). The DEMOTED code-delivery checks (dispatch-prompt,
#      operator-UX, fan-out-parity, ui-deferral, vault-flow-staging) are advisory
#      only and surface via analyze — they do NOT block here.
#   2. Anti-self-bypass: agent attempts to delete/truncate/overwrite guard state
#      files (.validation-blockers.json, .plan-pending, .replan-budget,
#      .iter-classifier.json).
#
# Honest design constraint: the human user (Farhan) is not the adversary — they
# are on the same side as the guard. The agent (Claude) is what we constrain.
# Manual override via filesystem ops outside agent context (user types `rm` in
# their shell) is a FEATURE, not a leak. Hooks only see tool calls from the
# agent; user-shell ops bypass hooks naturally.
#
# Output protocol (Claude Code PreToolUse):
#   - JSON to stdout with hookSpecificOutput.permissionDecision: "deny" (current
#     → tool is blocked; reason shown to agent
#   - Or exit 2 with stderr message → tool is blocked (other non-zero codes are non-blocking notices)
#   - Else exit 0 → tool proceeds normally
#
# Input (stdin): JSON {session_id, cwd, tool_name, tool_input, ...}

set -uo pipefail

# stdin read with a BUILTIN (spec §4b — this hook fires on every Bash/Edit/Write/
# Skill call; the `cat` exec was pure plumbing). read -d '' consumes to EOF (JSON
# carries no NUL); rc is non-zero at EOF by design, hence the `|| true`.
STDIN_JSON=""
IFS= read -r -d '' STDIN_JSON || true
[ -n "$STDIN_JSON" ] || STDIN_JSON='{}'

# ─── Fast negative short-circuit (pure shell, BEFORE the python3 parse) ────────
# Speed: the matcher is global (Skill|Bash|Edit|Write), so EVERY such tool call in
# EVERY project hits this blocking hook — including non-mega-sdd projects, where the
# .mega-sdd gate below simply no-ops. Resolve cwd + project root in pure shell here
# and exit 0 BEFORE paying a python3 cold-start (~30-150ms) when there is no
# .mega-sdd ancestor. This is MOAT-NEUTRAL by construction: it fires ONLY when no
# .mega-sdd exists — mutually exclusive with the fall-through path that reaches the
# gates, so it can never bypass invariant #2 or any other gate. It uses a BUILTIN
# cwd extraction (spec §4b) equivalent to the historical `sed -n 's/.*"cwd"…/p' |
# head -1` on the single-line JSON the harness emits: greedy `.*` = LAST match
# wins, reproduced by looping [[ =~ ]] to the final occurrence (pinned by the
# corpus parity test), and the SAME resolve_project_root walk-up as the
# authoritative gate, so its .mega-sdd decision is byte-identical. When the cwd
# can't be extracted OR the resolver helper is absent, it does NOT short-circuit —
# it falls through to the authoritative path.
SC_CWD=""
SC_REST="$STDIN_JSON"
while [[ "$SC_REST" =~ \"cwd\"[[:space:]]*:[[:space:]]*\"([^\"]*)\"(.*) ]]; do
  SC_CWD="${BASH_REMATCH[1]}"
  SC_REST="${BASH_REMATCH[2]}"
done
if [ -n "$SC_CWD" ]; then
  # Script-dir via parameter expansion (no dirname exec); $0 is absolute in the
  # shipped dispatch (run-hook.sh) — the subshell fallback covers a relative $0.
  SC_SCRIPT_DIR="${0%/*}"
  case "$SC_SCRIPT_DIR" in
    /*) ;;
    *) SC_SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd 2>/dev/null)" ;;
  esac
  SC_RPR="${SC_SCRIPT_DIR}/../scripts/_lib/resolve-project-root.sh"
  if [ -f "$SC_RPR" ]; then
    # shellcheck disable=SC1090
    . "$SC_RPR"
    SC_ROOT=$(resolve_project_root "$SC_CWD")
    if [ ! -d "${SC_ROOT}/.mega-sdd" ]; then exit 0; fi

    # ── v7 tier-S fast path (spec 2026-08-21-v7-weighted-routing-design.md §3.2) ──
    # Size cap (review R-6): the pure-bash substring/regex scans below are
    # O(payload); a multi-MB Edit costs more in bash than the python it avoids.
    # Oversized stdin takes the classic python path (correct, just not free).
    if [ "${#STDIN_JSON}" -gt 262144 ]; then SC_SKIP_FAST=1; else SC_SKIP_FAST=0; fi
    if [ "$SC_SKIP_FAST" -eq 0 ]; then
    # In a mega-sdd project WITHOUT an active chain this session, an ordinary
    # Edit/Write/Bash must cost ZERO forks. Pure-shell decision, FAIL-CLOSED:
    # any extraction doubt, any protected-substring hit, or any armed/unknown
    # state falls through to the authoritative python path below (old behavior).
    # armed ⇔ .gateguard-state.json carries chain_engaged for THIS session_id —
    # written by the Skill branch on the first mega-sdd:* dispatch (§3.1; the
    # gate-0 factory-ledger AND was dropped: the ledger does not exist until the
    # first phase handoff, which would have un-armed the whole first greenfield
    # chain — see spec §7 amendment 1).
    SC_TOOL=""
    SC_REST2="$STDIN_JSON"
    while [[ "$SC_REST2" =~ \"tool_name\"[[:space:]]*:[[:space:]]*\"([^\"]*)\"(.*) ]]; do
      SC_TOOL="${BASH_REMATCH[1]}"; SC_REST2="${BASH_REMATCH[2]}"
    done
    case "$SC_TOOL" in
      Edit|Write|Bash)
        # Protected-substring pre-filter — ONE union list for ALL tools. The
        # fragments are a SUPERSET of every basename/path the FP_GUARD + Bash
        # anti-self-bypass patterns can match (mega-sdd covers .mega-sdd/ +
        # docs/mega-sdd/; -bound covers the legacy vault layout; the rest are
        # the guarded state/evidence names). Deliberately NOT per-tool: the
        # shell tool_name extraction is spoofable from inside tool_input (a
        # command containing '"tool_name": "Edit"' would flip a last-match
        # scan), so the filter must not depend on which tool we THINK this is —
        # any fragment hit takes the full python path regardless. A false
        # positive costs one python pass; a miss is impossible for the guarded set.
        SC_PROT=0
        case "$STDIN_JSON" in
          *mega-sdd*|*-bound*|*validation-blockers*|*plan-pending*|*replan-budget*|*iter-classifier*|*-state.json*|*ui-quality-blockers*|*bolts/*|*uat/evidence*|*scan-stamp*|*pack-resolver*|*binding*) SC_PROT=1 ;;
        esac
        if [ "$SC_PROT" -eq 0 ]; then
          # Subagent fail-closed rail (R2, gate-1): subagent-context tool calls
          # ALWAYS take the full (armed) path — the docs guarantee agent_id /
          # parent_tool_use_id / agent_transcript_path appear ONLY in subagent
          # context (code.claude.com/docs/en/hooks "Common Subagent Context
          # Fields"), while session_id semantics there are undocumented. Keying
          # on the sentinels makes the session_id ambiguity moot: bolt
          # implementer edits stay gated regardless. A chain paused in Plan
          # mode also takes the full path.
          case "$STDIN_JSON" in *'"agent_id"'*|*'"parent_tool_use_id"'*|*agent_transcript_path*) SC_PROT=1 ;; esac
          [ -f "${SC_ROOT}/.mega-sdd/.plan-pending" ] && SC_PROT=1
        fi
        if [ "$SC_PROT" -eq 0 ]; then
          SC_SID=""
          SC_REST3="$STDIN_JSON"
          while [[ "$SC_REST3" =~ \"session_id\"[[:space:]]*:[[:space:]]*\"([^\"]*)\"(.*) ]]; do
            SC_SID="${BASH_REMATCH[1]}"; SC_REST3="${BASH_REMATCH[2]}"
          done
          if [ -n "$SC_SID" ]; then
            SC_GG="${SC_ROOT}/.mega-sdd/.gateguard-state.json"
            if [ ! -f "$SC_GG" ]; then
              exit 0   # no session gate-state at all → chain never engaged → tier S
            fi
            SC_GG_C=""
            { SC_GG_C="$(<"$SC_GG")"; } 2>/dev/null || SC_GG_C=""
            if [ -n "$SC_GG_C" ]; then
              case "$SC_GG_C" in
                *"\"$SC_SID\": true"*|*"\"$SC_SID\":true"*) : ;;  # engaged_sessions map hit → armed → full path
                *"\"session_id\": \"$SC_SID\""*|*"\"session_id\":\"$SC_SID\""*)
                  case "$SC_GG_C" in
                    *'"chain_engaged": true'*|*'"chain_engaged":true'*) : ;;  # armed → full path
                    *) exit 0 ;;   # this session never engaged → tier S
                  esac ;;
                *) exit 0 ;;       # neither the map nor the top record knows this session → tier S
              esac
            fi
            # unreadable/empty state → fail closed (fall through)
          fi
          # session_id not extractable → fail closed (fall through)
        fi
        ;;
      *) : ;;  # Skill / unknown / unextractable → always the full path
    esac
    fi  # SC_SKIP_FAST
  fi
fi

# Parse via python3. Every value is shell-quoted with shlex.quote() — the consumer
# is `eval`, which re-parses a bare `KEY=value`: a space silently drops the value,
# a backslash is eaten (destroying every Windows path, so CWD became `C:proj` and
# PROJECT_ROOT was garbage), and $(…) is EXECUTED. file_path/command/args stay on
# the base64 channel; `emit()` covers everything else.
PARSE_OUTPUT=$(printf '%s' "$STDIN_JSON" | python3 -c '
import json
import shlex
import sys
import base64

def emit(key, value):
    print(key + "=" + shlex.quote(str(value)))

try:
    data = json.loads(sys.stdin.read())
except Exception:
    sys.exit(0)

cwd = data.get("cwd", "")
tool_name = data.get("tool_name", "")
tool_input = data.get("tool_input", {})
transcript_path = data.get("transcript_path", "")

emit("CWD", cwd)
emit("TOOL_NAME", tool_name)
emit("TRANSCRIPT_PATH", transcript_path)
emit("SESSION_ID", data.get("session_id", ""))

if tool_name == "Skill":
    emit("SKILL_NAME", tool_input.get("skill", ""))
    args = tool_input.get("args", "") or ""
    emit("SKILL_ARGS_B64", base64.b64encode(str(args).encode()).decode())
elif tool_name == "Bash":
    cmd = tool_input.get("command", "")
    emit("BASH_CMD_B64", base64.b64encode(cmd.encode()).decode())
elif tool_name in ("Edit", "Write"):
    fp = tool_input.get("file_path", "")
    emit("FILE_PATH_B64", base64.b64encode(fp.encode()).decode())
' 2>/dev/null)

if [ -z "$PARSE_OUTPUT" ]; then
  # ── python3-UNUSABLE fail-closed fallback (moat integrity) ─────────────────
  # Without a working python3 the JSON parse yields nothing and this hook would
  # silently fail OPEN — bypassing the binding→units gate. Best-effort shell
  # extraction: block execute-bolts when a blockers file exists and does not
  # attest PASS.
  #
  # The guard USED to be `! command -v python3`, which is a FALSE POSITIVE on
  # Windows: the App Execution Alias stub in %LOCALAPPDATA%\Microsoft\WindowsApps
  # is on the default PATH, so `command -v` succeeded, this branch never ran, and
  # the hook exited 0 with every gate unevaluated — the moat died silently.
  # Measured on a Windows 11 corporate laptop 2026-07-28 (python3 AND python both
  # stubs, `py` absent). mega_sdd_python resolves a USABLE interpreter, fork-free.
  PY_LIB="${0%/*}/../scripts/_lib/resolve-python.sh"
  PY_USABLE=1
  if [ -f "$PY_LIB" ]; then
    # shellcheck disable=SC1090
    . "$PY_LIB"
    mega_sdd_python >/dev/null 2>&1 || PY_USABLE=0
  else
    command -v python3 >/dev/null 2>&1 || PY_USABLE=0
  fi
  if [ "$PY_USABLE" -eq 0 ]; then
    FB_CWD=$(printf '%s' "$STDIN_JSON" | sed -n 's/.*"cwd"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
    # Windows cwd arrives with backslashes (JSON-escaped); normalize so the
    # -d test below can actually find .mega-sdd.
    case "${OSTYPE:-}" in msys*|cygwin*|win32*) FB_CWD="${FB_CWD//\\//}" ;; esac
    FB_SKILL=$(printf '%s' "$STDIN_JSON" | sed -n 's/.*"skill"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
    if [ -n "$FB_CWD" ] && [ -d "${FB_CWD}/.mega-sdd" ]; then
      case "$FB_SKILL" in
        *execute-bolts*)
          FB_MOAT="${FB_CWD}/.mega-sdd/.validation-blockers.json"
          if [ -f "$FB_MOAT" ] && ! grep -q '"status"[[:space:]]*:[[:space:]]*"PASS"' "$FB_MOAT" 2>/dev/null; then
            printf '{"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny", "permissionDecisionReason": "mega-sdd gate (fail-closed): no usable python3 interpreter, and .validation-blockers.json does not attest PASS. Keterangan: hook mega-sdd butuh python3 untuk mengevaluasi gate; tanpa itu gate tidak bisa dipercaya, jadi execute-bolts diblokir alih-alih diloloskan diam-diam. Di Windows penyebab tersering adalah App Execution Alias stub di %%LOCALAPPDATA%%\\\\Microsoft\\\\WindowsApps yang terlihat ada di PATH tapi bukan Python. Remedy: jalankan `/mega-sdd:install-deps` — di Windows pilih route scoop (`scoop install python`), satu-satunya yang menghasilkan perintah `python3` berfungsi; winget/python.org hanya memasang python.exe + py.exe sehingga `python3` tetap jatuh ke stub. Kemudian selesaikan blocker sebelum execute-bolts."}, "decision": "block", "reason": "mega-sdd gate fail-closed: no usable python3"}\n'
            exit 0
          fi
          ;;
      esac
    fi
  fi
  exit 0
fi
eval "$PARSE_OUTPUT" 2>/dev/null || true

if [ -z "${CWD:-}" ]; then exit 0; fi

# ─── Resolve project root ────────────────────────────────────────────────────
# Model may cd into a subfolder during a chain step (extract-intelligence often
# operates inside .mega-sdd/knowledge-base/). Without walking up, ${CWD}/.mega-sdd/
# → .mega-sdd/knowledge-base/.mega-sdd/ (nested). resolve_project_root walks UP
# to the outermost .mega-sdd/ parent. Fallback: original CWD.
# Script-dir via parameter expansion (spec §4b — no dirname exec); $0 is
# absolute in the shipped dispatch; the subshell fallback covers relative $0.
SCRIPT_DIR_RPR="${0%/*}"
case "$SCRIPT_DIR_RPR" in
  /*) ;;
  *) SCRIPT_DIR_RPR="$(cd "$(dirname "$0")" && pwd 2>/dev/null)" ;;
esac
RPR_HELPER="${SCRIPT_DIR_RPR}/../scripts/_lib/resolve-project-root.sh"
if [ -f "$RPR_HELPER" ]; then
  # shellcheck disable=SC1090
  . "$RPR_HELPER"
  PROJECT_ROOT=$(resolve_project_root "$CWD")
else
  PROJECT_ROOT="$CWD"
fi

# Only act on mega-sdd projects (skip if .mega-sdd/ doesn't exist).
# Ordered BEFORE the config grep: this 1-stat check is the common-case exit for
# every non-SDD project, and config.yaml only exists inside .mega-sdd/ anyway.
if [ ! -d "${PROJECT_ROOT}/.mega-sdd" ]; then exit 0; fi

# Opt-out: telemetry: false in config.yaml also disables this hook
# (a project that opts out of telemetry generally wants to opt out of guards too)
CONFIG_FILE="${PROJECT_ROOT}/.mega-sdd/config.yaml"
if [ -f "$CONFIG_FILE" ]; then
  if grep -qE "^\s*telemetry:\s*false" "$CONFIG_FILE" 2>/dev/null; then
    exit 0
  fi
fi

# ─── v7 chain-armed probe (spec §3.1) ────────────────────────────────────────
# armed ⇔ .gateguard-state.json carries chain_engaged for THIS session (the
# Skill branch writes it on the first mega-sdd:* dispatch). Fork-free bash read.
# Fail-CLOSED: an unreadable state, a missing session_id, a subagent-carrying
# stdin, or a paused Plan chain all count as armed (gates run — moat-safe).
v7_chain_armed() {
  local sid="${SESSION_ID:-}" gg="${PROJECT_ROOT}/.mega-sdd/.gateguard-state.json" c=""
  # Subagent sentinels (R2): subagent context is ALWAYS armed — see the fast-path rail.
  case "$STDIN_JSON" in *'"agent_id"'*|*'"parent_tool_use_id"'*|*agent_transcript_path*) return 0 ;; esac
  [ -f "${PROJECT_ROOT}/.mega-sdd/.plan-pending" ] && return 0
  [ -n "$sid" ] || sid="no-session"
  [ -f "$gg" ] || return 1
  { c="$(<"$gg")"; } 2>/dev/null || return 0
  [ -n "$c" ] || return 0
  # v7 review R-2 (shared worktree): armed if MY sid is in the engaged_sessions
  # map — a concurrent session re-stamping the top-level record never un-arms me.
  case "$c" in
    *"\"$sid\": true"*|*"\"$sid\":true"*) return 0 ;;
  esac
  case "$c" in
    *"\"session_id\": \"$sid\""*|*"\"session_id\":\"$sid\""*) : ;;
    *) return 1 ;;
  esac
  case "$c" in
    *'"chain_engaged": true'*|*'"chain_engaged":true'*) return 0 ;;
    *) return 1 ;;
  esac
}

# Helper: emit block JSON to stdout and exit
emit_block() {
  local reason="$1"
  # Escape for JSON string (basic)
  local reason_json
  reason_json=$(printf '%s' "$reason" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))' 2>/dev/null)
  if [ -z "$reason_json" ]; then
    # no-python3 fallback: strip JSON-hostile chars so the deny JSON stays valid
    reason_json="\"$(printf '%s' "$reason" | tr '"\\' "'/" | tr -d '\n')\""
  fi
  # Current PreToolUse contract (code.claude.com/docs/en/hooks): deny via
  # hookSpecificOutput.permissionDecision — {"continue": false} is NOT
  # processed for PreToolUse (it only stops the session on other events).
  # The legacy decision/block pair rides along for older Claude Code versions.
  cat <<EOF
{"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny", "permissionDecisionReason": $reason_json}, "decision": "block", "reason": $reason_json}
EOF
  exit 0  # PreToolUse uses stdout JSON for block, not exit code
}

# ─── BRANCH 1: Skill invocation gate ─────────────────────────────────────────
case "${TOOL_NAME:-}" in
  Skill)
    # ── v7 chain-engaged marker writer (spec §3.1) ──────────────────────────
    # A mega-sdd:* Skill dispatch IS chain activity: record chain_engaged for
    # this session in the EXISTING session-keyed .gateguard-state.json (one new
    # field, no new file). From this moment the session is armed — GateGuard,
    # the PostToolUse validator fan-out, and the compaction advisor all run
    # exactly as before v7. using-mega-sdd is excluded (router, not a chain
    # step — same exclusion Branch 1a has always used). Runs BEFORE any gate so
    # even a blocked dispatch arms the session (conservative).
    case "${SKILL_NAME:-}" in
      mega-sdd:using-mega-sdd) : ;;
      mega-sdd:*)
        SESSION_ID="${SESSION_ID:-}" PROJECT_ROOT="$PROJECT_ROOT" python3 - <<'PYCE' 2>/dev/null || true
import json, os
sid = os.environ.get("SESSION_ID", "") or "no-session"
p = os.path.join(os.environ["PROJECT_ROOT"], ".mega-sdd", ".gateguard-state.json")
# v7 review R-2 (shared worktree): arming is PER-SESSION via the engaged_sessions
# map — a 2nd session's dispatch must never un-arm a concurrent session's chain.
# Top-level session_id/chain_engaged stay for the latest dispatcher (and the
# GateGuard entries LRU stays keyed to it, pre-v7 semantics); the map is the
# durable multi-session arm record (capped at 50 sids, insertion order).
state = {"session_id": sid, "chain_engaged": True, "entries": {}}
engaged = {}
try:
    prev = json.load(open(p))
    engaged = dict(prev.get("engaged_sessions") or {})
    psid = prev.get("session_id")
    if psid and prev.get("chain_engaged"):
        engaged[psid] = True
    if psid == sid:
        prev["chain_engaged"] = True
        state = prev
except Exception:
    pass
engaged[sid] = True
if len(engaged) > 50:
    engaged = dict(list(engaged.items())[-50:])
state["engaged_sessions"] = engaged
tmp = p + ".tmp"
try:
    with open(tmp, "w") as f:
        json.dump(state, f)
    os.replace(tmp, p)
except Exception:
    pass
PYCE
        ;;
    esac
    # Branch 1c: scope flag validation for orchestrate-flow (the /mega-sdd front
    # door) / generate-intent; the mega-sdd:auto case arm is inert since the
    # 6.0.0 alias cull (no auto skill exists) — kept as a harmless dead match.
    # Reads transcript_path to find user's most recent message +
    # extract --scope=X flag (args not in tool_input). Validates against PRD scopes.
    case "${SKILL_NAME:-}" in
      mega-sdd:auto|mega-sdd:generate-intent|mega-sdd:orchestrate-flow)
        if [ -n "${TRANSCRIPT_PATH:-}" ] && [ -f "$TRANSCRIPT_PATH" ]; then
          # Extract most recent USER message text from transcript
          USER_MSG=$(TRANSCRIPT_PATH="$TRANSCRIPT_PATH" python3 -c '
import json, os
last_user_text = None
with open(os.environ["TRANSCRIPT_PATH"]) as f:
    for line in f:
        try:
            rec = json.loads(line)
        except Exception:
            continue
        msg = rec.get("message") if isinstance(rec.get("message"), dict) else None
        if not msg or msg.get("role") != "user":
            continue
        content = msg.get("content")
        if isinstance(content, str):
            last_user_text = content
        elif isinstance(content, list):
            parts = [b.get("text","") for b in content if isinstance(b, dict) and b.get("type") == "text"]
            if parts:
                last_user_text = "\n".join(parts)
if last_user_text:
    print(last_user_text)
' 2>/dev/null)

          if [ -n "$USER_MSG" ]; then
            SCRIPT_DIR_HV="$(cd "$(dirname "$0")" && pwd)"
            VALIDATOR_SCOPE="${SCRIPT_DIR_HV}/../scripts/validate-scope-flag.sh"
            if [ -x "$VALIDATOR_SCOPE" ]; then
              SCOPE_RESULT=$(printf '%s' "$USER_MSG" | bash "$VALIDATOR_SCOPE" --cwd="$PROJECT_ROOT" --quiet 2>/dev/null)
              SCOPE_EXIT=$?
              if [ "$SCOPE_EXIT" = "1" ]; then
                # FAIL — extract stopReason from state file and emit block
                STATE_SCOPE="${PROJECT_ROOT}/.mega-sdd/.scope-flag-state.json"
                if [ -f "$STATE_SCOPE" ]; then
                  STOP_REASON=$(python3 -c "
import json
try:
    d = json.load(open('$STATE_SCOPE'))
    print(d.get('stopReason', 'scope_not_declared_in_prd'))
except Exception:
    print('scope_not_declared_in_prd')
" 2>/dev/null)
                  emit_block "$STOP_REASON"
                fi
              fi
            fi
          fi
        fi
        ;;
    esac

    # Branch 0-pre: Factory Line backward-dispatch halt (R3-1). When the factory
    # ledger shows a phase has breached its retry cap (phase_stuck) or re-ran with
    # no progress (anti_spin), re-dispatching THAT SAME upstream phase will only spin
    # — block it. The forward execute-bolts aggregator already covers the downstream
    # side; this closes the backward side (factory-routing.md step-4 safety checks).
    # RECOMPUTE first (like preflight/scope-flag below) so a ledger reset SELF-CLEARS:
    # the validator with no raw ledger writes SKIP → no block (no stale-state deadlock).
    # Per-phase precision: ONLY the stuck phase is blocked — a sibling phase (e.g. a
    # re-scan to FIX the stuck bind) stays allowed. orchestrate-flow / auto are NOT
    # gated: they own the --resume recovery route. Placed BEFORE preflight so a stuck
    # preflight-gated phase reports the more-specific Factory halt.
    case "${SKILL_NAME:-}" in
      mega-sdd:extract-intelligence|mega-sdd:generate-intent|mega-sdd:scan-codebase|mega-sdd:bind-codebase|mega-sdd:generate-units)
        FACTORY_VALIDATOR="${SCRIPT_DIR_RPR}/../scripts/validate-factory-ledger.sh"
        if [ -x "$FACTORY_VALIDATOR" ]; then
          bash "$FACTORY_VALIDATOR" --cwd="$PROJECT_ROOT" --quiet >/dev/null 2>&1 || true
          FL_STATE="${PROJECT_ROOT}/.mega-sdd/.factory-ledger-state.json"
          if [ -f "$FL_STATE" ]; then
            FL_REASON=$(SKILL_NAME="$SKILL_NAME" FL_STATE="$FL_STATE" PROJECT_ROOT="$PROJECT_ROOT" python3 -c '
import json, os
d_state = os.environ["FL_STATE"]
skill = os.environ["SKILL_NAME"]
md = os.path.join(os.environ["PROJECT_ROOT"], ".mega-sdd")
phase = skill.split(":")[-1]
try:
    d = json.load(open(d_state))
except Exception:
    raise SystemExit(0)
if not d or d.get("status") != "FAIL":
    raise SystemExit(0)
# Map each breached phase to its halt class. A schema/unparseable FAIL has no
# cap/spin breaches → no phase match → never blocks (the forward gate handles those).
stuck = {}
for b in (d.get("cap_breaches") or []):
    stuck[b.get("phase")] = "phase_stuck"
for b in (d.get("spin_breaches") or []):
    stuck.setdefault(b.get("phase"), "anti_spin")
if phase not in stuck:
    raise SystemExit(0)
halt = stuck[phase]
msg = (d.get("details", {}) or {}).get("message") or "factory halt"
print(
    "%s is blocked by the Factory Line — phase %s is HALTED (%s): %s. Re-dispatching the "
    "same stuck phase will only spin. RECOVERY: resolve the underlying OQ/CONFLICT for this "
    "phase, then RESET the rebuildable ledger (rm %s/factory-ledger.json — it rebuilds from "
    "phase handoffs, clearing the stale attempt history; it is NOT anti-self-bypass protected) "
    "and re-run via /mega-sdd --resume. State: %s"
    % (skill, phase, halt, msg, md, d_state)
)
' 2>/dev/null)
            if [ -n "$FL_REASON" ]; then emit_block "$FL_REASON"; fi
          fi
        fi
        ;;
    esac

    # Branch 0: predictive preflight — fatal INPUT-precondition check for the skill
    # about to run, BEFORE it burns minutes and halts mid-way. Conservative: only
    # GENUINELY-FATAL preconditions block (a skill that cannot do anything useful
    # without the missing input). scan-codebase tree-sitter is WARN-only (never
    # FATAL). State recomputed each invocation → self-clears (no deadlock).
    case "${SKILL_NAME:-}" in
      mega-sdd:bind-codebase|mega-sdd:generate-units|mega-sdd:execute-bolts|mega-sdd:scan-codebase)
        PREFLIGHT="${SCRIPT_DIR_RPR}/../scripts/validate-preflight.sh"
        if [ -x "$PREFLIGHT" ]; then
          # P2: the dispatch args ride along (b64; decoded inside the script's
          # python) so the bind map-check can honor the --express lane without
          # an extra spawn here.
          bash "$PREFLIGHT" --cwd="$PROJECT_ROOT" --skill="$SKILL_NAME" --args-b64="${SKILL_ARGS_B64:-}" --quiet >/dev/null 2>&1 || true
          PF_STATE="${PROJECT_ROOT}/.mega-sdd/.preflight-state.json"
          if [ -f "$PF_STATE" ]; then
            PF_STATUS=$(python3 -c "
import json
try:
    print(json.load(open('$PF_STATE')).get('status', 'PASS'))
except Exception:
    print('PARSE_ERROR')
" 2>/dev/null)
            if [ "$PF_STATUS" = "FATAL" ]; then
              PF_MSG=$(python3 -c "
import json
try:
    print(json.load(open('$PF_STATE')).get('fatal_on_fail', ''))
except Exception:
    print('')
" 2>/dev/null)
              emit_block "${SKILL_NAME} is blocked by a predictive preflight check — ${PF_MSG} (preflight state: ${PF_STATE})"
            fi
          fi
        fi
        ;;
    esac

    # Branch 1a: handoff validation gate — applies to ALL mega-sdd:* skills except
    # using-mega-sdd (auto-loaded anchor, not a chain step).
    #
    # Producer self-fix attempts MUST be allowed. The state file records WHICH skill
    # emitted the bad handoff (state.skill_name); when the same skill is being
    # re-invoked, that IS the producer attempting to re-run with a fixed template —
    # let it through so its re-emitted handoff overwrites the FAIL state.
    case "${SKILL_NAME:-}" in
      mega-sdd:*)
        if [ "${SKILL_NAME:-}" != "mega-sdd:using-mega-sdd" ]; then
          HANDOFF_STATE="${PROJECT_ROOT}/.mega-sdd/.handoff-validation-state.json"
          # ── v7 gate-time derivation (spec §3.4 as amended §7.4) ───────────
          # Closes the fresh-session/TOCTOU gap ONLY: when NO handoff state
          # exists (fresh clone/session — the case Stop cannot have covered),
          # derive it here from the transcript. When a state EXISTS it is
          # trusted as pre-v7 (Stop wrote it at turn end) — re-running the
          # validator on the same text at every dispatch double-counts
          # retry_count and prematurely escalates C1→C2 (review R-4), and the
          # full always-recompute needs a validator-side content hash, which
          # lands in Phase 2 together with the Stop-leg removal. The text must
          # carry a REAL envelope (line-start emitted_by:) — a narration that
          # merely mentions handoff: is not a handoff (review R-3).
          if [ ! -f "$HANDOFF_STATE" ] && [ -n "${TRANSCRIPT_PATH:-}" ] && [ -f "$TRANSCRIPT_PATH" ]; then
            HV_LAST=$(TRANSCRIPT_PATH="$TRANSCRIPT_PATH" python3 -c '
import json, os
last_text = None
with open(os.environ["TRANSCRIPT_PATH"]) as f:
    for line in f:
        try:
            rec = json.loads(line)
        except Exception:
            continue
        msg = rec.get("message") if isinstance(rec.get("message"), dict) else None
        if not msg or msg.get("role") != "assistant":
            continue
        content = msg.get("content")
        if isinstance(content, str):
            last_text = content
        elif isinstance(content, list):
            parts = [b.get("text","") for b in content if isinstance(b, dict) and b.get("type") == "text"]
            if parts:
                last_text = "\n".join(parts)
if last_text:
    print(last_text)
' 2>/dev/null)
            if [ -n "$HV_LAST" ] && printf '%s' "$HV_LAST" | grep -q "handoff:" \
               && printf '%s' "$HV_LAST" | grep -qE "^[[:space:]]*emitted_by:"; then
              HV_VALIDATOR="${SCRIPT_DIR_RPR}/../scripts/validate-handoff-yaml.sh"
              if [ -x "$HV_VALIDATOR" ]; then
                HV_SKILL=$(printf '%s' "$HV_LAST" | python3 -c '
import sys, re
m = re.search(r"^\s*emitted_by:\s*(?:mega-sdd:)?([\w-]+)", sys.stdin.read(), re.MULTILINE)
print(m.group(1) if m else "unknown")
' 2>/dev/null)
                printf '%s' "$HV_LAST" | bash "$HV_VALIDATOR" --cwd="$PROJECT_ROOT" --skill-name="mega-sdd:${HV_SKILL:-unknown}" --quiet >/dev/null 2>&1 || true
              fi
            fi
          fi
          if [ -f "$HANDOFF_STATE" ]; then
            HSTATUS_AND_PRODUCER=$(STATE_PATH="$HANDOFF_STATE" python3 -c "
import json, os
try:
    d = json.load(open(os.environ['STATE_PATH']))
    print(d.get('status', 'UNKNOWN'))
    print(d.get('skill_name', ''))
except Exception:
    print('PARSE_ERROR')
    print('')
" 2>/dev/null)
            HSTATUS=$(echo "$HSTATUS_AND_PRODUCER" | sed -n '1p')
            STATE_PRODUCER=$(echo "$HSTATUS_AND_PRODUCER" | sed -n '2p')
            if [ "$HSTATUS" = "FAIL" ]; then
              if [ -n "$STATE_PRODUCER" ] && [ "$SKILL_NAME" = "$STATE_PRODUCER" ]; then
                : # producer self-fix retry — fall through to allow
              else
                HDETAIL=$(STATE_PATH="$HANDOFF_STATE" python3 -c "
import json, os
try:
    d = json.load(open(os.environ['STATE_PATH']))
    ht = d.get('halt_type', 'unknown')
    sk = d.get('skill_name', 'unknown')
    rc = d.get('retry_count', 0)
    esc = d.get('escalate_to_c2', False)
    na = d.get('next_action', {})
    hint = na.get('hint', '(no hint)') if isinstance(na, dict) else str(na)
    reason = d.get('details', {}).get('reason', '(no reason)')
    print(f'upstream {sk} emitted bad handoff ({ht}, retry={rc}, escalate_c2={esc}). Reason: {reason}. Suggestion: {hint}')
except Exception as e:
    print(f'(state file parse error: {e})')
" 2>/dev/null)
                REASON="${SKILL_NAME} blocked by handoff validation — ${HDETAIL}. Resolve by EITHER (a) re-invoke the upstream producer (${STATE_PRODUCER:-unknown}) — this is auto-allowed and overwrites the FAIL state when it emits a valid handoff; OR (b) delete the stale state file manually: rm ${PROJECT_ROOT}/.mega-sdd/.handoff-validation-state.json (the file is NOT in the anti-self-bypass protected list)."
                emit_block "$REASON"
              fi
            fi
          fi
        fi
        ;;
    esac

    # ─── execute-bolts HARD-BLOCK gate aggregator ────────────────────────────
    # One data-driven pass over the gates Farhan kept as HARD BLOCKS (v4 Phase 2,
    # Hybrid decision). Replaces the former Branch 1b + Branches 5/6/7/8/11 + the
    # CD-4 multi-fail precompute. The MOAT gate (binding->units) is checked first.
    # Each gate reads its PostToolUse-written state file and blocks on its precise
    # failing condition (status==FAIL, or a specific halt_type count for render-test).
    # Multi-fail surfacing is built in: when >1 gate fails, all names are listed up
    # front so the agent fixes them together instead of one-at-a-time.
    #
    # DEMOTED to analyze advisory (NOT blocking here): dispatch-prompt,
    # operator-UX (vault-oqs), fan-out-parity, ui-deferral, vault-flow-staging.
    if [ "${SKILL_NAME:-}" = "mega-sdd:execute-bolts" ]; then
      # ── S4 BC-GATE-1 self-heal: the moat-state writer used to fire on UNIT
      # writes only, so a re-bind/sync that wrote binding.md with fresh active
      # CONFLICTs left .validation-blockers.json at a stale PASS (or absent)
      # and this gate opened over an unresolved CONFLICT (invariant #2). Same
      # class as INT-1: enforcement keyed to the wrong write path.
      # S4 round-2: re-validate UNCONDITIONALLY whenever a vaults dir exists —
      # an mtime heuristic here was defeated by (a) the nested units/U-*/unit.md
      # layout the ls globs cannot reach and (b) backdated mtimes (cp -p /
      # rsync -a restores). The validator is sub-second python and this is the
      # execute-bolts-only path; current truth beats a stale cache at a gate.
      # Round-2 (ATK-6): no vaults-dir condition — the legacy root *-bound layout
      # has units the validators see but no .mega-sdd/vaults/; every validator
      # handles the empty case gracefully (PASS/SKIP), so run unconditionally
      # (the hook already exited for non-mega-sdd projects).
      if [ -d "${PROJECT_ROOT}/.mega-sdd" ]; then
        bash "${SCRIPT_DIR_RPR}/../scripts/validate-handoff-binding-units.sh" --cwd="$PROJECT_ROOT" --quiet >/dev/null 2>&1 || true
        # ── S5 GU-HOOK-1/3/4: re-derive the three unit-stage gate states at gate
        # time too. Their PostToolUse dispatch is (a) keyed to the Write|Edit tool
        # path only (a unit written via Bash heredoc never re-validates — stale
        # PASS), and (b) async (TOCTOU: execute-bolts dispatched right after the
        # last unit write can read one-write-stale state). validate-unit-spec in
        # project mode + the two project-wide scanners are sub-second; current
        # truth beats a stale cache at the gate that launches a multi-minute run.
        bash "${SCRIPT_DIR_RPR}/../scripts/validate-unit-spec.sh" --cwd="$PROJECT_ROOT" --quiet >/dev/null 2>&1 || true
        bash "${SCRIPT_DIR_RPR}/../scripts/validate-flow-coverage.sh" --cwd="$PROJECT_ROOT" --quiet >/dev/null 2>&1 || true
        bash "${SCRIPT_DIR_RPR}/../scripts/validate-sibling-consistency.sh" --cwd="$PROJECT_ROOT" --quiet >/dev/null 2>&1 || true
        # ── S6 EB-GATE-1: re-derive the SIX bolt-stage/quality states at gate
        # time too. Their producers are Stop-hook keyed (orphans/batch-suite/
        # postflight: one-turn lag, and NONE exist on a fresh session/clone) or
        # Write|Edit-glob keyed (ui-quality/cross-cutting: a heredoc-written
        # view keeps a stale PASS), and factory-ledger previously ran only in
        # its own branch. Same doctrine as the moat: a stale, absent, or forged
        # state is overwritten with current truth BEFORE the aggregator reads
        # it (this also neutralizes any Bash-forged PASS — EB-GATE-5).
        # The five bolt-artifact scans run as ONE composable invocation (spec §4a-ii)
        # — one bash spawn-chain instead of five; every scan's python, state file, and
        # verdict are unchanged. Still here: B1 recompute-at-gate (--recompute
        # re-executes each committed Hard-rule bolt's mechanical rules from git/fs
        # ground truth and OVERWRITES its postflight.json before the state is derived
        # — a forged/stale evidence artifact cannot open the gate) and B4 acceptance
        # evidence (commit-keyed; the artifact is READ, never re-executed here —
        # re-running acceptance tests in a hook is the forbidden inflation).
        bash "${SCRIPT_DIR_RPR}/../scripts/validate-bolt-artifacts.sh" --cwd="$PROJECT_ROOT" --orphan-scan --batch-suite-gate --postflight-scan --recompute --whitelist-scan --acceptance-scan --quiet >/dev/null 2>&1 || true
        bash "${SCRIPT_DIR_RPR}/../scripts/validate-ui-quality.sh" --cwd="$PROJECT_ROOT" --quiet >/dev/null 2>&1 || true
        bash "${SCRIPT_DIR_RPR}/../scripts/validate-cross-cutting-registration.sh" --cwd="$PROJECT_ROOT" --quiet >/dev/null 2>&1 || true
        bash "${SCRIPT_DIR_RPR}/../scripts/validate-factory-ledger.sh" --cwd="$PROJECT_ROOT" --quiet >/dev/null 2>&1 || true
      fi
      GATE_REASON=$(PROJECT_ROOT="$PROJECT_ROOT" python3 -c '
import json, os
md = os.path.join(os.environ["PROJECT_ROOT"], ".mega-sdd")
def L(fn):
    try:
        return json.load(open(os.path.join(md, fn)))
    except Exception:
        return None
fails = []

# MOAT GATE — binding->units: unresolved drops/CONFLICT block unit->bolt.
# Fail-CLOSED on a corrupt moat state (AUDIT L4): a present-but-unparseable
# .validation-blockers.json must NOT silently pass — a torn/garbage write would
# otherwise fail-open via L()=None and open the binding->units gate (invariant #2).
# Absent = never evaluated = allow (unchanged). ONLY the moat file is fail-closed;
# the other gates below stay fail-open to avoid spurious blocks on transient corruption.
moat_path = os.path.join(md, ".validation-blockers.json")
if os.path.exists(moat_path):
    try:
        d = json.load(open(moat_path))
    except Exception as e:
        d = None
        fails.append(("binding->units", "binding->units moat state .validation-blockers.json is UNPARSEABLE (%s) — failing CLOSED. Re-run the handoff validator (bash scripts/validate-handoff-binding-units.sh --cwd=<root>) or bind-codebase to rewrite it, or delete it if no binding ran. State: %s/.validation-blockers.json" % (type(e).__name__, md)))
    if d and d.get("status") == "FAIL":
        drops = d.get("drops", [])
        n = len(drops)
        types = sorted({dd.get("type", "?") for dd in drops})
        # S4 BC-MSG-1: the remediation differs per drop type — a conflict drop
        # can NEVER be cleared by adding OQ-IDs to frontmatter.
        rem = []
        if any(t in ("conflict_unresolved", "binding_missing") for t in types):
            rem.append("conflict/binding drops: resolve via resolve-oq --binding <binding.md> (human-in-the-loop), or re-run bind-codebase until conflicts=0")
        if any(t in ("oq_id_dropped", "conflict_id_dropped") for t in types):
            rem.append("propagation drops: add the missing OQ-/CONFLICT-IDs to the relevant unit frontmatter binding_refs")
        if any(t == "binding_stale_recertify" for t in types):
            rem.append("binding basi (stale): file yang di-anchor binding berubah sejak binding_metadata.head oleh commit di luar pipeline unit — jalankan /mega-sdd:sync atau bind-codebase ulang (daftar file ada di field expected pada drop-nya)")
        fails.append(("binding->units", "handoff validator detected %s unresolved drop(s) (binding->units; types: %s). Run bash scripts/validate-handoff-binding-units.sh --cwd=<root> for the drop list. %s. State: %s/.validation-blockers.json" % (n, ", ".join(types), "; ".join(rem) or "see the expected field on each drop", md)))

# bolt-orphans (status==FAIL) — bolt COMMITS with no bolt-report.md (interactive-run
# gap, clinic-project audit 2026-06-12). The Stop hook writes this state on every
# turn end; blocking the NEXT execute-bolts is what makes the audit trail
# un-skippable without --auto.
d = L(".bolt-orphans-state.json")
if d and d.get("status") == "FAIL":
    n = d.get("issues_count", len(d.get("issues", [])))
    units = ", ".join(i.get("unit_id", "?") for i in d.get("issues", [])[:8])
    fails.append(("bolt-orphans", "orphan-bolt scan found %s bolt commit(s) with NO <vault>/bolts/U-XXX/bolt-report.md (%s%s). Backfill a bolt-report (retroactive: true) for each listed unit, or re-run those units. State: %s/.bolt-orphans-state.json" % (n, units, ", …" if n > 8 else "", md)))

# batch-suite-gate (status==FAIL) — B2: a code-bearing bolt run must leave a green
# full-suite result (<vault>/bolts/_batch-suite.json) covering the newest CODE commit
# (a bolt OR an out-of-band edit). The Stop hook writes this state each turn end; blocking
# the NEXT execute-bolts is what makes the final full-suite gate un-skippable (the scoped
# per-bolt tests cannot catch a later bolt or an out-of-band edit breaking an earlier
# bolt contract — the freshness anchor is the newest code commit, not the newest bolt).
d = L(".batch-suite-gate-state.json")
if d and d.get("status") == "FAIL":
    ht = d.get("halt_type", "batch_suite_gate_missing")
    if ht == "batch_suite_red":
        fails.append(("batch-suite-gate", "recorded full-suite result is RED (%s). Fix the failing tests, then run `bash <plugin>/scripts/run-full-suite.sh --cwd=<project-root>` — it re-runs the FULL suite and records <vault>/bolts/_batch-suite.json itself (the artifact is hook-guarded; direct writes are denied). State: %s/.batch-suite-gate-state.json" % (d.get("detail", ""), md)))
    else:
        _who = "an OUT-OF-BAND code commit (hotfix/manual edit, no bolt provenance)" if d.get("out_of_band") else ("the newest bolt commit (%s)" % d.get("newest_bolt_unit", "?"))
        fails.append(("batch-suite-gate", "no green full-suite result covers %s. Run `bash <plugin>/scripts/run-full-suite.sh --cwd=<project-root>` — it runs the FULL project suite (no per-unit scope filter) and records <vault>/bolts/_batch-suite.json with the pinned HEAD sha itself (the artifact is hook-guarded; direct writes are denied). State: %s/.batch-suite-gate-state.json" % (_who, md)))

# postflight-evidence (status==FAIL) — B1: a committed Hard-rule create/extend/modify
# bolt with no passing <vault>/bolts/U-XXX/postflight.json. The post-flight Hard-rule
# scan was prose-only; blocking the NEXT execute-bolts makes the safety net real.
d = L(".bolt-postflight-state.json")
if d and d.get("status") == "FAIL":
    n = d.get("issues_count", len(d.get("issues", [])))
    units = ", ".join(i.get("unit_id", "?") for i in d.get("issues", [])[:8])
    fails.append(("postflight-evidence", "post-flight scan found %s Hard-rule bolt(s) committed with no passing postflight.json (%s%s). Run `bash <plugin>/scripts/run-postflight-scan.sh --cwd=<project-root> --unit=U-XXX` for each listed unit — it executes that unit Hard rules against real git/filesystem state and records the evidence itself (the artifact is hook-guarded; direct writes are denied). A recorded VIOLATION means the committed code must be fixed first. State: %s/.bolt-postflight-state.json" % (n, units, ", …" if n > 8 else "", md)))

# whitelist-observer (status==FAIL) — B3 (S6 EB-GATE-11): bolt commits must stay
# inside their unit target_files whitelist (∪ vault artifacts, .mega-sdd, tests).
d = L(".bolt-whitelist-state.json")
if d and d.get("status") == "FAIL":
    n = d.get("issues_count", len(d.get("issues", [])))
