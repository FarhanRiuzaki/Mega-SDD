#!/usr/bin/env bash
# PreToolUse hook for mega-sdd plugin — Iter 67.6 v3.49.0+.
#
# [HOOK-VALIDATE] enforcement layer for walking-skeleton slice 1 (audit §F).
# Blocks two classes of agent actions:
#   1. Bolt-generation while binding→units handoff has unresolved drops
#      (skill_name matching mega-sdd:execute-bolts → checks .validation-blockers.json)
#   2. Anti-self-bypass: agent attempts to delete/truncate/overwrite state files
#      managed by the guard layer (.validation-blockers.json, .plan-pending,
#      .replan-budget, .iter-classifier.json).
#
# Honest design constraint: the human user (Farhan) is not the adversary — they
# are on the same side as the guard. The agent (Claude) is what we constrain.
# Manual override via filesystem ops outside agent context (user types `rm` in
# their shell) is a FEATURE, not a leak. Hooks only see tool calls from the
# agent; user-shell ops bypass hooks naturally.
#
# Output protocol (Claude Code PreToolUse):
#   - JSON to stdout with {"continue": false, "stopReason": "...", "suppressOutput": false}
#     → tool is blocked; reason shown to agent
#   - Or exit non-zero with stderr message → tool is blocked
#   - Else exit 0 → tool proceeds normally
#
# Input (stdin): JSON {session_id, cwd, tool_name, tool_input, ...}

set -uo pipefail

STDIN_JSON=$(cat 2>/dev/null || echo '{}')

# Parse via python3 — assign to local vars first (no backslash in f-string)
PARSE_OUTPUT=$(printf '%s' "$STDIN_JSON" | python3 -c '
import json
import sys
import base64

try:
    data = json.loads(sys.stdin.read())
except Exception:
    sys.exit(0)

cwd = data.get("cwd", "")
tool_name = data.get("tool_name", "")
tool_input = data.get("tool_input", {})
transcript_path = data.get("transcript_path", "")

print(f"CWD={cwd}")
print(f"TOOL_NAME={tool_name}")
print(f"TRANSCRIPT_PATH={transcript_path}")

if tool_name == "Skill":
    skill_name = tool_input.get("skill", "")
    print(f"SKILL_NAME={skill_name}")
elif tool_name == "Bash":
    cmd = tool_input.get("command", "")
    cmd_b64 = base64.b64encode(cmd.encode()).decode()
    print(f"BASH_CMD_B64={cmd_b64}")
' 2>/dev/null)

if [ -z "$PARSE_OUTPUT" ]; then exit 0; fi
eval "$PARSE_OUTPUT" 2>/dev/null || true

if [ -z "${CWD:-}" ]; then exit 0; fi

# ─── Resolve project root (Iter 71 — class-bug fix) ──────────────────────────
# Model may cd into a subfolder during a chain step (extract-intelligence often
# operates inside .mega-sdd/knowledge-base/). Without walking up, ${CWD}/.mega-sdd/
# → .mega-sdd/knowledge-base/.mega-sdd/ (nested). resolve_project_root walks UP
# to the outermost .mega-sdd/ parent. Fallback: original CWD.
SCRIPT_DIR_RPR="$(cd "$(dirname "$0")" && pwd 2>/dev/null)"
RPR_HELPER="${SCRIPT_DIR_RPR}/../scripts/_lib/resolve-project-root.sh"
if [ -f "$RPR_HELPER" ]; then
  # shellcheck disable=SC1090
  . "$RPR_HELPER"
  PROJECT_ROOT=$(resolve_project_root "$CWD")
else
  PROJECT_ROOT="$CWD"
fi

# Opt-out: telemetry: false in config.yaml also disables this hook
# (a project that opts out of telemetry generally wants to opt out of guards too)
CONFIG_FILE="${PROJECT_ROOT}/.mega-sdd/config.yaml"
if [ -f "$CONFIG_FILE" ]; then
  if grep -qE "^\s*telemetry:\s*false" "$CONFIG_FILE" 2>/dev/null; then
    exit 0
  fi
fi

# Only act on mega-sdd projects (skip if .mega-sdd/ doesn't exist)
if [ ! -d "${PROJECT_ROOT}/.mega-sdd" ]; then exit 0; fi

# Helper: emit block JSON to stdout and exit
emit_block() {
  local reason="$1"
  # CD-4: if a multi-gate failure summary was precomputed (execute-bolts path), prepend it so the
  # FIRST emit_block surfaces ALL failing gates at once (emit_block exits, short-circuiting later
  # branches). Empty for every other call site — a pure no-op prefix.
  reason="${MEGA_MULTIFAIL_PREFIX:-}${reason}"
  # Escape for JSON string (basic)
  local reason_json
  reason_json=$(printf '%s' "$reason" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))' 2>/dev/null)
  if [ -z "$reason_json" ]; then reason_json="\"$reason\""; fi
  cat <<EOF
{"continue": false, "stopReason": $reason_json, "suppressOutput": false}
EOF
  exit 0  # PreToolUse uses stdout JSON for block, not exit code
}

# ─── BRANCH 1: Skill invocation gate ─────────────────────────────────────────
# Block mega-sdd:execute-bolts when handoff binding→units blockers present
# (Iter 67.6 slice 1). Block ANY mega-sdd:* skill when handoff-validation
# state shows upstream failure (Phase B slice B.1 v3.53.0+).
case "${TOOL_NAME:-}" in
  Skill)
    # Branch 1c (Phase B slice B.6 PATTERN-PROVE): scope flag validation for
    # mega-sdd:auto / mega-sdd:generate-intent / mega-sdd:orchestrate-flow.
    # Reads transcript_path to find user's most recent message + extract
    # --scope=X flag (args not in tool_input). Validates against PRD scopes.
    case "${SKILL_NAME:-}" in
      mega-sdd:auto|mega-sdd:generate-intent|mega-sdd:orchestrate-flow)
        if [ -n "${TRANSCRIPT_PATH:-}" ] && [ -f "$TRANSCRIPT_PATH" ]; then
          # Extract most recent USER message text from transcript
          USER_MSG=$(TRANSCRIPT_PATH="$TRANSCRIPT_PATH" python3 -c '
import json, os
last_user_text = None
with open(os.environ["TRANSCRIPT_PATH"]) as f:
    for line in f:
        try:
            rec = json.loads(line)
        except Exception:
            continue
        msg = rec.get("message") if isinstance(rec.get("message"), dict) else None
        if not msg or msg.get("role") != "user":
            continue
        content = msg.get("content")
        if isinstance(content, str):
            last_user_text = content
        elif isinstance(content, list):
            parts = [b.get("text","") for b in content if isinstance(b, dict) and b.get("type") == "text"]
            if parts:
                last_user_text = "\n".join(parts)
if last_user_text:
    print(last_user_text)
' 2>/dev/null)

          if [ -n "$USER_MSG" ]; then
            SCRIPT_DIR_HV="$(cd "$(dirname "$0")" && pwd)"
            VALIDATOR_SCOPE="${SCRIPT_DIR_HV}/../scripts/validate-scope-flag.sh"
            if [ -x "$VALIDATOR_SCOPE" ]; then
              SCOPE_RESULT=$(printf '%s' "$USER_MSG" | bash "$VALIDATOR_SCOPE" --cwd="$PROJECT_ROOT" --quiet 2>/dev/null)
              SCOPE_EXIT=$?
              if [ "$SCOPE_EXIT" = "1" ]; then
                # FAIL — extract stopReason from state file and emit block
                STATE_SCOPE="${PROJECT_ROOT}/.mega-sdd/.scope-flag-state.json"
                if [ -f "$STATE_SCOPE" ]; then
                  STOP_REASON=$(python3 -c "
import json
try:
    d = json.load(open('$STATE_SCOPE'))
    print(d.get('stopReason', 'scope_not_declared_in_prd'))
except Exception:
    print('scope_not_declared_in_prd')
" 2>/dev/null)
                  emit_block "$STOP_REASON"
                fi
              fi
            fi
          fi
        fi
        ;;
    esac

    # Branch 0 (Iter-79 O-1): predictive preflight — fatal INPUT-precondition check for the
    # skill about to run, BEFORE it burns minutes and halts mid-way. Fork-A enforcement of
    # the F2 "predictive halt" theme (was prose-only orchestrate-flow Step 3.5 +
    # predictive-checks.md). Conservative: only GENUINELY-FATAL preconditions block (a skill
    # that cannot do anything useful without the missing input). scan-codebase tree-sitter is
    # WARN-only (never FATAL). State recomputed each invocation → self-clears (no deadlock).
    case "${SKILL_NAME:-}" in
      mega-sdd:bind-codebase|mega-sdd:generate-units|mega-sdd:execute-bolts|mega-sdd:scan-codebase)
        PREFLIGHT="${SCRIPT_DIR_RPR}/../scripts/validate-preflight.sh"
        if [ -x "$PREFLIGHT" ]; then
          bash "$PREFLIGHT" --cwd="$PROJECT_ROOT" --skill="$SKILL_NAME" --quiet >/dev/null 2>&1 || true
          PF_STATE="${PROJECT_ROOT}/.mega-sdd/.preflight-state.json"
          if [ -f "$PF_STATE" ]; then
            PF_STATUS=$(python3 -c "
import json
try:
    print(json.load(open('$PF_STATE')).get('status', 'PASS'))
except Exception:
    print('PARSE_ERROR')
" 2>/dev/null)
            if [ "$PF_STATUS" = "FATAL" ]; then
              PF_MSG=$(python3 -c "
import json
try:
    print(json.load(open('$PF_STATE')).get('fatal_on_fail', ''))
except Exception:
    print('')
" 2>/dev/null)
              emit_block "${SKILL_NAME} is blocked by a predictive preflight check — ${PF_MSG} (preflight state: ${PF_STATE})"
            fi
          fi
        fi
        ;;
    esac

    # Branch 1a: handoff validation gate (Phase B slice B.1) — applies to ALL mega-sdd:* skills
    # except using-mega-sdd (auto-loaded anchor, not a chain step).
    #
    # Iter 70 fix (audit 2026-05-28 §post-3.61.0 deadlock): producer self-fix attempts
    # MUST be allowed. The state file records WHICH skill emitted the bad handoff
    # (state.skill_name); when the same skill is being re-invoked, that IS the producer
    # attempting to re-run with a fixed template — block it and the deadlock is sealed
    # (state stays FAIL forever; user cannot clear except by manual rm).
    case "${SKILL_NAME:-}" in
      mega-sdd:*)
        if [ "${SKILL_NAME:-}" != "mega-sdd:using-mega-sdd" ]; then
          HANDOFF_STATE="${PROJECT_ROOT}/.mega-sdd/.handoff-validation-state.json"
          if [ -f "$HANDOFF_STATE" ]; then
            HSTATUS_AND_PRODUCER=$(STATE_PATH="$HANDOFF_STATE" python3 -c "
import json, os
try:
    d = json.load(open(os.environ['STATE_PATH']))
    print(d.get('status', 'UNKNOWN'))
    print(d.get('skill_name', ''))
except Exception:
    print('PARSE_ERROR')
    print('')
" 2>/dev/null)
            HSTATUS=$(echo "$HSTATUS_AND_PRODUCER" | sed -n '1p')
            STATE_PRODUCER=$(echo "$HSTATUS_AND_PRODUCER" | sed -n '2p')
            if [ "$HSTATUS" = "FAIL" ]; then
              # Producer self-fix allow: if the skill being invoked IS the same producer
              # that emitted the bad handoff, this is a retry attempt — let it run. The
              # producer will re-emit handoff, validate-handoff-yaml.sh will overwrite the
              # state file with the new verdict (PASS clears the block for everyone;
              # repeated FAIL bumps retry_count + escalate_to_c2 per C1 protocol).
              if [ -n "$STATE_PRODUCER" ] && [ "$SKILL_NAME" = "$STATE_PRODUCER" ]; then
                : # fall through to allow
              else
                HDETAIL=$(STATE_PATH="$HANDOFF_STATE" python3 -c "
import json, os
try:
    d = json.load(open(os.environ['STATE_PATH']))
    ht = d.get('halt_type', 'unknown')
    sk = d.get('skill_name', 'unknown')
    rc = d.get('retry_count', 0)
    esc = d.get('escalate_to_c2', False)
    na = d.get('next_action', {})
    hint = na.get('hint', '(no hint)') if isinstance(na, dict) else str(na)
    reason = d.get('details', {}).get('reason', '(no reason)')
    print(f'upstream {sk} emitted bad handoff ({ht}, retry={rc}, escalate_c2={esc}). Reason: {reason}. Suggestion: {hint}')
except Exception as e:
    print(f'(state file parse error: {e})')
" 2>/dev/null)
                REASON="${SKILL_NAME} blocked by handoff validation — ${HDETAIL}. Resolve by EITHER (a) re-invoke the upstream producer (${STATE_PRODUCER:-unknown}) — this is auto-allowed and overwrites the FAIL state when it emits a valid handoff; OR (b) delete the stale state file manually: rm ${PROJECT_ROOT}/.mega-sdd/.handoff-validation-state.json (the file is NOT in the anti-self-bypass protected list)."
                emit_block "$REASON"
              fi
            fi
          fi
        fi
        ;;
    esac

    # CD-4: precompute a multi-gate failure summary for execute-bolts. emit_block exits on the
    # FIRST failing gate, so without this an agent serially re-invokes against one gate at a time.
    # When >1 execute-bolts gate is FAILing, MEGA_MULTIFAIL_PREFIX surfaces the full set up front
    # (emit_block prepends it). Additive text only — no control-flow change. Empty when <=1 fails.
    MEGA_MULTIFAIL_PREFIX=""
    if [ "${SKILL_NAME:-}" = "mega-sdd:execute-bolts" ]; then
      MEGA_MULTIFAIL_PREFIX=$(python3 -c "
import json, os
root = '${PROJECT_ROOT}'
fails = []
# status==FAIL gates
for fn, name in [('.validation-blockers.json','binding->units'), ('.flow-coverage-state.json','flow-coverage'),
                 ('.sibling-consistency-state.json','sibling-consistency'), ('.cross-cutting-state.json','cross-cutting'),
                 ('.ui-quality-blockers.json','ui-quality'), ('.dispatch-prompt-state.json','dispatch-prompt')]:
    try:
        if json.load(open(os.path.join(root, '.mega-sdd', fn))).get('status') == 'FAIL':
            fails.append(name)
    except Exception:
        pass
# halt_type-counted EXTENSION gates (never status==FAIL — see Iter-78.1 invariants)
for fn, name, hts in [('.unit-spec-state.json','render-test',('render_test_missing',)),
                      ('.vault-oqs-state.json','operator-UX',('operator_surface_missing','design_source_oq_missing'))]:
    try:
        d = json.load(open(os.path.join(root, '.mega-sdd', fn)))
        if any(i.get('halt_type') in hts for i in d.get('issues', [])):
            fails.append(name)
    except Exception:
        pass
if len(fails) > 1:
    print('[%d execute-bolts gates are failing: %s — fix ALL before re-running; each is reported in turn] ' % (len(fails), ', '.join(fails)))
" 2>/dev/null) || MEGA_MULTIFAIL_PREFIX=""
    fi

    # Branch 1b: existing binding→units handoff gate for execute-bolts (Iter 67.6 slice 1)
    case "${SKILL_NAME:-}" in
      mega-sdd:execute-bolts)
        BLOCKER_FILE="${PROJECT_ROOT}/.mega-sdd/.validation-blockers.json"
        if [ -f "$BLOCKER_FILE" ]; then
          # Read status field
          STATUS=$(python3 -c "
import json
try:
    d = json.load(open('$BLOCKER_FILE'))
    print(d.get('status', 'UNKNOWN'))
except Exception:
    print('PARSE_ERROR')
" 2>/dev/null)
          if [ "$STATUS" = "FAIL" ]; then
            # Count drops for the reason message
            DROPS_COUNT=$(python3 -c "
import json
try:
    d = json.load(open('$BLOCKER_FILE'))
    print(len(d.get('drops', [])))
except Exception:
    print('?')
" 2>/dev/null)
            REASON="mega-sdd:execute-bolts is blocked — handoff validator detected ${DROPS_COUNT} unresolved drops at binding→units boundary. Run /mega-sdd:validate-handoff to see drop list, then add the missing OQ-IDs to the relevant unit frontmatter binding_refs lists. State: ${PROJECT_ROOT}/.mega-sdd/.validation-blockers.json"
            emit_block "$REASON"
          fi
        fi
        ;;
    esac

    # Branch 5: flow-coverage gate for execute-bolts (code-delivery slice A).
    # Blocks bolts when validate-flow-coverage.sh found input-accepting flow steps
    # that no unit maps to a required artifact (missing Form Requests etc.) and/or
    # dead scaffold stubs (e.g. edit views with no update/PUT flow). The units are
    # the input; fix them before bolts run. SKIP/PASS state never blocks.
    case "${SKILL_NAME:-}" in
      mega-sdd:execute-bolts)
        FC_STATE="${PROJECT_ROOT}/.mega-sdd/.flow-coverage-state.json"
        if [ -f "$FC_STATE" ]; then
          FC_STATUS=$(python3 -c "
import json
try:
    d = json.load(open('$FC_STATE'))
    print(d.get('status', 'UNKNOWN'))
except Exception:
    print('PARSE_ERROR')
" 2>/dev/null)
          if [ "$FC_STATUS" = "FAIL" ]; then
            FC_COUNTS=$(python3 -c "
import json
try:
    d = json.load(open('$FC_STATE'))
    miss = sum(m.get('shortfall', 1) for m in d.get('missing_artifacts', []))
    dead = len(d.get('dead_scaffold', []))
    print('%s %s' % (miss, dead))
except Exception:
    print('? ?')
" 2>/dev/null)
            FC_MISS=$(echo "$FC_COUNTS" | cut -d' ' -f1)
            FC_DEAD=$(echo "$FC_COUNTS" | cut -d' ' -f2)
            REASON="mega-sdd:execute-bolts is blocked — flow-coverage validator found ${FC_MISS} input-accepting flow step(s) with no mapped input-validation artifact (e.g. missing per-stage Form Requests) and ${FC_DEAD} dead scaffold stub(s) (e.g. edit views with no update/PUT flow step) in the current units. Add the missing per-step artifacts to the relevant module unit's '## Target files' and remove the dead scaffold stubs, then re-save the unit (PostToolUse re-validates). State: ${PROJECT_ROOT}/.mega-sdd/.flow-coverage-state.json"
            emit_block "$REASON"
          fi
        fi
        ;;
    esac

    # Branch 7: sibling-consistency gate for execute-bolts (code-delivery slice B).
    # Blocks bolts when validate-sibling-consistency.sh found a cross-cutting concern
    # implemented inconsistently across sibling units (fan-out divergence) and/or an
    # FK column with no derived relation accessor. The units are the input; fix them
    # before bolts run. PASS / SKIP never blocks.
    case "${SKILL_NAME:-}" in
      mega-sdd:execute-bolts)
        SIB_STATE="${PROJECT_ROOT}/.mega-sdd/.sibling-consistency-state.json"
        if [ -f "$SIB_STATE" ]; then
          SIB_STATUS=$(python3 -c "
import json
try:
    d = json.load(open('$SIB_STATE'))
    print(d.get('status', 'UNKNOWN'))
except Exception:
    print('PARSE_ERROR')
" 2>/dev/null)
          if [ "$SIB_STATUS" = "FAIL" ]; then
            SIB_COUNTS=$(python3 -c "
import json
try:
    d = json.load(open('$SIB_STATE'))
    print('%s %s' % (len(d.get('inconsistent', [])), len(d.get('missing_relations', []))))
except Exception:
    print('? ?')
" 2>/dev/null)
            SIB_INCON=$(echo "$SIB_COUNTS" | cut -d' ' -f1)
            SIB_REL=$(echo "$SIB_COUNTS" | cut -d' ' -f2)
            REASON="mega-sdd:execute-bolts is blocked — sibling-consistency validator found ${SIB_INCON} cross-cutting concern divergence(s) across sibling units (a shared concern such as branch-scoping implemented differently in one sibling than the others) and ${SIB_REL} FK column(s) with no derived relation accessor. Make every sibling sharing a concern declare the same mechanism, and declare the relation accessor for each FK column, then re-save the unit (PostToolUse re-validates). State: ${PROJECT_ROOT}/.mega-sdd/.sibling-consistency-state.json"
            emit_block "$REASON"
          fi
        fi
        ;;
    esac

    # Branch 6: render-test gate for execute-bolts (code-delivery slice D).
    # Blocks bolts when validate-unit-spec.sh flagged a `render_test_missing` issue
    # — a unit ships a detail/show view (pack detail_view_glob) but carries no
    # acceptance_test of type `render`. Detail pages 200 with a blank body or throw
    # on a null/empty field; a render test is the cheap durable proof. PRECISE: only
    # the render_test_missing issue blocks here (advisory / unrelated unit-spec
    # issues do not gate bolts via this branch). PASS / SKIP never blocks.
    case "${SKILL_NAME:-}" in
      mega-sdd:execute-bolts)
        US_STATE="${PROJECT_ROOT}/.mega-sdd/.unit-spec-state.json"
        if [ -f "$US_STATE" ]; then
          US_RENDER=$(python3 -c "
import json
try:
    d = json.load(open('$US_STATE'))
    rt = [i for i in d.get('issues', []) if i.get('halt_type') == 'render_test_missing']
    print(len(rt))
except Exception:
    print('0')
" 2>/dev/null)
          if [ -n "$US_RENDER" ] && [ "$US_RENDER" != "0" ]; then
            REASON="mega-sdd:execute-bolts is blocked — unit-spec validator flagged ${US_RENDER} unit(s) shipping a detail/show view with no \`acceptance_test\` of type \`render\` (render_test_missing). A route-200 smoke test misses empty-model / null-field render crashes. Add a structured \`acceptance_test:\` entry with \`type: render\` (derived from the active pack \`## Test patterns\` -> detail_view_render template) to each view-bearing unit, then re-save the unit (PostToolUse re-validates). State: ${US_STATE}"
            emit_block "$REASON"
          fi
        fi
        ;;
    esac

    # Branch 8: UI scaffold-tells gate for execute-bolts (code-delivery slice E).
    # Blocks bolts when validate-ui-quality.sh flagged a written VIEW file carrying raw
    # scaffold tells (controller-class page title, column-id labels, raw UUID FK echoes,
    # unformatted money, native alert/confirm) or — on a non-trivial view — missing a
    # required element (app-layout extend, responsive grid). Honest Fork-A enforcement:
    # the gate cannot un-write a view a bolt subagent just wrote mid-turn, but it blocks
    # the NEXT execute-bolts invocation so the offending view must be fixed before the
    # next unit runs (see spec §1.6 "post-write detect-and-block-next"). PASS/SKIP never blocks.
    case "${SKILL_NAME:-}" in
      mega-sdd:execute-bolts)
        UIQ_STATE="${PROJECT_ROOT}/.mega-sdd/.ui-quality-blockers.json"
        if [ -f "$UIQ_STATE" ]; then
          UIQ_STATUS=$(python3 -c "
import json
try:
    d = json.load(open('$UIQ_STATE'))
    print(d.get('status', 'UNKNOWN'))
except Exception:
    print('PARSE_ERROR')
" 2>/dev/null)
          if [ "$UIQ_STATUS" = "FAIL" ]; then
            UIQ_COUNTS=$(python3 -c "
import json
try:
    d = json.load(open('$UIQ_STATE'))
    s = d.get('summary', {})
    print('%s %s' % (s.get('scaffold_tells_matched', 0), s.get('required_elements_missing', 0)))
except Exception:
    print('? ?')
" 2>/dev/null)
            UIQ_TELLS=$(echo "$UIQ_COUNTS" | cut -d' ' -f1)
            UIQ_MISS=$(echo "$UIQ_COUNTS" | cut -d' ' -f2)
            REASON="mega-sdd:execute-bolts is blocked — UI-quality validator found ${UIQ_TELLS} raw-scaffold tell(s) (e.g. a Controller-class page title, 'Customer Id'-style column labels, raw UUID foreign-key echoes, unformatted money, or a native alert/confirm dialog) and ${UIQ_MISS} missing required element(s) (app-layout extend / responsive grid) in a written view file. Humanize labels, resolve FK ids to a human label via the relation, format money, replace native dialogs with the project notification idiom, and ensure the view extends the app layout + carries a responsive grid; then re-save the view (PostToolUse re-validates). State: ${UIQ_STATE}"
            emit_block "$REASON"
          fi
        fi
        ;;
    esac

    # Branch 9: UI dispatch-prompt enrichment gate for execute-bolts (code-delivery slice F).
    # Blocks bolts when validate-dispatch-prompt.sh flagged a PRIOR run's emitted ui_ux
    # dispatch prompt as missing injected design tokens (tokens_not_injected) and/or a
    # view/component exemplar (exemplar_missing) — i.e. the UI T2-slice enrichment no-op'd.
    # Honest Fork-A semantics: the prompt is written MID execute-bolts, so this is a
    # RE-INVOCATION guard — it cannot fix the in-flight prompt, but it blocks the NEXT
    # execute-bolts run so the enrichment regression is corrected before more UI units run
    # (same "post-write detect-and-block-next" pattern as Branch 8). PASS/SKIP never blocks.
    case "${SKILL_NAME:-}" in
      mega-sdd:execute-bolts)
        DP_STATE="${PROJECT_ROOT}/.mega-sdd/.dispatch-prompt-state.json"
        if [ -f "$DP_STATE" ]; then
          DP_STATUS=$(python3 -c "
import json
try:
    d = json.load(open('$DP_STATE'))
    print(d.get('status', 'UNKNOWN'))
except Exception:
    print('PARSE_ERROR')
" 2>/dev/null)
          if [ "$DP_STATUS" = "FAIL" ]; then
            DP_COUNTS=$(python3 -c "
import json
try:
    d = json.load(open('$DP_STATE'))
    s = d.get('summary', {})
    print('%s %s' % (s.get('tokens_not_injected', 0), s.get('exemplar_missing', 0)))
except Exception:
    print('? ?')
" 2>/dev/null)
            DP_TOK=$(echo "$DP_COUNTS" | cut -d' ' -f1)
            DP_EX=$(echo "$DP_COUNTS" | cut -d' ' -f2)
            REASON="mega-sdd:execute-bolts is blocked — dispatch-prompt validator found a ui_ux unit's emitted bolt dispatch prompt missing ${DP_TOK} design-token injection(s) (no 'Design tokens:' line) and ${DP_EX} view/component exemplar(s). TO CLEAR (CD-2, non-circular): EITHER directly Edit the offending bolts/U-*/dispatch-prompt.md to add a 'Design tokens:' line (colors/spacing/fonts) + a 'Pattern: view' exemplar block, OR delete the state file: rm ${DP_STATE} (NOT in the anti-bypass protected list). The prompt re-validates on the next PostToolUse Write of dispatch-prompt.md. NOTE: simply re-invoking execute-bolts will re-block until the ui_ux T2-slice enrichment actually emits design_tokens (mid-priority, not first-dropped) + a linter-clean view exemplar (not [0]) — fix that enrichment, do not loop. State: ${DP_STATE}"
            emit_block "$REASON"
          fi
        fi
        ;;
    esac

    # Branch 10: operator-workflow-UX capture gate for execute-bolts (code-delivery slice G).
    # Blocks bolts when validate-vault-oqs.sh recorded a CAPTURE-stage miss: a vault
    # with a multi-stage approval (maker-checker) workflow that models NO operator
    # surface and carries NO Design-Source OQ (operator_surface_missing), or a vault
    # with UI components but all design-system flags false and no Design-Source OQ
    # (design_source_oq_missing). PRECISE: only these two halt_types gate bolts here —
    # pre-existing OQ-citation FAILs do NOT block via this branch (no behavior change
    # to the existing PostToolUse-only citation check). PASS / SKIP never blocks.
    case "${SKILL_NAME:-}" in
      mega-sdd:execute-bolts)
        OQ_STATE="${PROJECT_ROOT}/.mega-sdd/.vault-oqs-state.json"
        if [ -f "$OQ_STATE" ]; then
          OQ_OPUX=$(python3 -c "
import json
try:
    d = json.load(open('$OQ_STATE'))
    n = [i for i in d.get('issues', []) if i.get('halt_type') in ('operator_surface_missing','design_source_oq_missing')]
    print(len(n))
except Exception:
    print('0')
" 2>/dev/null)
          if [ -n "$OQ_OPUX" ] && [ "$OQ_OPUX" != "0" ]; then
            REASON="mega-sdd:execute-bolts is blocked — vault-OQ validator captured an operator-workflow-UX miss (${OQ_OPUX} issue(s) of type operator_surface_missing / design_source_oq_missing). A multi-stage approval (maker-checker) workflow needs a FIRST-CLASS operator surface (worklist/inbox, decision affordance, human-readable state labels, audit timeline) GROUNDED in the flows — never invented; OR, where UI components exist but design tokens / accessibility / voice-brand source is undecided, a high-priority Design-Source Open Question (DO NOT default WCAG/Material values). TO CLEAR (CD-3, deterministic): directly Edit the VAULT to add the operator-surface requirement (02-architecture) and/or the Design-Source OQ (vault.json oqs[]), then re-save it (PostToolUse re-validates); OR delete the state file: rm ${OQ_STATE} (not anti-bypass protected). LAST RESORT: re-run /mega-sdd:generate-intent — but a regenerated vault may re-fail the same deterministic check, so prefer the direct edit. State: ${OQ_STATE}"
            emit_block "$REASON"
          fi
        fi
        ;;
    esac

    # Branch 11: cross-cutting registration gate for execute-bolts (code-delivery slice C).
    # Honest Fork-A detect-and-block-next: validate-cross-cutting-registration.sh scans
    # generated SOURCE (PostToolUse) for a declared cross-cutting concern (e.g. BranchScoped)
    # that was never REGISTERED (the addGlobalScope call is missing). Fork A cannot un-write a
    # file a bolt just wrote mid-turn, so the NEXT execute-bolts is blocked until the
    # registrations land. PASS / SKIP never blocks.
    case "${SKILL_NAME:-}" in
      mega-sdd:execute-bolts)
        CC_STATE="${PROJECT_ROOT}/.mega-sdd/.cross-cutting-state.json"
        if [ -f "$CC_STATE" ]; then
          CC_STATUS=$(python3 -c "
import json
try:
    d = json.load(open('$CC_STATE'))
    print(d.get('status', 'UNKNOWN'))
except Exception:
    print('PARSE_ERROR')
" 2>/dev/null)
          if [ "$CC_STATUS" = "FAIL" ]; then
            CC_MISS=$(python3 -c "
import json
try:
    d = json.load(open('$CC_STATE'))
    print(len(d.get('missing_registration', [])))
except Exception:
    print('?')
" 2>/dev/null)
            REASON="mega-sdd:execute-bolts is blocked — cross-cutting-registration validator found ${CC_MISS} generated source file(s) that declare a cross-cutting concern (e.g. the BranchScoped global scope) but never register it (e.g. the addGlobalScope(new BranchScoped) call is missing from the model's booted()) — a silent cross-branch/tenant leak. Add the registration call to each flagged file, then re-save it (PostToolUse re-validates). State: ${PROJECT_ROOT}/.mega-sdd/.cross-cutting-state.json"
            emit_block "$REASON"
          fi
        fi
        ;;
    esac

    # Branch 12: fan-out parity gate for execute-bolts (Iter-79 A2).
    # Blocks bolts when validate-fanout-parity.sh found a deliverable-richness divergence:
    # among the VIEW-BEARING siblings of a module/scope group, ≥1 declares an obligation
    # (a `## UI contract` or a `type: render` test) that a peer omits — the "LC is always
    # the survivor" pattern. Dedicated single-purpose validator: status==FAIL is exactly
    # "≥1 divergence" (no unrelated checks ride this state), so gating on status is precise.
    # PASS / SKIP never blocks.
    case "${SKILL_NAME:-}" in
      mega-sdd:execute-bolts)
        FOP_STATE="${PROJECT_ROOT}/.mega-sdd/.fanout-parity-state.json"
        if [ -f "$FOP_STATE" ]; then
          FOP_STATUS=$(python3 -c "
import json
try:
    d = json.load(open('$FOP_STATE'))
    print(d.get('status', 'UNKNOWN'))
except Exception:
    print('PARSE_ERROR')
" 2>/dev/null)
          if [ "$FOP_STATUS" = "FAIL" ]; then
            FOP_CNT=$(python3 -c "
import json
try:
    d = json.load(open('$FOP_STATE'))
    print(d.get('summary', {}).get('divergence_count', '?'))
except Exception:
    print('?')
" 2>/dev/null)
            REASON="mega-sdd:execute-bolts is blocked — fan-out parity validator found ${FOP_CNT} deliverable-richness divergence(s) across view-bearing sibling units: a sibling declares an obligation (a \`## UI contract\` or a \`type: render\` acceptance test) that a peer in the same module/scope group omits — the 'survivor is served better than its peers' pattern. Bring every view-bearing sibling to parity (declare the same KIND of obligation), then re-save the unit(s) (PostToolUse re-validates). State: ${FOP_STATE}"
            emit_block "$REASON"
          fi
        fi
        ;;
    esac

    # Branch 13: UI-deferral gate for execute-bolts (Iter-79 B1).
    # Blocks bolts when validate-ui-deferral.sh found a committed bolt-report that defers a
    # unit's `## UI contract` to a future polish unit ("scaffold kept; UI polish deferred").
    # Honest Fork-A detect-and-block-next: cannot un-commit the scaffold view, but blocks the
    # NEXT execute-bolts until the contract states are realized. Dedicated single-purpose
    # validator → status==FAIL is precise. PASS / SKIP never blocks.
    case "${SKILL_NAME:-}" in
      mega-sdd:execute-bolts)
        UID_STATE="${PROJECT_ROOT}/.mega-sdd/.ui-deferral-state.json"
        if [ -f "$UID_STATE" ]; then
          UID_STATUS=$(python3 -c "
import json
try:
    d = json.load(open('$UID_STATE'))
    print(d.get('status', 'UNKNOWN'))
except Exception:
    print('PARSE_ERROR')
" 2>/dev/null)
          if [ "$UID_STATUS" = "FAIL" ]; then
            UID_CNT=$(python3 -c "
import json
try:
    d = json.load(open('$UID_STATE'))
    print(d.get('summary', {}).get('deferral_count', '?'))
except Exception:
    print('?')
" 2>/dev/null)
            REASON="mega-sdd:execute-bolts is blocked — UI-deferral validator found ${UID_CNT} bolt-report(s) that defer a unit's \`## UI contract\` to a future polish unit ('scaffold kept; UI polish deferred'). The contract's required_states must be realized in the bolt that writes the view, not deferred to a later unit. Realize the deferred UI, then re-run the bolt (PostToolUse re-validates). State: ${UID_STATE}"
            emit_block "$REASON"
          fi
        fi
        ;;
    esac
    ;;

  Bash)
    # ─── BRANCH 2: Anti-self-bypass on state files ──────────────────────────
    # Detect agent attempts to delete/truncate/overwrite guard state files.
    # SCOPED: only protects state files in ACTIVE project .mega-sdd/ (CWD root).
    # EXCLUDES: tests/, examples/, fixtures/, plugin source repo (dev-mode).
    BASH_CMD_B64="${BASH_CMD_B64:-}"
    [ -z "$BASH_CMD_B64" ] && exit 0

    # Decode command
    BASH_CMD=$(printf '%s' "$BASH_CMD_B64" | python3 -c '
import base64, sys
print(base64.b64decode(sys.stdin.read()).decode("utf-8", errors="replace"), end="")
' 2>/dev/null)
    [ -z "$BASH_CMD" ] && exit 0

    # ── Scope exclusion: skip guard for test/fixture/plugin-dev paths ──────
    # If the command targets files under tests/, examples/, or the plugin
    # source repo itself (CWD contains plugins/mega-sdd/) → not a live
    # project, guard doesn't apply.
    GUARD_SKIP=0
    if echo "$BASH_CMD" | grep -qE "tests/|examples/|fixtures/"; then
      GUARD_SKIP=1
    fi
    # Plugin-dev-mode: CWD is the plugin source repo, not a target project.
    # Detect by checking if CWD has plugins/mega-sdd/hooks/ (= this repo).
    if [ -d "${CWD}/plugins/mega-sdd/hooks" ]; then
      GUARD_SKIP=1
    fi
    if [ "$GUARD_SKIP" -eq 1 ]; then
      exit 0
    fi

    # Protected state files (scope: walking-skeleton slice 1 + Plan/Act + budget + classifier future)
    PROTECTED='\.validation-blockers\.json|\.plan-pending|\.replan-budget|\.iter-classifier\.json'

    BYPASS_DETECTED=""
    if echo "$BASH_CMD" | grep -qE "\b(rm|unlink)\s+[^|;&]*($PROTECTED)"; then
      BYPASS_DETECTED="rm/unlink of protected state file"
    elif echo "$BASH_CMD" | grep -qE ">[[:space:]]*[^|;&]*($PROTECTED)"; then
      BYPASS_DETECTED="shell redirect (>) overwriting protected state file"
    elif echo "$BASH_CMD" | grep -qE "\bsed\s+(-[^[:space:]]*i[^[:space:]]*)\s+[^|;&]*($PROTECTED)"; then
      BYPASS_DETECTED="sed -i modifying protected state file"
    elif echo "$BASH_CMD" | grep -qE "\b(mv|cp)\s+[^|;&]*\s+[^|;&]*($PROTECTED)"; then
      BYPASS_DETECTED="mv/cp replacing protected state file"
    elif echo "$BASH_CMD" | grep -qE "\btee\s+[^|;&]*($PROTECTED)"; then
      BYPASS_DETECTED="tee overwriting protected state file"
    fi

    if [ -n "$BYPASS_DETECTED" ]; then
      REASON="Blocked: $BYPASS_DETECTED. Guard state files (.validation-blockers.json, .plan-pending, .replan-budget, .iter-classifier.json) are managed by hooks/skill chain — direct agent modification bypasses the guard. To clear a blocker, fix the underlying issue (e.g., add missing OQ-IDs to unit frontmatter) and let PostToolUse re-validate, OR use the appropriate slash command (/mega-sdd:validate-handoff, /mega-sdd:act, etc.). Human user can still modify these files via shell outside the agent."
      emit_block "$REASON"
    fi
    ;;
esac

# Default: allow the tool call
exit 0
