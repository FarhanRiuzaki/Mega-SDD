# acceptance-evidence (B4 — P4 v4.96.0, the WAJIB accuracy floor): a v5-keyed bolt
# (its commit carries the SDD-Acceptance:v5 trailer, stamped at commit time — the
# B1 read-obligation-at-commit precedent applied to the acceptance contract) must
# carry passing <vault>/bolts/U-XXX/acceptance.json. Legacy pre-v5 bolts NEVER
# block here (commit-keyed migration guarantee — the validator records them as
# advisory only and keeps status PASS).
d = L(".bolt-acceptance-state.json")
if d and d.get("status") == "FAIL":
    iss = d.get("issues", [])
    miss = [i for i in iss if i.get("halt_type") == "acceptance_evidence_missing"]
    red = [i for i in iss if i.get("halt_type") == "acceptance_red"]
    broken = [i for i in iss if i.get("halt_type") == "build_broken"]
    if miss:
        units = ", ".join(i.get("unit_id", "?") for i in miss[:8])
        fails.append(("acceptance-evidence", "acceptance scan found %s v5-keyed bolt(s) with no fresh acceptance.json (%s%s). Run `bash <plugin>/scripts/run-acceptance-tests.sh --cwd=<project-root> --unit=U-XXX` for each listed unit — it re-executes the unit acceptance_test entries (plus the L0 syntax floor over the bolt changed files) and records the hook-guarded evidence itself (halt acceptance_evidence_missing). Keterangan: bolt ber-trailer SDD-Acceptance wajib punya bukti acceptance yang tereksekusi; bolt lama (pra-v5) tidak pernah diblokir. State: %s/.bolt-acceptance-state.json" % (len(miss), units, ", …" if len(miss) > 8 else "", md)))
    if broken:
        units = ", ".join(i.get("unit_id", "?") for i in broken[:8])
        fails.append(("acceptance-evidence", "recorded acceptance evidence shows L0 SYNTAX failures for %s unit(s) (%s%s) — a committed file fails the syntax check of its own language (php -l / py_compile / node --check / ruby -c); halt build_broken (no retry — syntax is deterministic). Keterangan: file yang di-commit tidak lolos cek sintaks bahasanya sendiri — build rusak di lantai paling dasar; perbaiki file-nya lalu jalankan ulang run-acceptance-tests.sh. State: %s/.bolt-acceptance-state.json" % (len(broken), units, ", …" if len(broken) > 8 else "", md)))
    if red:
        units = ", ".join(i.get("unit_id", "?") for i in red[:8])
        fails.append(("acceptance-evidence", "recorded acceptance evidence is RED for %s unit(s) (%s%s) — an acceptance_test entry failed against the committed code even after the single bounded auto-retry (halt acceptance_red). Keterangan: kode yang sudah di-commit gagal acceptance test unit-nya — perbaiki kodenya (atau revert commit bolt), lalu jalankan `bash <plugin>/scripts/run-acceptance-tests.sh --cwd=<project-root> --unit=U-XXX` sampai hijau. State: %s/.bolt-acceptance-state.json" % (len(red), units, ", …" if len(red) > 8 else "", md)))

# flow-coverage (status==FAIL)
d = L(".flow-coverage-state.json")
if d and d.get("status") == "FAIL":
    miss = sum(m.get("shortfall", 1) for m in d.get("missing_artifacts", []))
    dead = len(d.get("dead_scaffold", []))
