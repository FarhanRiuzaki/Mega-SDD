        bash "${SCRIPT_DIR_RPR}/../scripts/validate-factory-ledger.sh" --cwd="$PROJECT_ROOT" --quiet >/dev/null 2>&1 || true
      fi
      GATE_REASON=$(PROJECT_ROOT="$PROJECT_ROOT" python3 -c '
import json, os
md = os.path.join(os.environ["PROJECT_ROOT"], ".mega-sdd")
def L(fn):
    try:
        return json.load(open(os.path.join(md, fn)))
    except Exception:
        return None
fails = []

# MOAT GATE — binding->units: unresolved drops/CONFLICT block unit->bolt.
# Fail-CLOSED on a corrupt moat state (AUDIT L4): a present-but-unparseable
# .validation-blockers.json must NOT silently pass — a torn/garbage write would
# otherwise fail-open via L()=None and open the binding->units gate (invariant #2).
# Absent = never evaluated = allow (unchanged). ONLY the moat file is fail-closed;
# the other gates below stay fail-open to avoid spurious blocks on transient corruption.
moat_path = os.path.join(md, ".validation-blockers.json")
if os.path.exists(moat_path):
    try:
        d = json.load(open(moat_path))
    except Exception as e:
        d = None
        fails.append(("binding->units", "binding->units moat state .validation-blockers.json is UNPARSEABLE (%s) — failing CLOSED. Re-run /mega-sdd:validate-handoff (or bind-codebase) to rewrite it, or delete it if no binding ran. State: %s/.validation-blockers.json" % (type(e).__name__, md)))
    if d and d.get("status") == "FAIL":
        drops = d.get("drops", [])
        n = len(drops)
        types = sorted({dd.get("type", "?") for dd in drops})
        # S4 BC-MSG-1: the remediation differs per drop type — a conflict drop
        # can NEVER be cleared by adding OQ-IDs to frontmatter.
        rem = []
        if any(t in ("conflict_unresolved", "binding_missing") for t in types):
            rem.append("conflict/binding drops: resolve via /mega-sdd:resolve-oq --binding <binding.md> (human-in-the-loop), or re-run /mega-sdd:bind-codebase until conflicts=0")
        if any(t in ("oq_id_dropped", "conflict_id_dropped") for t in types):
            rem.append("propagation drops: add the missing OQ-/CONFLICT-IDs to the relevant unit frontmatter binding_refs")
        if any(t == "binding_stale_recertify" for t in types):
            rem.append("binding basi (stale): file yang di-anchor binding berubah sejak binding_metadata.head oleh commit di luar pipeline unit — jalankan /mega-sdd:sync atau /mega-sdd:bind-codebase ulang (daftar file ada di field expected pada drop-nya)")
        fails.append(("binding->units", "handoff validator detected %s unresolved drop(s) (binding->units; types: %s). Run /mega-sdd:validate-handoff for the drop list. %s. State: %s/.validation-blockers.json" % (n, ", ".join(types), "; ".join(rem) or "see the expected field on each drop", md)))

