        fails.append(("verify-grounding", "unit-spec validator flagged %s verify unit(s) stamped grounding_confidence: HIGH whose acceptance criteria lack a resolvable NON-TEST source anchor (verify_grounding_untrusted). Per criterion, cite a non-test implementation anchor [grounded: path:line], OR downgrade grounding_confidence, OR split verify[built]+create[unbuilt]; then re-save. State: %s/.unit-spec-state.json" % (g, md)))

# sibling-consistency (status==FAIL)
d = L(".sibling-consistency-state.json")
if d and d.get("status") == "FAIL":
    incon = len(d.get("inconsistent", []))
