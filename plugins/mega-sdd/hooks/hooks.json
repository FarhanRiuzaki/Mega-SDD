{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start\"",
            "async": false,
            "statusMessage": "mega-sdd: anchor + state…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill|Bash|Edit|Write|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use\"",
            "async": false,
            "statusMessage": "mega-sdd: gate checks…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-use\"",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/stop\"",
            "async": true
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "execute-bolts|mega-sdd:execute-bolts|^mega-sdd$|mega-sdd:mega-sdd|/mega-sdd($|[^:])",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-expansion\"",
            "async": false,
            "statusMessage": "mega-sdd: prompt expansion…"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-submit\"",
            "async": false,
            "statusMessage": "mega-sdd: gateway marker…"
          }
        ]
      }
    ]
  }
}
