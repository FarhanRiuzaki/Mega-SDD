#!/usr/bin/env bash
# Stop hook for mega-sdd plugin — Iter 66a (v3.47.0+).
#
# Emits turn_end_marker event when an agent turn completes. Enables Iter 68
# aggregation to roll up per-turn token loads (ref_loaded events between two
# adjacent turn_end_markers = one turn's hot-tier consumption).
#
# Input (stdin): JSON {session_id, cwd, hook_event_name, ...}
# Output: appends one JSON line to <cwd>/.mega-sdd/memory/telemetry.jsonl
#         ONLY IF telemetry.jsonl already exists (avoids creating empty dirs
#         in projects that never invoked mega-sdd).
# Honors: --no-telemetry suppression via <cwd>/.mega-sdd/config.yaml
#
# Exit 0 always (hook should never block turn completion).

set -uo pipefail

# Read stdin
STDIN_JSON=$(cat 2>/dev/null || echo '{}')

# Parse via python3 (pipe stdin; script via -c)
PARSE_OUTPUT=$(printf '%s' "$STDIN_JSON" | python3 -c '
import json
import sys

try:
    data = json.loads(sys.stdin.read())
except Exception:
    sys.exit(0)

session_id = data.get("session_id", "unknown-session")
cwd = data.get("cwd", "")

print(f"SESSION_ID={session_id}")
print(f"CWD={cwd}")
' 2>/dev/null)

if [ -z "$PARSE_OUTPUT" ]; then
  exit 0
fi

eval "$PARSE_OUTPUT"

if [ -z "${CWD:-}" ]; then
  exit 0
fi

# Check opt-out
CONFIG_FILE="${CWD}/.mega-sdd/config.yaml"
if [ -f "$CONFIG_FILE" ]; then
  if grep -qE "^\s*telemetry:\s*false" "$CONFIG_FILE" 2>/dev/null; then
    exit 0
  fi
fi

# Only emit if telemetry.jsonl already exists (created by PostToolUse hook
# upon first mega-sdd-relevant Read). This avoids polluting non-mega-sdd
# projects with empty .mega-sdd/memory/ directories on every Stop event.
TELEMETRY_FILE="${CWD}/.mega-sdd/memory/telemetry.jsonl"
if [ ! -f "$TELEMETRY_FILE" ]; then
  exit 0
fi

# Build turn_end_marker event
TS=$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo "unknown-ts")
EVENT="{\"ts\":\"$TS\",\"skill\":\"orchestrate-flow\",\"event_type\":\"turn_end_marker\",\"session_id\":\"${SESSION_ID:-unknown}\",\"hook_source\":\"Stop\",\"payload\":{}}"

echo "$EVENT" >> "$TELEMETRY_FILE" 2>/dev/null || true

exit 0
