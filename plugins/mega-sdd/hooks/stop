#!/usr/bin/env bash
# Stop hook for mega-sdd plugin — Iter 67.5 v3.48.0+.
#
# AUDIT RESPONSE (audit 2026-05-27 §A3): Iter 66a shipped Stop hook, smoke test
# passed, but ZERO turn_end_marker events appeared in real-run telemetry.jsonl
# despite the gate condition (telemetry.jsonl exists) being met.
#
# This version (67.5):
# 1. ALWAYS writes a one-line entry to <cwd>/.mega-sdd/memory/hook-debug.log
#    on every invocation, regardless of gates. This is the diagnostic layer —
#    proves the harness is invoking us for this CWD.
# 2. THEN applies opt-out + telemetry-exists gate and emits turn_end_marker
#    with REAL transcript-usage data (input_tokens / cache_read_input_tokens /
#    output_tokens / cache_creation_input_tokens) when available.
#
# Per Claude Code Stop-hook spec, stdin includes transcript_path. We read the
# LAST message from the transcript and pull its `message.usage` block — that's
# the ground-truth turn cost from the harness (not estimated).
#
# Exit 0 always (hook must never block turn completion).

set -uo pipefail

# Always read stdin first
STDIN_JSON=$(cat 2>/dev/null || echo '{}')

# Parse stdin via python3 (pipe in; script via -c).
# NOTE: emission goes through emit()/shlex.quote, not an f-string — the consumer is
# `eval`, so an unquoted value would be re-parsed by the shell (see the block below).
PARSE_OUTPUT=$(printf '%s' "$STDIN_JSON" | python3 -c '
import json
import shlex
import sys

def emit(key, value):
    print(key + "=" + shlex.quote(str(value)))

try:
    data = json.loads(sys.stdin.read())
except Exception:
    sys.exit(0)

session_id = data.get("session_id", "unknown-session")
cwd = data.get("cwd", "")
transcript_path = data.get("transcript_path", "")
hook_event = data.get("hook_event_name", "")
stop_hook_active = data.get("stop_hook_active", False)

emit("SESSION_ID", session_id)
emit("CWD", cwd)
emit("TRANSCRIPT_PATH", transcript_path)
emit("HOOK_EVENT", hook_event)
emit("STOP_HOOK_ACTIVE", stop_hook_active)
' 2>/dev/null)

# The gating the old comment here asked for is now done at the SOURCE: every value
# above is shlex.quote()d, so eval cannot word-split, strip backslashes (which
# destroyed every Windows cwd/transcript path) or execute an embedded $(…).
if [ -n "$PARSE_OUTPUT" ]; then
  eval "$PARSE_OUTPUT" 2>/dev/null || true
fi

CWD="${CWD:-}"
SESSION_ID="${SESSION_ID:-unknown}"
TRANSCRIPT_PATH="${TRANSCRIPT_PATH:-}"
HOOK_EVENT="${HOOK_EVENT:-}"
STOP_HOOK_ACTIVE="${STOP_HOOK_ACTIVE:-False}"
TS=$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo "unknown-ts")

# ─── OPT-OUT (suppresses BOTH diagnostic + telemetry) ────────────────────────
if [ -z "$CWD" ]; then
  exit 0
fi

# ─── Resolve project root (Iter 71 — class-bug fix) ──────────────────────────
# CWD from stdin may be a sub-folder (model cd'd into .mega-sdd/knowledge-base/
# during a chain step). Walk UP to outermost .mega-sdd/ parent so state files,
# debug log, and telemetry land in the canonical location instead of nested.
SCRIPT_DIR_RPR="$(cd "$(dirname "$0")" && pwd 2>/dev/null)"
RPR_HELPER="${SCRIPT_DIR_RPR}/../scripts/_lib/resolve-project-root.sh"
if [ -f "$RPR_HELPER" ]; then
  # shellcheck disable=SC1090
  . "$RPR_HELPER"
  PROJECT_ROOT=$(resolve_project_root "$CWD")
else
  PROJECT_ROOT="$CWD"
fi

CONFIG_FILE="${PROJECT_ROOT}/.mega-sdd/config.yaml"
if [ -f "$CONFIG_FILE" ]; then
  if grep -qE "^\s*telemetry:\s*false" "$CONFIG_FILE" 2>/dev/null; then
    exit 0
  fi
fi

# ─── DIAGNOSTIC LAYER (Iter 67.5 — verify harness invocation) ────────────────
# Per audit response: prove the harness is invoking us for the project CWD.
# If hook-debug.log doesn't grow on every Stop event, the hook is not being called.
# Only writes for mega-sdd projects (avoids polluting unrelated CWDs).
if [ -d "${PROJECT_ROOT}/.mega-sdd" ]; then
  DEBUG_DIR="${PROJECT_ROOT}/.mega-sdd/memory"
  mkdir -p "$DEBUG_DIR" 2>/dev/null || true
  DEBUG_LOG="${DEBUG_DIR}/hook-debug.log"
  DEBUG_LINE="$(printf '{"ts":"%s","hook":"stop","session_id":"%s","cwd":"%s","transcript_path":"%s","stop_hook_active":"%s","stdin_bytes":%s}' \
    "$TS" "$SESSION_ID" "$CWD" "$TRANSCRIPT_PATH" "$STOP_HOOK_ACTIVE" "${#STDIN_JSON}")"
  echo "$DEBUG_LINE" >> "$DEBUG_LOG" 2>/dev/null || true
fi

# ─── HANDOFF VALIDATION (Phase B slice B.1, v3.53.0+) ───────────────────────
# Runs BEFORE telemetry gate — state file is the primary artifact (independent
# of telemetry). Telemetry emission is conditional on telemetry.jsonl existing.
# Only runs if .mega-sdd/ exists (already implicitly true at this point since
# we wrote hook-debug.log above which has the same guard).
if [ -d "${PROJECT_ROOT}/.mega-sdd" ] && [ -n "$TRANSCRIPT_PATH" ] && [ -f "$TRANSCRIPT_PATH" ]; then
  # Prefer the documented stdin field (Stop input carries last_assistant_message —
  # no transcript parse needed); fall back to transcript scan for older CC versions.
  LAST_ASSISTANT_TEXT=$(printf '%s' "$STDIN_JSON" | python3 -c 'import json,sys
try:
    print(json.loads(sys.stdin.read()).get("last_assistant_message") or "")
except Exception:
    pass' 2>/dev/null)
  if [ -z "$LAST_ASSISTANT_TEXT" ]; then
  LAST_ASSISTANT_TEXT=$(TRANSCRIPT_PATH="$TRANSCRIPT_PATH" python3 -c '
import json, os
last_text = None
with open(os.environ["TRANSCRIPT_PATH"]) as f:
    for line in f:
        try:
            rec = json.loads(line)
        except Exception:
            continue
        msg = rec.get("message") if isinstance(rec.get("message"), dict) else None
        if not msg:
            continue
        if msg.get("role") != "assistant":
            continue
        content = msg.get("content")
        if isinstance(content, str):
            last_text = content
        elif isinstance(content, list):
            parts = []
            for block in content:
                if isinstance(block, dict) and block.get("type") == "text":
                    parts.append(block.get("text", ""))
            if parts:
                last_text = "\n".join(parts)
if last_text:
    print(last_text)
' 2>/dev/null)
  fi

  # Only invoke validator if response contains "handoff:" marker (skip otherwise — skill may not be expected to emit)
  if [ -n "$LAST_ASSISTANT_TEXT" ] && echo "$LAST_ASSISTANT_TEXT" | grep -q "handoff:"; then
    SCRIPT_DIR_HV="$(cd "$(dirname "$0")" && pwd)"
    VALIDATOR_HV="${SCRIPT_DIR_HV}/../scripts/validate-handoff-yaml.sh"
    if [ -x "$VALIDATOR_HV" ]; then
      # Iter 74 fix (audit 2026-05-29 §post-3.65.0 doubled-prefix bug):
      # handoff-contract.md says `emitted_by: <skill-name>` should be the bare
      # skill (e.g., "extract-intelligence"), but producers in the wild emit
      # both forms — `emitted_by: extract-intelligence` AND `emitted_by:
      # mega-sdd:extract-intelligence`. The pre-Iter-74 regex `[\w-]+` stopped
      # at the colon, captured just "mega-sdd", then prepended "mega-sdd:"
      # again → "mega-sdd:mega-sdd". This (a) breaks Iter 70 producer-self-fix
      # matching (SKILL_NAME never equals "mega-sdd:mega-sdd"), (b) shows up
      # cosmetically in PreToolUse block messages. Match both forms now:
      # extended regex tolerates optional "mega-sdd:" prefix on the value;
      # downstream code unconditionally prepends.
      INFERRED_SKILL=$(echo "$LAST_ASSISTANT_TEXT" | python3 -c '
import sys, re
text = sys.stdin.read()
m = re.search(r"^\s*emitted_by:\s*(?:mega-sdd:)?([\w-]+)", text, re.MULTILINE)
print(m.group(1) if m else "unknown")
' 2>/dev/null)
      printf '%s' "$LAST_ASSISTANT_TEXT" | bash "$VALIDATOR_HV" --cwd="$PROJECT_ROOT" --skill-name="mega-sdd:${INFERRED_SKILL:-unknown}" --quiet >/dev/null 2>&1 || true
      # Emit telemetry event ONLY if telemetry.jsonl already exists (consistent with turn_end_marker gate)
      STATE_FILE_HV="${PROJECT_ROOT}/.mega-sdd/.handoff-validation-state.json"
      TELEMETRY_FILE_PRECHECK="${PROJECT_ROOT}/.mega-sdd/memory/telemetry.jsonl"
      if [ -f "$STATE_FILE_HV" ] && [ -f "$TELEMETRY_FILE_PRECHECK" ]; then
        HANDOFF_EVENT=$(STATE_FILE_HV="$STATE_FILE_HV" TS_ENV="$TS" SESSION_ID_ENV="$SESSION_ID" python3 -c '
import json, os
try:
    d = json.load(open(os.environ["STATE_FILE_HV"]))
    status = d["status"]
    ht = d.get("halt_type") or "handoff_validated_pass"
    rc = d.get("retry_count", 0)
    esc = d.get("escalate_to_c2", False)
    et = "halt_self_resolved" if status == "PASS" else ("halt_fired" if esc else "halt_self_resolved")
    fix_applied = "handoff validator ran" if status == "PASS" else f"detected {ht}; retry={rc}"
    payload = {
        "halt_type": ht,
        "fix_applied": fix_applied,
        "original_emit_site": "Stop-hook-handoff-validator",
        "logged_at_chat": False,
        "retry_count": rc,
        "escalate_to_c2": esc,
        "skill_name": d.get("skill_name"),
    }
    print(json.dumps({
        "ts": os.environ["TS_ENV"],
        "skill": "orchestrate-flow",
        "event_type": et,
        "session_id": os.environ["SESSION_ID_ENV"],
        "hook_source": "Stop",
        "payload": payload,
    }, separators=(",", ":")))
except Exception:
    pass
' 2>/dev/null)
        if [ -n "$HANDOFF_EVENT" ]; then
          echo "$HANDOFF_EVENT" >> "$TELEMETRY_FILE_PRECHECK" 2>/dev/null || true
        fi
      fi
    fi
  fi
fi

# ─── BOLT ORPHAN SCAN (clinic-project audit 2026-06-12) ─────────────────────
# Runs on EVERY Stop for a mega-sdd git project — unconditionally, NOT only when
# an --auto handoff was emitted. Closes the interactive-run gap: bolt commits
# with no <vault>/bolts/U-XXX/bolt-report.md were invisible to every gate
# (the handoff validator above only fires on a "handoff:" marker; the
# file-scoped artifact validator never fires for a file that was never
# written). Detection-only here (Stop must never block); the PreToolUse
# execute-bolts aggregator blocks the NEXT run on the FAIL state.
if [ -d "${PROJECT_ROOT}/.mega-sdd" ]; then
  SCRIPT_DIR_OS="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
  VALIDATOR_OS="${SCRIPT_DIR_OS}/../scripts/validate-bolt-artifacts.sh"
  if [ -f "$VALIDATOR_OS" ]; then
    bash "$VALIDATOR_OS" --cwd="$PROJECT_ROOT" --orphan-scan --quiet >/dev/null 2>&1 || true
    # B2 batch-suite gate: after a code-bearing bolt run, a green full-suite result
    # must cover the newest CODE commit (a bolt OR an out-of-band edit). Detection-only
    # here (Stop never blocks); the PreToolUse execute-bolts aggregator blocks the NEXT run on FAIL.
    bash "$VALIDATOR_OS" --cwd="$PROJECT_ROOT" --batch-suite-gate --quiet >/dev/null 2>&1 || true
    # B1 postflight evidence: a committed Hard-rule create/extend bolt must carry
    # a passing postflight.json (the post-flight scan was prose-only). Same detect-and-
    # block-next contract — the PreToolUse aggregator blocks the NEXT run on FAIL.
    bash "$VALIDATOR_OS" --cwd="$PROJECT_ROOT" --postflight-scan --quiet >/dev/null 2>&1 || true
    # B3 whitelist observer (S6 EB-GATE-11): bolt commits must stay inside their
    # unit's target_files whitelist (∪ sanctioned extras). Detect-and-block-next.
    bash "$VALIDATOR_OS" --cwd="$PROJECT_ROOT" --whitelist-scan --quiet >/dev/null 2>&1 || true
    # B4 acceptance evidence (P4 v4.96.0): a v5-keyed bolt (SDD-Acceptance:v5
    # commit trailer) must carry fresh passing acceptance.json. Commit-keyed —
    # legacy bolts advisory-only. Detect-and-block-next; the artifact is READ,
    # never re-executed here (B2 parity — no test runs inside a hook).
    bash "$VALIDATOR_OS" --cwd="$PROJECT_ROOT" --acceptance-scan --quiet >/dev/null 2>&1 || true
  fi
fi

# ─── TELEMETRY GATE (turn_end_marker only) ──────────────────────────────────
TELEMETRY_FILE="${PROJECT_ROOT}/.mega-sdd/memory/telemetry.jsonl"
if [ ! -f "$TELEMETRY_FILE" ]; then
  exit 0
fi

# ─── TRANSCRIPT USAGE EXTRACTION (Iter 67.5 — real numbers, not estimates) ───
# Stop hook stdin includes `transcript_path` (per Claude Code spec).
# The transcript is a JSONL file; the LAST assistant message contains usage.
# We extract input_tokens, cache_read_input_tokens, cache_creation_input_tokens,
# and output_tokens — the four numbers that explain "where the 150k went."
# Pass path via env var (not shell interpolation) to avoid quoting bugs.
USAGE_JSON='{}'
if [ -n "$TRANSCRIPT_PATH" ] && [ -f "$TRANSCRIPT_PATH" ]; then
  USAGE_JSON=$(TRANSCRIPT_PATH="$TRANSCRIPT_PATH" python3 -c '
import json, os, sys
path = os.environ.get("TRANSCRIPT_PATH", "")
last_usage = None
try:
    with open(path) as f:
        for line in f:
            try:
                rec = json.loads(line)
            except Exception:
                continue
            msg = rec.get("message") if isinstance(rec.get("message"), dict) else None
            if msg and isinstance(msg.get("usage"), dict):
                last_usage = msg["usage"]
    if last_usage:
        keys = ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens", "output_tokens")
        out = {k: last_usage[k] for k in keys if k in last_usage}
        print(json.dumps(out))
    else:
        print("{}")
except Exception:
    print("{}")
' 2>/dev/null)
fi

# Default fallback
if [ -z "$USAGE_JSON" ]; then USAGE_JSON='{}'; fi

# ─── EMIT turn_end_marker ────────────────────────────────────────────────────
# Schema (Iter 67.5): payload carries real usage from transcript.
# Build the event via plain shell — USAGE_JSON is already valid JSON, embed inline.
STOP_HOOK_ACTIVE_LOWER=$(printf '%s' "$STOP_HOOK_ACTIVE" | tr '[:upper:]' '[:lower:]')
# Normalize Python's "True/False" → JSON "true/false"
case "$STOP_HOOK_ACTIVE_LOWER" in
  true|false) ;;
  *) STOP_HOOK_ACTIVE_LOWER="false" ;;
esac

# Escape SESSION_ID for JSON (rare edge case)
SESSION_ID_JSON=$(printf '%s' "$SESSION_ID" | sed 's|\\|\\\\|g; s|"|\\"|g')

EVENT="{\"ts\":\"$TS\",\"skill\":\"orchestrate-flow\",\"event_type\":\"turn_end_marker\",\"session_id\":\"$SESSION_ID_JSON\",\"hook_source\":\"Stop\",\"payload\":{\"usage\":$USAGE_JSON,\"stop_hook_active\":$STOP_HOOK_ACTIVE_LOWER}}"

echo "$EVENT" >> "$TELEMETRY_FILE" 2>/dev/null || true

# (Removed 2026-06-11: a second, older copy of the handoff-validation block —
# pre-Iter-74 regex — lived here and RE-RAN the validator after the primary
# block above, overwriting its state with the doubled-prefix skill name.
# The primary block near the top of this file is the only validation pass.)

# ─── AUTO-ANALYZE: aggregate state files → CONSISTENCY-REPORT.md ────────────
# Hook-driven auto-chain reporting. Reads existing .*-state.json files written
# by PostToolUse validators during this session. Cheap (no re-run — aggregate
# only), reliable (Stop hook fires deterministically at turn end, not prose).
# Only runs when ≥1 validator state file exists (some validator fired this chain).
if [ -d "${PROJECT_ROOT}/.mega-sdd" ]; then
  STATE_COUNT=$(find "${PROJECT_ROOT}/.mega-sdd" -maxdepth 1 -name ".*-state.json" 2>/dev/null | wc -l | tr -d ' ')
  if [ "$STATE_COUNT" -gt 0 ]; then
    SCRIPT_DIR_AZ="$(cd "$(dirname "$0")" && pwd)"
    ANALYZE_SCRIPT="${SCRIPT_DIR_AZ}/../scripts/run-analyze.sh"
    if [ -x "$ANALYZE_SCRIPT" ]; then
      bash "$ANALYZE_SCRIPT" --cwd="$PROJECT_ROOT" --aggregate-only --quiet >/dev/null 2>&1 || true
    fi
  fi
fi

# NOTE: the compaction advisor was RELOCATED out of this Stop hook (doc audit
# 2026-06-12). Per code.claude.com/docs/en/hooks, plain stdout on a Stop hook is
# debug-log-only (Stop is NOT one of the stdout→context events), and this hook is
# async — so an advisory printed here reached no one. It now lives in
# hooks/user-prompt-submit, where stdout IS added to context per the docs. The
# PreCompact snapshot + SessionStart resume line (both doc-correct) are unchanged.

exit 0
