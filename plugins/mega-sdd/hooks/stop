#!/usr/bin/env bash
# Stop hook for mega-sdd plugin — Iter 67.5 v3.48.0+.
#
# AUDIT RESPONSE (audit 2026-05-27 §A3): Iter 66a shipped Stop hook, smoke test
# passed, but ZERO turn_end_marker events appeared in real-run telemetry.jsonl
# despite the gate condition (telemetry.jsonl exists) being met.
#
# This version (67.5):
# 1. ALWAYS writes a one-line entry to <cwd>/.mega-sdd/memory/hook-debug.log
#    on every invocation, regardless of gates. This is the diagnostic layer —
#    proves the harness is invoking us for this CWD.
# 2. THEN applies opt-out + telemetry-exists gate and emits turn_end_marker
#    with REAL transcript-usage data (input_tokens / cache_read_input_tokens /
#    output_tokens / cache_creation_input_tokens) when available.
#
# Per Claude Code Stop-hook spec, stdin includes transcript_path. We sum the
# `message.usage` blocks of every assistant message THIS TURN appended (v5.13.0 —
# was last-message-only, which under-reported the turn ~11.6x; see the extraction
# block below for the cursor + dedup contract and the measurement).
#
# Exit 0 always (hook must never block turn completion).

set -uo pipefail

# Always read stdin first
# stdin read with a BUILTIN (spec §4b): read -d '' consumes to EOF (JSON has no
# NUL); rc non-zero at EOF by design, hence `|| true`.
STDIN_JSON=""
IFS= read -r -d '' STDIN_JSON || true
[ -n "$STDIN_JSON" ] || STDIN_JSON='{}'

# Parse stdin via python3 (pipe in; script via -c).
# NOTE: emission goes through emit()/shlex.quote, not an f-string — the consumer is
# `eval`, so an unquoted value would be re-parsed by the shell (see the block below).
PARSE_OUTPUT=$(printf '%s' "$STDIN_JSON" | python3 -c '
import json
import shlex
import sys

def emit(key, value):
    print(key + "=" + shlex.quote(str(value)))

try:
    data = json.loads(sys.stdin.read())
except Exception:
    sys.exit(0)

session_id = data.get("session_id", "unknown-session")
cwd = data.get("cwd", "")
transcript_path = data.get("transcript_path", "")
hook_event = data.get("hook_event_name", "")
stop_hook_active = data.get("stop_hook_active", False)

emit("SESSION_ID", session_id)
emit("CWD", cwd)
emit("TRANSCRIPT_PATH", transcript_path)
emit("HOOK_EVENT", hook_event)
emit("STOP_HOOK_ACTIVE", stop_hook_active)
' 2>/dev/null)

# The gating the old comment here asked for is now done at the SOURCE: every value
# above is shlex.quote()d, so eval cannot word-split, strip backslashes (which
# destroyed every Windows cwd/transcript path) or execute an embedded $(…).
if [ -n "$PARSE_OUTPUT" ]; then
  eval "$PARSE_OUTPUT" 2>/dev/null || true
fi

CWD="${CWD:-}"
SESSION_ID="${SESSION_ID:-unknown}"
TRANSCRIPT_PATH="${TRANSCRIPT_PATH:-}"
HOOK_EVENT="${HOOK_EVENT:-}"
STOP_HOOK_ACTIVE="${STOP_HOOK_ACTIVE:-False}"
TS=$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo "unknown-ts")

# ─── OPT-OUT (suppresses BOTH diagnostic + telemetry) ────────────────────────
if [ -z "$CWD" ]; then
  exit 0
fi

# ─── Resolve project root (Iter 71 — class-bug fix) ──────────────────────────
# CWD from stdin may be a sub-folder (model cd'd into .mega-sdd/knowledge-base/
# during a chain step). Walk UP to outermost .mega-sdd/ parent so state files,
# debug log, and telemetry land in the canonical location instead of nested.
# Script-dir via parameter expansion (spec §4b — no dirname exec); $0 is
# absolute in the shipped dispatch; the subshell fallback covers relative $0.
SCRIPT_DIR_RPR="${0%/*}"
case "$SCRIPT_DIR_RPR" in
  /*) ;;
  *) SCRIPT_DIR_RPR="$(cd "$(dirname "$0")" && pwd 2>/dev/null)" ;;
esac
RPR_HELPER="${SCRIPT_DIR_RPR}/../scripts/_lib/resolve-project-root.sh"
if [ -f "$RPR_HELPER" ]; then
  # shellcheck disable=SC1090
  . "$RPR_HELPER"
  PROJECT_ROOT=$(resolve_project_root "$CWD")
else
  PROJECT_ROOT="$CWD"
fi

CONFIG_FILE="${PROJECT_ROOT}/.mega-sdd/config.yaml"
if [ -f "$CONFIG_FILE" ]; then
  if grep -qE "^\s*telemetry:\s*false" "$CONFIG_FILE" 2>/dev/null; then
    exit 0
  fi
fi

# ─── DIAGNOSTIC LAYER (Iter 67.5 — verify harness invocation) ────────────────
# Per audit response: prove the harness is invoking us for the project CWD.
# If hook-debug.log doesn't grow on every Stop event, the hook is not being called.
# Only writes for mega-sdd projects (avoids polluting unrelated CWDs).
if [ -d "${PROJECT_ROOT}/.mega-sdd" ]; then
  DEBUG_DIR="${PROJECT_ROOT}/.mega-sdd/memory"
  mkdir -p "$DEBUG_DIR" 2>/dev/null || true
  DEBUG_LOG="${DEBUG_DIR}/hook-debug.log"
  DEBUG_LINE="$(printf '{"ts":"%s","hook":"stop","session_id":"%s","cwd":"%s","transcript_path":"%s","stop_hook_active":"%s","stdin_bytes":%s}' \
    "$TS" "$SESSION_ID" "$CWD" "$TRANSCRIPT_PATH" "$STOP_HOOK_ACTIVE" "${#STDIN_JSON}")"
  echo "$DEBUG_LINE" >> "$DEBUG_LOG" 2>/dev/null || true
fi

# ─── HANDOFF VALIDATION (Phase B slice B.1, v3.53.0+) ───────────────────────
# Runs BEFORE telemetry gate — state file is the primary artifact (independent
# of telemetry). Telemetry emission is conditional on telemetry.jsonl existing.
# Only runs if .mega-sdd/ exists (already implicitly true at this point since
# we wrote hook-debug.log above which has the same guard).
if [ -d "${PROJECT_ROOT}/.mega-sdd" ] && [ -n "$TRANSCRIPT_PATH" ] && [ -f "$TRANSCRIPT_PATH" ]; then
  # Prefer the documented stdin field (Stop input carries last_assistant_message —
  # no transcript parse needed); fall back to transcript scan for older CC versions.
  LAST_ASSISTANT_TEXT=$(printf '%s' "$STDIN_JSON" | python3 -c 'import json,sys
try:
    print(json.loads(sys.stdin.read()).get("last_assistant_message") or "")
except Exception:
    pass' 2>/dev/null)
  if [ -z "$LAST_ASSISTANT_TEXT" ]; then
  LAST_ASSISTANT_TEXT=$(TRANSCRIPT_PATH="$TRANSCRIPT_PATH" python3 -c '
import json, os
last_text = None
with open(os.environ["TRANSCRIPT_PATH"]) as f:
    for line in f:
        try:
            rec = json.loads(line)
        except Exception:
            continue
        msg = rec.get("message") if isinstance(rec.get("message"), dict) else None
        if not msg:
            continue
        if msg.get("role") != "assistant":
            continue
        content = msg.get("content")
        if isinstance(content, str):
            last_text = content
        elif isinstance(content, list):
            parts = []
            for block in content:
                if isinstance(block, dict) and block.get("type") == "text":
                    parts.append(block.get("text", ""))
            if parts:
                last_text = "\n".join(parts)
if last_text:
    print(last_text)
' 2>/dev/null)
  fi

  # Only invoke validator if response contains "handoff:" marker (skip otherwise — skill may not be expected to emit)
  if [ -n "$LAST_ASSISTANT_TEXT" ] && echo "$LAST_ASSISTANT_TEXT" | grep -q "handoff:"; then
    SCRIPT_DIR_HV="$(cd "$(dirname "$0")" && pwd)"
    VALIDATOR_HV="${SCRIPT_DIR_HV}/../scripts/validate-handoff-yaml.sh"
    if [ -x "$VALIDATOR_HV" ]; then
      # Iter 74 fix (audit 2026-05-29 §post-3.65.0 doubled-prefix bug):
      # handoff-contract.md says `emitted_by: <skill-name>` should be the bare
      # skill (e.g., "extract-intelligence"), but producers in the wild emit
      # both forms — `emitted_by: extract-intelligence` AND `emitted_by:
      # mega-sdd:extract-intelligence`. The pre-Iter-74 regex `[\w-]+` stopped
      # at the colon, captured just "mega-sdd", then prepended "mega-sdd:"
      # again → "mega-sdd:mega-sdd". This (a) breaks Iter 70 producer-self-fix
      # matching (SKILL_NAME never equals "mega-sdd:mega-sdd"), (b) shows up
      # cosmetically in PreToolUse block messages. Match both forms now:
      # extended regex tolerates optional "mega-sdd:" prefix on the value;
      # downstream code unconditionally prepends.
      INFERRED_SKILL=$(echo "$LAST_ASSISTANT_TEXT" | python3 -c '
import sys, re
text = sys.stdin.read()
m = re.search(r"^\s*emitted_by:\s*(?:mega-sdd:)?([\w-]+)", text, re.MULTILINE)
print(m.group(1) if m else "unknown")
' 2>/dev/null)
      printf '%s' "$LAST_ASSISTANT_TEXT" | bash "$VALIDATOR_HV" --cwd="$PROJECT_ROOT" --skill-name="mega-sdd:${INFERRED_SKILL:-unknown}" --quiet >/dev/null 2>&1 || true
      # Emit telemetry event ONLY if telemetry.jsonl already exists (consistent with turn_end_marker gate)
      STATE_FILE_HV="${PROJECT_ROOT}/.mega-sdd/.handoff-validation-state.json"
      TELEMETRY_FILE_PRECHECK="${PROJECT_ROOT}/.mega-sdd/memory/telemetry.jsonl"
      if [ -f "$STATE_FILE_HV" ] && [ -f "$TELEMETRY_FILE_PRECHECK" ]; then
        HANDOFF_EVENT=$(STATE_FILE_HV="$STATE_FILE_HV" TS_ENV="$TS" SESSION_ID_ENV="$SESSION_ID" python3 -c '
import json, os
try:
    d = json.load(open(os.environ["STATE_FILE_HV"]))
    status = d["status"]
    ht = d.get("halt_type") or "handoff_validated_pass"
    rc = d.get("retry_count", 0)
    esc = d.get("escalate_to_c2", False)
    et = "halt_self_resolved" if status == "PASS" else ("halt_fired" if esc else "halt_self_resolved")
    fix_applied = "handoff validator ran" if status == "PASS" else f"detected {ht}; retry={rc}"
    payload = {
        "halt_type": ht,
        "fix_applied": fix_applied,
        "original_emit_site": "Stop-hook-handoff-validator",
        "logged_at_chat": False,
        "retry_count": rc,
        "escalate_to_c2": esc,
        "skill_name": d.get("skill_name"),
    }
    print(json.dumps({
        "ts": os.environ["TS_ENV"],
        "skill": "orchestrate-flow",
        "event_type": et,
        "session_id": os.environ["SESSION_ID_ENV"],
        "hook_source": "Stop",
        "payload": payload,
    }, separators=(",", ":")))
except Exception:
    pass
' 2>/dev/null)
        if [ -n "$HANDOFF_EVENT" ]; then
          echo "$HANDOFF_EVENT" >> "$TELEMETRY_FILE_PRECHECK" 2>/dev/null || true
        fi
      fi
    fi
  fi
fi

# ─── BOLT ORPHAN SCAN (clinic-project audit 2026-06-12) ─────────────────────
# Runs on EVERY Stop for a mega-sdd git project — unconditionally, NOT only when
# an --auto handoff was emitted. Closes the interactive-run gap: bolt commits
# with no <vault>/bolts/U-XXX/bolt-report.md were invisible to every gate
# (the handoff validator above only fires on a "handoff:" marker; the
# file-scoped artifact validator never fires for a file that was never
# written). Detection-only here (Stop must never block); the PreToolUse
# execute-bolts aggregator blocks the NEXT run on the FAIL state.
if [ -d "${PROJECT_ROOT}/.mega-sdd" ]; then
  SCRIPT_DIR_OS="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
  VALIDATOR_OS="${SCRIPT_DIR_OS}/../scripts/validate-bolt-artifacts.sh"
  if [ -f "$VALIDATOR_OS" ]; then
    # ── Turn-gate (spec §4c): run the scans only on turns that could change their
    # verdict. All five scans key on COMMITS + EVIDENCE ARTIFACTS, so two cheap
    # probes cover every input: (a) HEAD vs the sha stamped at the last scan,
    # (b) any write/delete under .mega-sdd since the stamp (dir-mtime catches
    # deletions), EXCLUDING memory/ + .cache/ (this hook itself appends the debug
    # log there every firing — without the prune the gate would never skip).
    # A skipped turn leaves the state files exactly as the last scan wrote them —
    # still-true verdicts — and the PreToolUse execute-bolts gate re-derives all
    # of them anyway (S6 EB-GATE-1), so a stale skip can never open a gate.
    # Fail TOWARD scanning: stamp absent, HEAD unresolvable, or any probe doubt
    # → scan. The stamp is written only AFTER the scans complete (a crash
    # re-scans next turn), and only when HEAD resolved.
    STOP_SCAN_STAMP="${PROJECT_ROOT}/.mega-sdd/.stop-scan-stamp"
    NEED_ARTIFACT_SCAN=1
    CUR_HEAD_SS=$(git -C "$PROJECT_ROOT" rev-parse HEAD 2>/dev/null || printf '')
    if [ -f "$STOP_SCAN_STAMP" ] && [ -n "$CUR_HEAD_SS" ]; then
      LAST_HEAD_SS=""
      IFS= read -r LAST_HEAD_SS < "$STOP_SCAN_STAMP" 2>/dev/null || LAST_HEAD_SS=""
      if [ "$CUR_HEAD_SS" = "$LAST_HEAD_SS" ]; then
        # Legacy vault layouts keep evidence under docs/mega-sdd/ — probe it too
        # when present (${VAR:+"$VAR"} keeps quoting; absent dir adds no arg).
        LEGACY_SS=""
        [ -d "${PROJECT_ROOT}/docs/mega-sdd" ] && LEGACY_SS="${PROJECT_ROOT}/docs/mega-sdd"
        # Excluded from the probe (round-1 F1): the four auto-analyze/report
        # OUTPUTS this hook's own tail rewrites every firing — they are derived
        # FROM the scan states, never inputs to the scans; without the exclusion
        # the gate never skips in any telemetry-active project. Round-1 F2:
        # capture find's rc — a failed probe is DOUBT and must scan, never read
        # as "no change" (no head, so no SIGPIPE rc distortion; output size is
        # bounded by the .mega-sdd tree listing).
        # -mindepth 1: the .mega-sdd ROOT dir's own mtime bumps on every direct-
        # child write (the stamp itself, analyze temp/renames) — pure noise; the
        # real deletion signal lives in SUBDIR mtimes (vaults/*/bolts), still probed.
        # Spec §4e widened this prune list (disclosed 4e scope): every validator
        # STATE file, both scan stamps, and the dirty-paths journal are derived
        # OUTPUTS — the five scans key on commits + evidence artifacts only, and
        # none of these is either. Without the widening, the PostToolUse
        # validators' per-write state rewrites (and 4e's own stamp) would
        # re-trigger these scans every write-bearing turn and silently undo §4c.
        CHANGED_SS=$(find "${PROJECT_ROOT}/.mega-sdd" ${LEGACY_SS:+"$LEGACY_SS"} -mindepth 1 \
          \( -name memory -o -name .cache \) -prune -o \
          \( -name .analyze-state.json -o -name CONSISTENCY-REPORT.md \
             -o -name .analyze-freshness.json \
             -o -name claims-ledger.json \
             -o -name TOKEN-COST-REPORT.md -o -name .token-cost-state.json \
             -o -name '.*-state.json' -o -name .validation-blockers.json \
             -o -name .ui-quality-blockers.json -o -name .stop-scan-stamp \
             -o -name .ptu-scan-stamp -o -name .dirty-paths.jsonl \
             -o -name state.json -o -name graph.json \
             -o -name .locked-files-index.json \
             -o -name .compaction-snapshot.json \) -prune -o \
          -newer "$STOP_SCAN_STAMP" -print 2>/dev/null)
        FIND_RC_SS=$?
        [ "$FIND_RC_SS" -eq 0 ] && [ -z "$CHANGED_SS" ] && NEED_ARTIFACT_SCAN=0
      fi
    fi
    if [ "$NEED_ARTIFACT_SCAN" = "1" ]; then
      # ONE composable invocation (spec §4a-ii) — orphan + B2 batch-suite + B1
      # postflight + B3 whitelist + B4 acceptance. Detection-only here (Stop never
      # blocks); the PreToolUse execute-bolts aggregator blocks the NEXT run on
      # FAIL. NOTE: no --recompute on this lane (unchanged) — recompute-at-gate
      # belongs to the blocking PreToolUse path; the artifacts are READ here,
      # never re-executed (no test runs inside a hook).
      bash "$VALIDATOR_OS" --cwd="$PROJECT_ROOT" --orphan-scan --batch-suite-gate --postflight-scan --whitelist-scan --acceptance-scan --quiet >/dev/null 2>&1
      SCAN_RC_SS=$?
      # Stamp ONLY when the composed scan actually evaluated (rc 0 = clean,
      # 1 = findings recorded). An errored scan (rc 2 — e.g. a git timeout's
      # "gate NOT evaluated") must NOT mark the turn as scanned: fail toward
      # scanning, per the contract (round-1 IMP-1).
      if [ -n "$CUR_HEAD_SS" ] && { [ "$SCAN_RC_SS" -eq 0 ] || [ "$SCAN_RC_SS" -eq 1 ]; }; then
        printf '%s\n' "$CUR_HEAD_SS" > "$STOP_SCAN_STAMP" 2>/dev/null || true
      fi
    fi
  fi
fi

# ─── TELEMETRY GATE (turn_end_marker only) ──────────────────────────────────
TELEMETRY_FILE="${PROJECT_ROOT}/.mega-sdd/memory/telemetry.jsonl"
if [ ! -f "$TELEMETRY_FILE" ]; then
  exit 0
fi

# ─── TRANSCRIPT USAGE EXTRACTION (v5.13.0 — per-turn window, deduped) ────────
# Stop hook stdin includes `transcript_path` (per Claude Code spec).
#
# WHY THIS IS NOT "read the last message" (the Iter 67.5 shape, fixed here):
# a turn is MANY assistant messages (one per tool round trip), and the last one
# carries only the FINAL message's usage. Measured over 10 real session
# transcripts / 547 turns, last-message-only under-reports the turn by ~11.6x
# aggregate (median 9.5x, range 2.8-18.3x). `hooks/subagent-stop` already carried
# the same correction for the subagent lane; this is the main lane catching up.
#
# WHY A CURSOR AND NOT "sum the file": the subagent transcript is read ONCE at the
# subagent boundary, so summing it whole is correct there. The MAIN transcript is
# append-only for the whole session and this hook fires at EVERY turn end — summing
# the file each time would re-emit the cumulative total every turn (O(N^2)). So we
# keep a per-session byte cursor and sum only what was appended since last firing.
# The cursor is per-session (never shared) so two concurrent sessions cannot
# ping-pong one offset between their two transcripts.
#
# WHY DEDUP BY message.id: the harness writes ONE JSONL record per content block,
# all sharing one message.id and REPEATING the same usage object. Measured 2.47x
# aggregate over-count if summed blindly (verified: duplicate records are usage-
# identical, 0 divergent out of 56 duplicated ids in a 548-record transcript).
#
# NOTE on `usage.iterations` — do NOT "fix" the top-level read to sum it. Top-level
# usage is already the sum of the `type:"message"` iterations; the extra
# `type:"advisor_message"` iterations are a DIFFERENT model lane the harness
# deliberately excludes. Verified exact on multi-iteration messages.
#
# Also captured: the exact cache_creation TTL split (`usage.cache_creation.
# ephemeral_{5m,1h}_input_tokens`) so report-token-cost.sh can price cache creation
# at its real rate instead of assuming a TTL, and `message.model` for per-turn model
# attribution. Pass paths via env var (not shell interpolation) to avoid quoting bugs.
PAYLOAD_FIELDS='"usage":{}'
if [ -n "$TRANSCRIPT_PATH" ] && [ -f "$TRANSCRIPT_PATH" ]; then
  PF_OUT=$(TRANSCRIPT_PATH="$TRANSCRIPT_PATH" PROJECT_ROOT="$PROJECT_ROOT" SESSION_ID="$SESSION_ID" python3 -c '
import json, os, sys

path = os.environ.get("TRANSCRIPT_PATH", "")
root = os.environ.get("PROJECT_ROOT", "")
sid = os.environ.get("SESSION_ID", "")
KEYS = ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens", "output_tokens")

def out(frag):
    print(frag)
    sys.exit(0)

try:
    safe = "".join(c if (c.isalnum() or c in "-_") else "-" for c in sid)[:64] or "unknown"
    cursor_path = os.path.join(root, ".mega-sdd", "memory", ".turn-usage-cursor-" + safe + ".json")
    cur = {}
    try:
        with open(cursor_path) as cf:
            cur = json.load(cf)
    except Exception:
        cur = {}
    if not isinstance(cur, dict):
        cur = {}
    offset = cur.get("offset", 0)
    if not isinstance(offset, int) or offset < 0:
        offset = 0
    prev_ids = cur.get("last_ids", [])
    if not isinstance(prev_ids, list):
        prev_ids = []
    if cur.get("transcript_path") != path:
        offset = 0
        prev_ids = []
    size = os.path.getsize(path)
    # Truncated / rewritten transcript: skip to the new EOF rather than re-counting
    # from 0. For an instrument, one under-reported turn beats one fabricated spike.
    if size < offset:
        offset = size
    with open(path, "rb") as tf:
        tf.seek(offset)
        data = tf.read()
    consumed = len(data)
    lines = data.split(b"\n")
    if data and not data.endswith(b"\n"):
        # A partially flushed trailing line stays for the next firing.
        consumed -= len(lines.pop())
    tot = {k: 0 for k in KEYS}
    cc5 = 0
    cc1 = 0
    model = ""
    prev = set(prev_ids)
    seen = []
    seen_set = set()
    nameless = 0
    for raw in lines:
        if not raw.strip():
            continue
        try:
            rec = json.loads(raw.decode("utf-8", "replace"))
        except Exception:
            continue
        # A sidechain turn is billed by SubagentStop against the subagent OWN nested
        # transcript. Counting it here too would double-count the bolt/panel lane.
        if rec.get("isSidechain"):
            continue
        msg = rec.get("message") if isinstance(rec.get("message"), dict) else None
        if not (msg and isinstance(msg.get("usage"), dict)):
            continue
        mid = msg.get("id")
        # Dedup only on a REAL id. A message with no id has no identity to dedup on,
        # so collapsing those would silently drop distinct turns.
        # prev_ids: a window boundary can split at most one message (all records for
        # one id are written contiguously), so carrying the previous window ids is
        # enough to stop a straddling message being counted in both windows.
        if isinstance(mid, str) and mid:
            if mid in seen_set or mid in prev:
                continue
            seen_set.add(mid)
            seen.append(mid)
        else:
            nameless += 1
        u = msg["usage"]
        if not model and isinstance(msg.get("model"), str):
            model = msg["model"]
        for k in KEYS:
            v = u.get(k, 0)
            if isinstance(v, (int, float)):
                tot[k] += int(v)
        cc = u.get("cache_creation")
        if isinstance(cc, dict):
            v5 = cc.get("ephemeral_5m_input_tokens", 0)
            v1 = cc.get("ephemeral_1h_input_tokens", 0)
            if isinstance(v5, (int, float)):
                cc5 += int(v5)
            if isinstance(v1, (int, float)):
                cc1 += int(v1)
    try:
        with open(cursor_path, "w") as cf:
            json.dump({"transcript_path": path, "offset": offset + consumed,
                       "last_ids": seen if seen else prev_ids}, cf)
    except Exception:
        pass
    if not seen and not nameless:
        out("\"usage\":{}")
    usage = dict(tot)
    usage["cache_creation_5m_input_tokens"] = cc5
    usage["cache_creation_1h_input_tokens"] = cc1
    frag = "\"usage\":" + json.dumps(usage, separators=(",", ":"))
    frag = frag + ",\"messages\":" + str(len(seen) + nameless)
    if model:
        frag = frag + ",\"model\":" + json.dumps(model)
    out(frag)
except Exception:
    out("\"usage\":{}")
' 2>/dev/null)
  if [ -n "$PF_OUT" ]; then PAYLOAD_FIELDS="$PF_OUT"; fi
fi

# Default fallback
if [ -z "$PAYLOAD_FIELDS" ]; then PAYLOAD_FIELDS='"usage":{}'; fi

# ─── EMIT turn_end_marker ────────────────────────────────────────────────────
# Schema (Iter 67.5): payload carries real usage from transcript.
# Build the event via plain shell — USAGE_JSON is already valid JSON, embed inline.
STOP_HOOK_ACTIVE_LOWER=$(printf '%s' "$STOP_HOOK_ACTIVE" | tr '[:upper:]' '[:lower:]')
# Normalize Python's "True/False" → JSON "true/false"
case "$STOP_HOOK_ACTIVE_LOWER" in
  true|false) ;;
  *) STOP_HOOK_ACTIVE_LOWER="false" ;;
esac

# Escape SESSION_ID for JSON (rare edge case)
SESSION_ID_JSON=$(printf '%s' "$SESSION_ID" | sed 's|\\|\\\\|g; s|"|\\"|g')

EVENT="{\"ts\":\"$TS\",\"skill\":\"orchestrate-flow\",\"event_type\":\"turn_end_marker\",\"session_id\":\"$SESSION_ID_JSON\",\"hook_source\":\"Stop\",\"payload\":{$PAYLOAD_FIELDS,\"stop_hook_active\":$STOP_HOOK_ACTIVE_LOWER}}"

echo "$EVENT" >> "$TELEMETRY_FILE" 2>/dev/null || true

# (Removed 2026-06-11: a second, older copy of the handoff-validation block —
# pre-Iter-74 regex — lived here and RE-RAN the validator after the primary
# block above, overwriting its state with the doubled-prefix skill name.
# The primary block near the top of this file is the only validation pass.)

# ─── AUTO-ANALYZE: aggregate state files → CONSISTENCY-REPORT.md ────────────
# Hook-driven auto-chain reporting. Reads existing .*-state.json files written
# by PostToolUse validators during this session. Cheap (no re-run — aggregate
# only), reliable (Stop hook fires deterministically at turn end, not prose).
# Only runs when ≥1 validator state file exists (some validator fired this chain).
# P3 lean-by-default: this ADVISORY aggregate fires only when the config
# explicitly opts back in — `spine: classic` OR `profile: full` (the reports
# are re-derivable on demand via /mega-sdd:analyze; no gate reads them — the
# four outputs are already pruned from both scan probes). The old opt-OUT
# (`profile: lean` skips) is subsumed: absent config = express spine = skip.
if [ -d "${PROJECT_ROOT}/.mega-sdd" ] && \
   { grep -m1 -E "^spine:" "${PROJECT_ROOT}/.mega-sdd/config.yaml" 2>/dev/null | grep -qE "^spine:[[:space:]]*[\"']?classic[\"']?[[:space:]]*(\r)?(#.*)?$" || \
     grep -m1 -E "^profile:" "${PROJECT_ROOT}/.mega-sdd/config.yaml" 2>/dev/null | grep -qE "^profile:[[:space:]]*[\"']?full[\"']?[[:space:]]*(\r)?(#.*)?$"; } && \
   ! { grep -m1 -E "^profile:" "${PROJECT_ROOT}/.mega-sdd/config.yaml" 2>/dev/null | grep -qE "^profile:[[:space:]]*[\"']?lean[\"']?[[:space:]]*(\r)?(#.*)?$"; }; then
  STATE_COUNT=$(find "${PROJECT_ROOT}/.mega-sdd" -maxdepth 1 -name ".*-state.json" 2>/dev/null | wc -l | tr -d ' ')
  if [ "$STATE_COUNT" -gt 0 ]; then
    SCRIPT_DIR_AZ="$(cd "$(dirname "$0")" && pwd)"
    ANALYZE_SCRIPT="${SCRIPT_DIR_AZ}/../scripts/run-analyze.sh"
    if [ -x "$ANALYZE_SCRIPT" ]; then
      bash "$ANALYZE_SCRIPT" --cwd="$PROJECT_ROOT" --aggregate-only --quiet >/dev/null 2>&1 || true
    fi
  fi
fi

# NOTE: the compaction advisor was RELOCATED out of this Stop hook (doc audit
# 2026-06-12). Per code.claude.com/docs/en/hooks, plain stdout on a Stop hook is
# debug-log-only (Stop is NOT one of the stdout→context events), and this hook is
# async — so an advisory printed here reached no one. It now lives in
# hooks/user-prompt-submit, where stdout IS added to context per the docs. The
# PreCompact snapshot + SessionStart resume line (both doc-correct) are unchanged.

exit 0
