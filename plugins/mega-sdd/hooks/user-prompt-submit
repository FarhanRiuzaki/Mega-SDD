#!/usr/bin/env bash
# UserPromptSubmit hook for mega-sdd — phase-aware compaction advisor.
#
# Relocated here from the Stop hook (doc audit 2026-06-12): per
# code.claude.com/docs/en/hooks, stdout on UserPromptSubmit "is added as context
# that Claude can see and act on" — unlike Stop, whose stdout is debug-log-only.
# So a per-turn advisory belongs here. Reads true context size from the
# transcript usage, and when over 80% of the window AND a mega-sdd chain is in
# flight, prints ONE line so Claude can suggest /compact at a phase boundary.
# Advisory only (never blocks; exit 0). Opt-out: compaction_notice: false.

set -uo pipefail
STDIN_JSON=$(cat 2>/dev/null || echo '{}')

# ─── Fast negative short-circuit (pure shell, BEFORE the python3 parse) ───────
# This hook fires on EVERY user prompt in EVERY project; resolve cwd + project
# root in pure shell and exit 0 BEFORE paying a python3 cold-start (~30-150ms;
# ~220ms+/spawn on EDR-scanned Windows) when there is no .mega-sdd ancestor —
# the common case. Same builtin last-match cwd extraction + resolve_project_root
# walk-up as hooks/pre-tool-use, so the .mega-sdd decision is byte-identical;
# when the cwd can't be extracted OR the resolver helper is absent, it does NOT
# short-circuit — it falls through to the authoritative python parse below.
# Context-neutral: the fast path exits silently only on non-mega-sdd projects,
# where this hook printed nothing anyway.
SC_CWD=""
SC_REST="$STDIN_JSON"
while [[ "$SC_REST" =~ \"cwd\"[[:space:]]*:[[:space:]]*\"([^\"]*)\"(.*) ]]; do
  SC_CWD="${BASH_REMATCH[1]}"
  SC_REST="${BASH_REMATCH[2]}"
done
if [ -n "$SC_CWD" ]; then
  SC_SCRIPT_DIR="${0%/*}"
  case "$SC_SCRIPT_DIR" in
    /*) ;;
    *) SC_SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd 2>/dev/null)" ;;
  esac
  SC_RPR="${SC_SCRIPT_DIR}/../scripts/_lib/resolve-project-root.sh"
  if [ -f "$SC_RPR" ]; then
    # shellcheck disable=SC1090
    . "$SC_RPR"
    SC_ROOT=$(resolve_project_root "$SC_CWD")
    if [ ! -d "${SC_ROOT}/.mega-sdd" ]; then exit 0; fi

    # ── v7 (spec §3.5): the trace tag moves to pure shell, and the O(session)
    # transcript scan below becomes CHAIN-SCOPED. A tier-S prompt in a mega-sdd
    # project now costs: 0 forks, ~6 tok (the tag). Fail-closed: extraction
    # doubt falls through to the python path (which re-applies the same gates).
    SC_CFG_C=""
    [ -f "${SC_ROOT}/.mega-sdd/config.yaml" ] && { { SC_CFG_C="$(<"${SC_ROOT}/.mega-sdd/config.yaml")"; } 2>/dev/null || SC_CFG_C=""; }
    # anchored to line start (review R-5): a commented/prefixed key must not match
    SC_NL=$'\n'
    if [[ ! "$SC_CFG_C" =~ (^|$SC_NL)[[:space:]]*trace_tag:[[:space:]]*false ]]; then
      echo "mega-sdd-trace:turn"
    fi
    V7_TAG_DONE=1
    if [[ "$SC_CFG_C" =~ (^|$SC_NL)[[:space:]]*telemetry:[[:space:]]*false ]] || [[ "$SC_CFG_C" =~ (^|$SC_NL)[[:space:]]*compaction_notice:[[:space:]]*false ]]; then
      exit 0
    fi
    # Size cap (review R-6): a huge pasted prompt makes the bash scans below
    # costlier than the python they avoid — take the classic path instead.
    if [ "${#STDIN_JSON}" -gt 262144 ]; then SC_SKIP_ARMED=1; else SC_SKIP_ARMED=0; fi
    if [ "$SC_SKIP_ARMED" -eq 0 ]; then
    # armed check (same contract as pre/post-tool-use; subagent sentinels kept
    # for symmetry although UserPromptSubmit is a main-session event)
    case "$STDIN_JSON" in *'"agent_id"'*|*'"parent_tool_use_id"'*|*agent_transcript_path*) : ;; *)
      if [ ! -f "${SC_ROOT}/.mega-sdd/.plan-pending" ]; then
        SC_SID=""
        SC_R="$STDIN_JSON"
        while [[ "$SC_R" =~ \"session_id\"[[:space:]]*:[[:space:]]*\"([^\"]*)\"(.*) ]]; do
          SC_SID="${BASH_REMATCH[1]}"; SC_R="${BASH_REMATCH[2]}"
        done
        if [ -n "$SC_SID" ]; then
          SC_GG="${SC_ROOT}/.mega-sdd/.gateguard-state.json"
          if [ ! -f "$SC_GG" ]; then exit 0; fi
          SC_GG_C=""
          { SC_GG_C="$(<"$SC_GG")"; } 2>/dev/null || SC_GG_C=""
          if [ -n "$SC_GG_C" ]; then
            case "$SC_GG_C" in
              *"\"$SC_SID\": true"*|*"\"$SC_SID\":true"*) : ;;  # engaged_sessions map
              *"\"session_id\": \"$SC_SID\""*|*"\"session_id\":\"$SC_SID\""*)
                case "$SC_GG_C" in
                  *'"chain_engaged": true'*|*'"chain_engaged":true'*) : ;;
                  *) exit 0 ;;
                esac ;;
              *) exit 0 ;;
            esac
          fi
        fi
      fi
    ;; esac
    fi  # size cap
  fi
fi

# shlex.quote() is load-bearing: the consumer is `eval`, which re-parses a bare
# `KEY=value` — dropping any value with a space, eating backslashes (so a Windows
# cwd arrived as `C:proj`), and executing an embedded $(…).
PARSE=$(printf '%s' "$STDIN_JSON" | python3 -c 'import json,shlex,sys
try: d=json.loads(sys.stdin.read())
except Exception: sys.exit(0)
print("CWD=" + shlex.quote(str(d.get("cwd",""))))
print("TRANSCRIPT=" + shlex.quote(str(d.get("transcript_path",""))))' 2>/dev/null)
[ -n "$PARSE" ] || exit 0
eval "$PARSE" 2>/dev/null || true
[ -n "${CWD:-}" ] || exit 0

# Resolve project root; quick-exit for non-mega-sdd projects (the common case).
SCRIPT_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
RPR="${SCRIPT_DIR}/../scripts/_lib/resolve-project-root.sh"
PROJECT_ROOT="$CWD"
if [ -f "$RPR" ]; then . "$RPR"; PROJECT_ROOT=$(resolve_project_root "$CWD"); fi
[ -d "${PROJECT_ROOT}/.mega-sdd" ] || exit 0

CFG="${PROJECT_ROOT}/.mega-sdd/config.yaml"

# ─── Per-iteration observability tag (v5.2.7) ────────────────────────────────
# One fresh `mega-sdd-trace:turn` line per user prompt in mega-sdd projects —
# the AI-gateway/Langfuse full-text filter contract. session-start stamps the
# session (`mega-sdd-trace:session`, carried in every request body via history);
# this stamp marks each iteration's LATEST message for gateways that index only
# the newest delta. Opt-out: `trace_tag: false` in .mega-sdd/config.yaml.
if [ "${V7_TAG_DONE:-0}" -eq 0 ]; then
  if [ ! -f "$CFG" ] || ! grep -qE "^[[:space:]]*trace_tag:[[:space:]]*false" "$CFG" 2>/dev/null; then
    echo "mega-sdd-trace:turn"
  fi
fi

if [ -f "$CFG" ]; then
  grep -qE "^[[:space:]]*telemetry:[[:space:]]*false" "$CFG" 2>/dev/null && exit 0
  grep -qE "^[[:space:]]*compaction_notice:[[:space:]]*false" "$CFG" 2>/dev/null && exit 0
fi
[ -n "${TRANSCRIPT:-}" ] && [ -f "$TRANSCRIPT" ] || exit 0

# Sum the latest transcript usage (input + cache_read + cache_creation) = true
# context size. The real window is NOT the [1m] display marker — that alias
# never reaches the transcript's message.model (it records the wire id, e.g.
# claude-opus-4-8 / claude-fable-5), so the old substring test always fell back
# to 200k and over-reported every 1M session ~5x. Resolve it conservatively.
TRANSCRIPT="$TRANSCRIPT" PROOT="$PROJECT_ROOT" python3 <<'PYEOF' 2>/dev/null || true
import glob, json, os

path = os.environ["TRANSCRIPT"]
proot = os.environ["PROOT"]

def usage_ctx(u):
    return (u.get("input_tokens", 0) or 0) + (u.get("cache_read_input_tokens", 0) or 0) + (u.get("cache_creation_input_tokens", 0) or 0)

last_usage, model, peak_ctx = None, "", 0
try:
    with open(path) as f:
        for line in f:
            try:
                rec = json.loads(line)
            except Exception:
                continue
            msg = rec.get("message") if isinstance(rec.get("message"), dict) else None
            if msg and isinstance(msg.get("usage"), dict):
                last_usage = msg["usage"]
                peak_ctx = max(peak_ctx, usage_ctx(last_usage))
                mm = msg.get("model")
                if mm and mm != "<synthetic>":  # synthetic turns carry no real model id
                    model = mm
except Exception:
    raise SystemExit(0)
if not last_usage:
    raise SystemExit(0)

ctx = usage_ctx(last_usage)
if ctx <= 0:
    raise SystemExit(0)

# Resolve the real window from three signals, biased to the LARGER window (a
# false silence is harmless — PreCompact still snapshots; a false /compact nag
# burns the user's real context). 1M when: the [1m] marker is present; OR the
# model is a current 1M-context family; OR the context PHYSICALLY exceeded 200k
# at any point (a true 200k session would have auto-compacted first — proof the
# window is >200k). Else the 200k default.
mlow = model.lower()
is_1m = ("[1m]" in mlow
         or mlow.startswith(("claude-opus-4", "claude-sonnet-4", "claude-fable"))
         or peak_ctx > 200_000)
window = 1_000_000 if is_1m else 200_000
if ctx < int(window * 0.80):
    raise SystemExit(0)
# only when a mega-sdd chain is in flight (a vault with units exists)
if not glob.glob(os.path.join(proot, ".mega-sdd", "vaults", "*", "units", "U-*.md")):
    raise SystemExit(0)

print("mega-sdd: context ~%dk of ~%dk (%d%%) — a phase boundary is the safe place to /compact (pipeline state is snapshotted on compaction). Avoid compacting mid-bolt." % (ctx // 1000, window // 1000, ctx * 100 // window))
PYEOF
exit 0
