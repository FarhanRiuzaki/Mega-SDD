#!/usr/bin/env bash
# UserPromptSubmit hook for mega-sdd — phase-aware compaction advisor.
#
# Relocated here from the Stop hook (doc audit 2026-06-12): per
# code.claude.com/docs/en/hooks, stdout on UserPromptSubmit "is added as context
# that Claude can see and act on" — unlike Stop, whose stdout is debug-log-only.
# So a per-turn advisory belongs here. Reads true context size from the
# transcript usage, and when over 80% of the window AND a mega-sdd chain is in
# flight, prints ONE line so Claude can suggest /compact at a phase boundary.
# Advisory only (never blocks; exit 0). Opt-out: compaction_notice: false.

set -uo pipefail
STDIN_JSON=$(cat 2>/dev/null || echo '{}')

PARSE=$(printf '%s' "$STDIN_JSON" | python3 -c 'import json,sys
try: d=json.loads(sys.stdin.read())
except Exception: sys.exit(0)
print("CWD=%s" % d.get("cwd",""))
print("TRANSCRIPT=%s" % d.get("transcript_path",""))' 2>/dev/null)
[ -n "$PARSE" ] || exit 0
eval "$PARSE" 2>/dev/null || true
[ -n "${CWD:-}" ] || exit 0

# Resolve project root; quick-exit for non-mega-sdd projects (the common case).
SCRIPT_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
RPR="${SCRIPT_DIR}/../scripts/_lib/resolve-project-root.sh"
PROJECT_ROOT="$CWD"
if [ -f "$RPR" ]; then . "$RPR"; PROJECT_ROOT=$(resolve_project_root "$CWD"); fi
[ -d "${PROJECT_ROOT}/.mega-sdd" ] || exit 0

CFG="${PROJECT_ROOT}/.mega-sdd/config.yaml"

# ─── Per-iteration observability tag (v5.2.7) ────────────────────────────────
# One fresh `mega-sdd-trace:turn` line per user prompt in mega-sdd projects —
# the AI-gateway/Langfuse full-text filter contract. session-start stamps the
# session (`mega-sdd-trace:session`, carried in every request body via history);
# this stamp marks each iteration's LATEST message for gateways that index only
# the newest delta. Opt-out: `trace_tag: false` in .mega-sdd/config.yaml.
if [ ! -f "$CFG" ] || ! grep -qE "^[[:space:]]*trace_tag:[[:space:]]*false" "$CFG" 2>/dev/null; then
  echo "mega-sdd-trace:turn"
fi

if [ -f "$CFG" ]; then
  grep -qE "^[[:space:]]*telemetry:[[:space:]]*false" "$CFG" 2>/dev/null && exit 0
  grep -qE "^[[:space:]]*compaction_notice:[[:space:]]*false" "$CFG" 2>/dev/null && exit 0
fi
[ -n "${TRANSCRIPT:-}" ] && [ -f "$TRANSCRIPT" ] || exit 0

# Sum the latest transcript usage (input + cache_read + cache_creation) = true
# context size. The real window is NOT the [1m] display marker — that alias
# never reaches the transcript's message.model (it records the wire id, e.g.
# claude-opus-4-8 / claude-fable-5), so the old substring test always fell back
# to 200k and over-reported every 1M session ~5x. Resolve it conservatively.
TRANSCRIPT="$TRANSCRIPT" PROOT="$PROJECT_ROOT" python3 <<'PYEOF' 2>/dev/null || true
import glob, json, os

path = os.environ["TRANSCRIPT"]
proot = os.environ["PROOT"]

def usage_ctx(u):
    return (u.get("input_tokens", 0) or 0) + (u.get("cache_read_input_tokens", 0) or 0) + (u.get("cache_creation_input_tokens", 0) or 0)

last_usage, model, peak_ctx = None, "", 0
try:
    with open(path) as f:
        for line in f:
            try:
                rec = json.loads(line)
            except Exception:
                continue
            msg = rec.get("message") if isinstance(rec.get("message"), dict) else None
            if msg and isinstance(msg.get("usage"), dict):
                last_usage = msg["usage"]
                peak_ctx = max(peak_ctx, usage_ctx(last_usage))
                mm = msg.get("model")
                if mm and mm != "<synthetic>":  # synthetic turns carry no real model id
                    model = mm
except Exception:
    raise SystemExit(0)
if not last_usage:
    raise SystemExit(0)

ctx = usage_ctx(last_usage)
if ctx <= 0:
    raise SystemExit(0)

# Resolve the real window from three signals, biased to the LARGER window (a
# false silence is harmless — PreCompact still snapshots; a false /compact nag
# burns the user's real context). 1M when: the [1m] marker is present; OR the
# model is a current 1M-context family; OR the context PHYSICALLY exceeded 200k
# at any point (a true 200k session would have auto-compacted first — proof the
# window is >200k). Else the 200k default.
mlow = model.lower()
is_1m = ("[1m]" in mlow
         or mlow.startswith(("claude-opus-4", "claude-sonnet-4", "claude-fable"))
         or peak_ctx > 200_000)
window = 1_000_000 if is_1m else 200_000
if ctx < int(window * 0.80):
    raise SystemExit(0)
# only when a mega-sdd chain is in flight (a vault with units exists)
if not glob.glob(os.path.join(proot, ".mega-sdd", "vaults", "*", "units", "U-*.md")):
    raise SystemExit(0)

print("mega-sdd: context ~%dk of ~%dk (%d%%) — a phase boundary is the safe place to /compact (pipeline state is snapshotted on compaction). Avoid compacting mid-bolt." % (ctx // 1000, window // 1000, ctx * 100 // window))
PYEOF
exit 0
