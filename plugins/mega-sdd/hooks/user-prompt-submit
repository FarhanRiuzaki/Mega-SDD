#!/usr/bin/env bash
# UserPromptSubmit hook for mega-sdd — GATEWAY CONTRACT ONLY (v7.3.1).
#
# Restored after the v7.3.0 observability removal by owner decision 2026-08-23
# (research/2026-08-23-v7-gate7b-trace-restore.md): the office AI gateway filters
# mega-sdd sessions on the `mega-sdd-trace:*` tag family. Line 1 of this hook's
# output is the gateway tag `mega-sdd-trace:turn` (byte-verbatim, unconditional in
# an adopted SDD project); the OPTIONAL line 2 is the v7.5.0 №G completion-census
# sync OFFER (see the contract note below). Both are pure shell.
#
# Contract (docs/gateway-contract.md):
# - Pure shell, ZERO subprocess spawns (no python, no transcript scan, no advisor —
#   none of the removed observability comes back through this file; the census
#   is a bash regex over the prompt text, 0 forks).
# - Non-SDD cwd → exit silently with no output.
# - stdin is parsed with bash string ops only and NOTHING from it is eval'd or
#   executed — a hostile cwd value can only make the directory probe fail closed.
set -u

# Direct dispatch (v7.5.0 Fase 7 №A): hooks.json runs this body straight — the
# run-hook.sh dispatcher (bash→dirname→uname→bash, 3 extra procs/event) is gone.
# On Windows $0 can arrive with backslash separators (the dispatcher used to
# normalize them); one builtin substitution keeps every $0-derived path sane.
HOOK_SELF="${0//\\//}"

STDIN_JSON=""
IFS= read -r -d '' STDIN_JSON || true
[ -n "$STDIN_JSON" ] || exit 0

# First-match cwd extraction (same fork-free pattern as the other hooks).
CWD_SS=""
case "$STDIN_JSON" in
  *'"cwd"'*)
    _t="${STDIN_JSON#*\"cwd\"}"
    _t="${_t#*\"}"
    CWD_SS="${_t%%\"*}"
    ;;
esac
[ -n "$CWD_SS" ] || exit 0
case "${OSTYPE:-}" in msys*|cygwin*|win32*) CWD_SS="${CWD_SS//\\\\//}"; CWD_SS="${CWD_SS//\\//}" ;; esac
[ -d "$CWD_SS" ] || exit 0

# Walk up to the outermost .mega-sdd/ parent (shared shell resolver; sourced, no fork).
case "$HOOK_SELF" in */*) SC_DIR="${HOOK_SELF%/*}" ;; *) SC_DIR="." ;; esac
RPR="${SC_DIR}/../scripts/_lib/resolve-project-root.sh"
ROOT_SS="$CWD_SS"
if [ -f "$RPR" ]; then
  # shellcheck disable=SC1090
  . "$RPR"
  ROOT_SS=$(resolve_project_root "$CWD_SS")
fi
[ -d "${ROOT_SS}/.mega-sdd" ] || exit 0

# The gateway filter marker — one token, verbatim, unconditional in SDD projects.
# CONTRACT NOTE (docs/gateway-contract.md, amended v7.5.0 №G): the tag stays
# the FIRST line, byte-verbatim — the completion-census offer below appends a
# SECOND line only when it fires; the gateway filter keys on line 1.
echo "mega-sdd-trace:turn"

# ── №G (v7.5.0) census kalimat "selesai" → TAWARAN sync (bukan invoke) ───────
# Pure shell, 0 forks (contract intact). Fires only when BOTH hold:
#  (a) change signal — the dirty journal has rows ([ -s ]);
#  (b) the prompt carries a completion keyword on a word boundary (the census;
#      tuned by tests/hooks/completion-census.test.sh — 'mudah' must NOT hit
#      'udah'). The line instructs the model to OFFER /mega-sdd:sync in one
#      line — never to auto-invoke (the :13(c) lesson stands).
if [ -s "${ROOT_SS}/.mega-sdd/codebase/.dirty-paths.jsonl" ]; then
  UP_PROMPT=""
  case "$STDIN_JSON" in
    *'"prompt"'*)
      _up="${STDIN_JSON#*\"prompt\"}"
      _up="${_up#*\"}"
      UP_PROMPT="${_up%%\"*}"
      ;;
  esac
  if [ -n "$UP_PROMPT" ] \
     && [[ "$UP_PROMPT" =~ (^|[^[:alnum:]])([Uu]dah|[Ss]udah|[Ss]elesai|[Bb]eres|[Kk]elar|[Cc]ommit|[Pp]ush|[Mm]erge[d]?|[Dd]one|PR)([^[:alnum:]]|$) ]]; then
    echo "mega-sdd: user menyiratkan pekerjaan selesai dan ada perubahan kode ter-journal — TAWARKAN /mega-sdd:sync dalam SATU baris (jangan auto-invoke; kalau user menolak, lanjut tanpa mengungkit lagi)."
  fi
fi
exit 0
